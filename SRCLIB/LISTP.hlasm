LISTP    TITLE 'Display RAKF generalized resources'                     00000100
*---------------------------------------------------------------------* 00000200
*                                                                     * 00000300
*        Module:       LISTP                                          * 00000400
*                                                                     * 00000500
*        Author:       Rob Prins                                      * 00000600
*                                                                     * 00000700
*        Attributes:   RENT, REUS, AC=1.                              * 00000800
*                                                                     * 00000900
*        Function:     Obtain the RAKF RCVT, point to the profiles    * 00001000
*                      table and list the specified profile(s)        * 00001100
*                      on the TSO terminal.                           * 00001200
*                      The RAKF profiles table is in fetch protected  * 00001300
*                      storage. So, a MODESET is used.                * 00001400
*                                                                     * 00001500
*        Syntax:       LISTP resource                                 * 00001600
*                      Resource can be a part of the resource.        * 00001700
*                      E.g.: LISTP SYS displays all resources/profiles* 00001800
*                      starting with 'SYS' of all classes.            * 00001900
*                                                                     * 00002000
*        Return codes: 00 - all good.                                 * 00002100
*                      08 - an error occurred, user is notified       * 00002200
*                           with a message                            * 00002300
*                                                                     * 00002400
*---------------------------------------------------------------------* 00002500
LISTP    CSECT                                                          00002600
         SAVE  (14,12),,*                                               00002700
         LR    R12,R15                                                  00002800
         USING LISTP,R12               Base register                    00002900
         LR    R2,R1                   Save parm (CPPL)                 00003000
         GETMAIN RU,LV=WORKL           Obtain savearea + working strg.  00003100
         ST    R1,8(,R13)              Forward pointer                  00003200
         ST    R13,4(,R1)              Backward pointer                 00003300
         LR    R13,R1                  This is our save area            00003400
         USING WORKAREA,R13            Base working storage             00003500
         ST    R2,MYCPPL               Save our CPPL address            00003600
         MVI   SW,0                    Initialize flags                 00003700
         XC    ANSWER,ANSWER           Clear IKJPARS answer             00003800
         XC    PPL#LA,PPL#LA           Clear pointer to PPL             00003900
         MVC   MSG4,MSG4X              Move message to working storage  00004000
         USING PSA,R0                  Point to CVT                     00004100
         L     R2,PSAANEW              Load ASCB                        00004200
         L     R2,ASCBASXB-ASCB(R2)    Load ASXB                        00004300
         ICM   R2,15,ASXBSENV-ASXB(R2) Point to ACEE                    00004400
         BNZ   CONT1                   Yes: found                       00004500
         LA    R1,MSGY                 Msg: 'No ACEE found'             00004600
         LA    R0,L'MSGY               Length                           00004700
         BAL   R14,TPUT                Write the message on screen      00004800
         B     RC08                    End with RC=-08                  00004900
CONT1    TM    ACEEFLG1-ACEE(R2),ACEESPEC Do we have the SPECIAL attr   00005000
         BO    CONT2                                                    00005100
         LA    R1,MSGZ                 Msg: 'No SPECIAL attribute'      00005200
         LA    R0,L'MSGZ               Length                           00005300
         BAL   R14,TPUT                Write the message on screen      00005400
         B     RC08                    End with RC=-08                  00005500
CONT2    DS    0H                                                       00005600
*---------------------------------------------------------------------* 00005700
*        Parse parameters                                             * 00005800
*---------------------------------------------------------------------* 00005900
         GETMAIN RU,LV=PPL#L           Obtain a dynamic PPL workarea    00006000
         STM   R0,R1,PPL#LA            Save length and address of PPL   00006100
         L     R2,PPL#PTR              Get the address of the PPL       00006200
         USING PPL,R2                  Adress it                        00006300
         L     R1,MYCPPL               Get address of CPPL              00006400
         USING CPPL,R1                 Address it                       00006500
*---------------------------------------------------------------------* 00006600
*                                                                       00006700
*        Populate the Parse Parameter List (PPL) from the CPPL,         00006800
*        add the IKJPARMD list in the PPL and invoke IKJPARS            00006900
*                                                                       00007000
*---------------------------------------------------------------------* 00007100
*                                                                       00007200
         MVC   PPLUPT,CPPLUPT          Put in the UPT address from CPPL 00007300
         MVC   PPLECT,CPPLECT          Put in the ECT address from CPPL 00007400
         MVC   PPLCBUF,CPPLCBUF        Put in the command buffer addr.  00007500
*                                      From the CPPL                    00007600
         XC    ECB,ECB                 Clear Event control block        00007700
         L     R1,=A(ADDPCL)           Address of PCL                   00007800
         ST    R1,PPLPCL               Set in PPL                       00007900
         LA    R1,ANSWER               Answer area                      00008000
         ST    R1,PPLANS               Pointer into PPL                 00008100
         LA    R1,ECB                  Event control block              00008200
         ST    R1,PPLECB               Pointer into PPL                 00008300
         ST    R13,PPLUWA              User provide workarea            00008400
         CALLTSSR EP=IKJPARS,MF=(E,PPL)   Invoke parse                  00008500
         DROP  R1,R2                   CPPL and PPL                     00008600
         LTR   R15,R15                 Parse successfully processed?    00008700
         BZ    PARSEOK                 Yes: carry                       00008800
         LA    R0,L'MSG5               Length                           00008900
         LA    R1,MSG5                 Message                          00009000
         BAL   R14,TPUT                                                 00009100
         XC    ANSWER,ANSWER           Avoid IKJRLSA                    00009200
         B     RC08                    Return to TMP                    00009300
PARSEOK  DS    0H                                                       00009400
         L     R8,ANSWER               Pointer to PDL                   00009500
         USING ADDPRS,R8               mapped with IKJPARM              00009600
         MVI   PROFILE,C' '                                             00009700
         MVC   PROFILE+1(L'PROFILE-1),PROFILE initialize profile        00009800
         LA    R3,PROFPDE              Profile PDE                      00009900
         USING PROFRET,R3              Base this PDE                    00010000
         L     R1,PROFPTR              Pointer to Profile name          00010100
         LH    R2,PROFL                Length                           00010200
         LTR   R2,R2                   0?                               00010300
         BNZ   *+8                     No: good                         00010400
         LA    R2,1                    Set to 1.                        00010500
         STH   R2,PROFILEL             Save for later use               00010600
         BCTR  R2,0                    -1 for EX                        00010700
         EX    R2,MVEPROF              Move Profile                     00010800
         B     ENDPARS                 Branch over EX                   00010900
MVEPROF  MVC   PROFILE(0),0(R1)        << Executed >>                   00011000
ENDPARS  DS    0H                                                       00011100
         DROP  R3,R8                   Unbase UIDRET, ADDPRS            00011200
         L     R4,CVTPTR               Load CVT                         00011300
         ICM   R4,B'1111',CVTRAC-CVTMAP(R4) Check RCVT                  00011400
         BNZ   LISTP001                Yes: RAKF is active              00011500
         LA    R1,MSG1                 No: RAKF is not active           00011600
         LA    R0,L'MSG1               Length                           00011700
         BAL   R14,TPUT                Inform user                      00011800
         B     RC08                    Return to TMP                    00011900
LISTP001 DS    0H                                                       00012000
*---------------------------------------------------------------------* 00012100
*        CJYRCVT contains 2 pointers. 1 = address of users table      * 00012200
*                                     2 = address of profiles table   * 00012300
*---------------------------------------------------------------------* 00012400
         ICM   R4,B'1111',RCVTISTL-RCVT(R4) CJYRCVTD present?           00012500
         BZ    LISTP003                No: error                        00012600
         ICM   R4,B'1111',CJYPROFS-CJYRCVTD(R4) Point to profile table  00012700
         BNZ   LISTP005                Yes: found                       00012800
LISTP003 DS    0H                                                       00012900
         LA    R1,MSG2                 Msg: Profiles table not present  00013000
         LA    R0,L'MSG2               Length                           00013100
         BAL   R14,TPUT                Inform user                      00013200
         B     RC08                    Return to TMP                    00013300
LISTP005 DS    0H                                                       00013400
         USING RPECBLK,R4              Base CJYPCBLK                    00013500
         MODESET KEY=ZERO,MODE=SUP  Profiles table is in protected core 00013600
LISTP007 DS    0H                                                       00013700
         MVI   MSG3,C' '               Blank message                    00013800
         MVC   MSG3+1(L'MSG3-1),MSG3                                    00013900
         MVC   MSG3(07),=C'LISTP: '                                     00014000
         MVC   MSG3+07(6),=C'Class='                                    00014100
         MVC   MSG3+22(8),=C'Profile='                                  00014200
         LH    R2,PROFILEL             Length                           00014300
         BCTR  R2,0                    Minus 1                          00014400
         EX    R2,CMPPRF               Compare given profile            00014500
         BE    LISTP009                Yes: display                     00014600
         ICM   R4,B'1111',RPENEXT      Next entry                       00014700
         BNZ   LISTP007                Test again                       00014800
         TM    SW,$LISTED              Already an entry listed?         00014900
         BO    READY                   Do not issue MSG4                00015000
         MVC   MSG4+28(44),PROFILE     Resource/Profile in message      00015100
         LA    R1,MSG4                 Msg: Profile xxxxx not defined   00015200
         LA    R0,L'MSG4               Length                           00015300
         BAL   R14,TPUT                Inform user                      00015400
         BAL   R14,PROB                Back to problem state            00015500
         B     RC08                    Return                           00015600
LISTP009 DS    0H                                                       00015700
         MVC   MSG3+13(8),RPECLASN     Move class name                  00015800
         XR    R2,R2                   Clear register                   00015900
         IC    R2,RPEENTYL             Length of entity/profile         00016000
         LTR   R2,R2                   0?                               00016100
         BNZ   *+8                     No: good                         00016200
         LA    R2,1                    Default 1                        00016300
         BCTR  R2,0                    Minus 1 for EX                   00016400
         EX    R2,MVEENT               Move profile in message          00016500
         LA    R1,MSG3+30              Point to profile placeholder     00016600
         LA    R1,2(R1,R2)             Point after profile              00016700
         MVC   0(5,R1),=C'UACC='                                        00016800
         LA    R2,5(,R1)               Point after UACC=                00016900
         LA    R1,RPEUACC              UACC value                       00017000
         BAL   R14,ACCESS              Translate into readable form     00017100
         LA    R1,MSG3                 For TPUT                         00017200
         LA    R0,L'MSG3               Length                           00017300
         BAL   R14,TPUT                Inform user                      00017400
         OI    SW,$LISTED              Entry is listed                  00017500
         MVI   MSG3,C' '               Blank message                    00017600
         MVC   MSG3+1(L'MSG3-1),MSG3                                    00017700
         MVC   MSG3+07(12),=C'Access list:' 2nd line                    00017800
         LA    R1,MSG3                                                  00017900
         LA    R0,L'MSG3               Length                           00018000
         BAL   R14,TPUT                Inform user                      00018100
         USING RPEACCLE,R5             Access list                      00018200
LISTP011 ICM   R5,15,RPEACCPT          Point to access list             00018300
         BZ    LISTP017                No access list                   00018400
LISTP013 MVI   MSG3,C' '               Blank message                    00018500
         MVC   MSG3+1(L'MSG3-1),MSG3                                    00018600
         MVC   MSG3+7(8),RPEAUSR       Id                               00018700
         LA    R1,RPEACS               Access byte                      00018800
         LA    R2,MSG3+16              Place to receive access word     00018900
         BAL   R14,ACCESS              Xlate ACCESS byte to word        00019000
         LA    R1,MSG3                                                  00019100
         LA    R0,L'MSG3               Length                           00019200
         BAL   R14,TPUT                Inform user                      00019300
         B     LISTP015                Next entry in access list        00019400
MVEENT   MVC   MSG3+30(0),RPEENTYN     Move the profile  << executed >> 00019500
CMPPRF   CLC   RPEENTYN(0),PROFILE     Does profile match<< executed >> 00019600
LISTP015 ICM   R5,15,RPEANEXT          Next access entry                00019700
         BNZ   LISTP013                If there, display                00019800
LISTP017 ICM   R4,B'1111',RPENEXT      Next entry                       00019900
         BNZ   LISTP007                Test again                       00020000
READY    BAL   R14,PROB                Back to problem state            00020100
         XR    R15,R15                 Return code 0                    00020200
         B     RETURN                  Return                           00020300
*---------------------------------------------------------------------* 00020400
*        Return to TSO TMP.                                           * 00020500
*---------------------------------------------------------------------* 00020600
RC08     DS    0H                                                       00020700
         LA    R15,8                   RC = 8                           00020800
RETURN   DS    0H                                                       00020900
         LR    R4,R15                  Save return code                 00021000
         ICM   R2,15,PPL#LA            Filled in?                       00021100
         BZ    RETURN1                 No: do not free                  00021200
         LM    R2,R3,PPL#LA            Load length and address of PPL   00021300
         FREEMAIN RU,LV=(2),A=(3)      Free the PPL                     00021400
RETURN1  ICM   R8,15,ANSWER            Pointer to PDE's (the PDL)       00021500
         BZ    RETURN2                 No: skip                         00021600
         IKJRLSA (R8)                  Release PARSE storage            00021700
RETURN2  LR    R3,R13                  Load working storage to free     00021800
         L     R13,4(,R13)             Load caller's save area          00021900
         FREEMAIN RU,LV=WORKL,A=(3)    Release working storage          00022000
         LR    R15,R4                  Restore return code              00022100
         RETURN (14,12),RC=(15)        Return                           00022200
*                                                                       00022300
         TITLE 'Back to problem state'                                  00022400
PROB     ST    R14,R14PROB             Save register 14                 00022500
         MODESET KEY=NZERO,MODE=PROB   Back to problem state            00022600
         L     R14,R14PROB             Restore register 14              00022700
         BR    R14                     Return                           00022800
         TITLE 'Parse ACCESS'                                           00022900
ACCESS   DS    0H                                                       00023000
*---------------------------------------------------------------------* 00023100
*        Translate the ACCESS byte into a readable word.              * 00023200
*        R1 points to the access byte, R2 points to the output word   * 00023300
*---------------------------------------------------------------------* 00023400
         TM    0(R1),RACFALTR          Do we have ALTER access?         00023500
         BNO   ACC01                   No: test other values            00023600
         MVC   0(8,R2),=CL8'ALTER'                                      00023700
         B     ACC99                   Ready                            00023800
ACC01    TM    0(R1),RACFCNTL          Do we have CONTROL access?       00023900
         BNO   ACC02                   No: test other values            00024000
         MVC   0(8,R2),=CL8'CONTROL'                                    00024100
         B     ACC99                   Ready                            00024200
ACC02    TM    0(R1),RACFUPDT          Do we have UPDATE access?        00024300
         BNO   ACC03                   No: test other values            00024400
         MVC   0(8,R2),=CL8'UPDATE'                                     00024500
         B     ACC99                   Ready                            00024600
ACC03    TM    0(R1),RACFREAD          Do we have READ access?          00024700
         BNO   ACC04                   No: test other values            00024800
         MVC   0(8,R2),=CL8'READ'                                       00024900
         B     ACC99                   Ready                            00025000
ACC04    TM    0(R1),RACFEXEC          Do we have EXEC access?          00025100
         BNO   ACC05                   No: test other values            00025200
         MVC   0(8,R2),=CL8'EXEC'                                       00025300
         B     ACC99                   Ready                            00025400
ACC05    MVC   0(8,R2),=CL8'NONE'      No access                        00025500
ACC99    BR    R14                     Return                           00025600
         TITLE 'Write message on screen'                                00025700
*---------------------------------------------------------------------* 00025800
*        Write the message on the terminal with a PUTLINE.            * 00025900
*        Register 0 = the length of the message.                      * 00026000
*        Register 1 = adress of the message.                          * 00026100
*---------------------------------------------------------------------* 00026200
TPUT     DS    0H                                                       00026300
         ST    R14,R14TPUT             Save register 14                 00026400
         L     R3,MYCPPL               Pickup CPPL of this command      00026500
         USING CPPL,R3                 Base IKJCPPL                     00026600
         MVI   PUTLINE+4,C' '          Clear output line                00026700
         MVC   PUTLINE+5(95),PUTLINE+4         ,,                       00026800
         LR    R2,R0                   Length of message                00026900
         BCTR  R2,0                    Minus 1 for EX                   00027000
         EX    R2,MVEMSG               Move the message                 00027100
         LA    R2,5(,R2)               Length in including length field 00027200
         XC    PUTLINE+2(2),PUTLINE+2  Byte 2 and 3, reserved           00027300
         STCM  R2,B'0011',PUTLINE      Save length in byte 0 and 1      00027400
         L     R2,CPPLUPT              User Profile Table               00027500
         L     R3,CPPLECT              Environment Control Table        00027600
         XC    ECB,ECB                 Force PUTLINE to wait            00027700
         LA    R0,PUTLINE              Data line address                00027800
         PUTLINE PARM=PUTBLOK,,MF=(E,PUTIOPL),                         *00027900
               OUTPUT=((0),TERM,SINGLE,DATA),ECB=ECB,UPT=(2),ECT=(3),  *00028000
               TERMPUT=(EDIT,WAIT,NOHOLD,NOBREAK)                       00028100
         L     R14,R14TPUT             Restore register 14              00028200
         BR    R14                                                      00028300
MVEMSG   MVC   PUTLINE+4(0),0(R1)      << executed >>                   00028400
         DROP  R3                      Unbase CPPL                      00028500
PCLSTART DS    0H                                                       00028600
ADDPCL   IKJPARM DSECT=ADDPRS          PDE's                            00028700
PROFPDE  IKJPOSIT DSTHING,PROMPT='RAKF Profile name',                  *00028800
               HELP=('a valid (part) of a profile e.g. SYS1.*')         00028900
         IKJENDP                                                        00029000
PCL#L    EQU   *-PCLSTART                                               00029100
         TITLE 'CONSTANTS'                                              00029200
*                                                                       00029300
MSG1     DC    C'LISTP: RAKF is not active'                             00029400
MSG2     DC    C'LISTP: No profile table present'                       00029500
MSG4X    DC    C'LISTP: Not defined in RAKF: 12345123451234512345123451*00029600
               234512345123451234'     +28                              00029700
MSG5     DC    C'LISTP: Parse error'                                    00029800
MSGY     DC    C'LISTP: No ACEE found'                                  00029900
MSGZ     DC    C'LISTP: Not authorized, no SPECIAL attribute'           00030000
         LTORG ,                                                        00030100
         DROP                                                           00030200
*                                                                       00030300
PROFRET  DSECT                         PDE of Profile name              00030400
PROFPTR  DS    F                       Pointer to Profile               00030500
PROFL    DS    H                       Length of Profile                00030600
PROFFLG  DS    C                                                        00030700
$PPRES   EQU   128                     Profile is present               00030800
         DS    C                       Reserved                         00030900
*                                                                       00031000
WORKAREA DSECT                         Working storage                  00031100
         DS    18F                     Our save area                    00031200
MYCPPL   DS    F                                                        00031300
ECB      DS    F                       For IKJDAIR                      00031400
R14TPUT  DS    F                       Register 14 TPUT                 00031500
R14PROB  DS    F                       Register 14 PROB                 00031600
R14ACC   DS    F                       Register 14 ACCESS               00031700
ANSWER   DS    F                       Parse answer area                00031800
PUTIOPL  DS    4F                      IKJIOPL                          00031900
PUTBLOK  PUTLINE MF=L                  PUTLINE PTPB                     00032000
PUTLINE  DS    CL100                   Output of PUTLINE                00032100
PROFILEL DS    H                       Length of profile                00032200
PROFILE  DS    CL44                    To receive Profile               00032300
*                                                                       00032400
PPL#LA   DS    F                       \___ Length + address PPL ____/  00032500
PPL#PTR  DS    F                       /                             \  00032600
*                                                                       00032700
MSG3     DS    CL96                                                     00032800
MSG4     DS    CL(L'MSG4X)                                              00032900
SW       DS    X                                                        00033000
$LISTED  EQU   128                     Already an entry listed          00033100
WORKL    EQU   *-WORKAREA              Length of working storage        00033200
*                                                                       00033300
         COPY  CJYPCBLK                Profiles table entry             00033400
         COPY  CJYRCVTD                RCVT CBLK                        00033500
         ICHPRCVT                      RACF CVT                         00033600
         CVT   DSECT=YES,LIST=NO                                        00033700
         IKJCPPL                                                        00033800
         IKJUPT                                                         00033900
         IKJPPL                        Parse parameter list             00034000
PPL#L    EQU   *-PPL                                                    00034100
         IHAPSA                                                         00034200
         IHAASCB                                                        00034300
         IHAASXB                                                        00034400
         IHAACEE                                                        00034500
*                                                                       00034600
R0       EQU   0                                                        00034700
R1       EQU   1                                                        00034800
R2       EQU   2                                                        00034900
R3       EQU   3                                                        00035000
R4       EQU   4                       Base register CBLK               00035100
R5       EQU   5                       Base register CONNGRUP           00035200
R6       EQU   6                                                        00035300
R7       EQU   7                                                        00035400
R8       EQU   8                       Address of IKJPARS PDL           00035500
R9       EQU   9                                                        00035600
R10      EQU   10                                                       00035700
R11      EQU   11                                                       00035800
R12      EQU   12                      Base register                    00035900
R13      EQU   13                      Address of working storage       00036000
R14      EQU   14                                                       00036100
R15      EQU   15                                                       00036200
         END                                                            00036300
