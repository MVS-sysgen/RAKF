ADDSD    TITLE 'Add RAKF profile records'                               00000100
*---------------------------------------------------------------------* 00000200
*                                                                     * 00000300
*        Module:       ADDSD                                          * 00000400
*        Alias:        AD                                             * 00000500
*                      RDEFINE                                        * 00000600
*                                                                     * 00000700
*        Author:       Rob Prins                                      * 00000800
*                                                                     * 00000900
*        Attributes:   RENT, REUS.                                    * 00001000
*                                                                     * 00001100
*        Function:     Parse the syntax of the ADDSD   command.       * 00001200
*                      Allocate SYS1.SECURE.CNTL(PROFILES)            * 00001300
*                      dynamically with IKJDAIR.                      * 00001400
*                      GETMAIN room for 1500 profiles.                * 00001500
*                      Read the PROFILES member into the table and    * 00001600
*                      skip the comments records.                     * 00001700
*                      Add new RAKF profiles in the PROFILES table.   * 00001800
*                      Sort the table alpabetically.                  * 00001900
*                                                                     * 00002000
*                      Write the PROFILES table back.                 * 00002100
*                      Free the SYS1.SECURE.CNTL data set.            * 00002200
*                                                                     * 00002300
*        Syntax:       ADDSD  profile UACC(NONE/READ/UPDATE/CONTROL   * 00002400
*                             ALTER)                                  * 00002500
*                                   -- OR --                          * 00002600
*                      RDEFINE profile UACC(NONE/READ/UPDATE/CONTROL  * 00002700
*                              ALTER) CLASS(class)                    * 00002800
*                                                                     * 00002900
*                      Required: profile                              * 00003000
*                                CLASS if command name = RDEFINE.     * 00003100
*                                                                     * 00003200
*                      Default: UACC(NONE)                            * 00003300
*                                                                     * 00003400
*        Return codes: 00 - all good.                                 * 00003500
*                      08 - an error occurred, user is notified       * 00003600
*                           with a message                            * 00003700
*                                                                     * 00003800
*---------------------------------------------------------------------* 00003900
ADDSD    CSECT                                                          00004000
         SAVE  (14,12),,*                                               00004100
         LR    R12,R15                                                  00004200
         USING ADDSD,R12               Base register                    00004300
         LR    R2,R1                   Save parm (CPPL)                 00004400
         GETMAIN RU,LV=WORKL           Obtain savearea + working strg.  00004500
         ST    R1,8(,R13)              Forward pointer                  00004600
         ST    R13,4(,R1)              Backward pointer                 00004700
         LR    R13,R1                  This is our save area            00004800
         USING WORKAREA,R13            Base working storage             00004900
         ST    R2,MYCPPL               Save our CPPL address            00005000
         L     R1,0(R2)                Point to CBUF in CPPL            00005100
         MVC   CMDNAME,4(R1)           Our program name (TSO command)   00005200
         MVC   RAKFPROF,MDLPROF        Move model DCB to working strg   00005300
         XC    DAIR08,DAIR08           Clear IKJDAIR                    00005400
         XC    DAIR18,DAIR18                        ... blocks          00005500
         XC    ANSWER,ANSWER           Clear IKJPARS answer             00005600
         XC    PPL#LA,PPL#LA           Clear PPL pointers               00005700
         MVC   MSG3,MSG3X              Move message to working storage  00005800
         MVC   MSG4,MSG4X              Move message to working storage  00005900
         MVC   MSG5,MSG5X              Move message to working storage  00006000
         MVC   MSG7,MSG7X              Move message to working storage  00006100
         MVC   MSG9,MSG9X              Move message to working storage  00006200
         MVC   MSGA,MSGAX              Move message to working storage  00006300
         MVC   MSGY,MSGYX              Move message to working storage  00006400
         MVC   MSGZ,MSGZX              Move message to working storage  00006500
         CLC   =C'RDEFINE',CMDNAME     Are we using alias RDEFINE?      00006600
         BNE   START1                  No: do not change messages       00006700
         MVC   MSG3(7),CMDNAME         Move command name in message     00006800
         MVC   MSG4(7),CMDNAME         Move command name in message     00006900
         MVC   MSG5(7),CMDNAME         Move command name in message     00007000
         MVC   MSG7(7),CMDNAME         Move command name in message     00007100
         MVC   MSG9(7),CMDNAME         Move command name in message     00007200
         MVC   MSGA(7),CMDNAME         Move command name in message     00007300
         MVC   MSGY(7),CMDNAME         Move command name in message     00007400
         MVC   MSGZ(7),CMDNAME         Move command name in message     00007500
START1   MVI   PROFREC-1,C' '          To blank Profile record          00007600
         MVC   CLASS,=CL8'DATASET'     Default resource class           00007700
         MVI   SW,0                    Clear flags                      00007800
         LA    R0,DCBABEND             DCB abend exit                   00007900
         ST    R0,EXLST                Save JFCB in exit list           00008000
         MVI   EXLST,X'91'             DCB abend exit is last entry     00008100
         LA    R0,EXLST                Exit list (DCB abend exit)       00008200
         STCM  R0,B'0111',RAKFPROF+DCBEXLSA-IHADCB                      00008300
         GETMAIN RU,LV=120000      GETMAIN room for 1500 profiles       00008400
         ST    R1,ADRPROF              Save its address                 00008500
         USING PSA,R0                  Point to CVT                     00008600
         L     R2,PSAANEW              Load ASCB                        00008700
         L     R2,ASCBASXB-ASCB(R2)    Load ASXB                        00008800
         ICM   R2,15,ASXBSENV-ASXB(R2) Point to ACEE                    00008900
         BNZ   CONT1                   Yes: found                       00009000
         LA    R1,MSGY                 Msg: 'No ACEE found'             00009100
         LA    R0,L'MSGY               Length                           00009200
         BAL   R14,TPUT                Write the message on screen      00009300
         B     RC08                    End with RC=-08                  00009400
CONT1    TM    ACEEFLG1-ACEE(R2),ACEESPEC Do we have the SPECIAL attr   00009500
         BO    CONT2                                                    00009600
         LA    R1,MSGZ                 Msg: 'No SPECIAL attribute'      00009700
         LA    R0,L'MSGZ               Length                           00009800
         BAL   R14,TPUT                Write the message on screen      00009900
         B     RC08                    End with RC=-08                  00010000
CONT2    DS    0H                                                       00010100
*---------------------------------------------------------------------* 00010200
*        Parse parameters                                             * 00010300
*---------------------------------------------------------------------* 00010400
         GETMAIN RU,LV=PPL#L           Obtain a dynamic PPL workarea    00010500
         STM   R0,R1,PPL#LA            Save length and address of PPL   00010600
         L     R2,PPL#PTR              Get the address of the PPL       00010700
         USING PPL,R2                  Adress it                        00010800
         L     R1,MYCPPL               Get address of CPPL              00010900
         USING CPPL,R1                 Address it                       00011000
*---------------------------------------------------------------------* 00011100
*                                                                       00011200
*        Populate the Parse Parameter List (PPL) from the CPPL,         00011300
*        add the IKJPARMD list in the PPL and invoke IKJPARS            00011400
*                                                                       00011500
*---------------------------------------------------------------------* 00011600
*                                                                       00011700
         MVC   PPLUPT,CPPLUPT          Put in the UPT address from CPPL 00011800
         MVC   PPLECT,CPPLECT          Put in the ECT address from CPPL 00011900
         MVC   PPLCBUF,CPPLCBUF        Put in the command buffer addr.  00012000
*                                      From the CPPL                    00012100
         XC    ECB,ECB                 Clear Event control block        00012200
         L     R1,=A(ADDPCL)           Address of PCL                   00012300
         ST    R1,PPLPCL               Set in PPL                       00012400
         LA    R1,ANSWER               Answer area                      00012500
         ST    R1,PPLANS               Pointer into PPL                 00012600
         LA    R1,ECB                  Event control block              00012700
         ST    R1,PPLECB               Pointer into PPL                 00012800
         ST    R13,PPLUWA              User provide workarea            00012900
         CALLTSSR EP=IKJPARS,MF=(E,PPL)   Invoke parse                  00013000
         DROP  R1,R2                   CPPL and PPL                     00013100
         LTR   R15,R15                 Parse successfully processed?    00013200
         BZ    PARSEOK                 Yes: carry                       00013300
         LA    R0,L'MSG5               Length                           00013400
         LA    R1,MSG5                 Message                          00013500
         BAL   R14,TPUT                                                 00013600
         XC    ANSWER,ANSWER           Avoid IKJRLSA                    00013700
         B     RC08                    Return to TMP                    00013800
PARSEOK  DS    0H                                                       00013900
         L     R8,ANSWER               Pointer to PDL                   00014000
         USING ADDPRS,R8               mapped with IKJPARM              00014100
         MVI   PROFILE,C' '                                             00014200
         MVC   PROFILE+1(L'PROFILE-1),PROFILE initialize profile        00014300
         LA    R3,PROFPDE              Profile PDE                      00014400
         USING PROFRET,R3              Base this PDE                    00014500
         L     R1,PROFPTR              Pointer to Profile name          00014600
         LH    R2,PROFL                Length                           00014700
         BCTR  R2,0                    -1 for EX                        00014800
         EX    R2,MVEPROF              Move Profile                     00014900
         B     ENDPROF                 Branch over EX                   00015000
MVEPROF  MVC   PROFILE(0),0(R1)        << Executed >>                   00015100
ENDPROF  DS    0H                                                       00015200
         DROP  R3                      Unbase PROFRET                   00015300
         LA    R3,CLASSPDE             Point to resource class PDE      00015400
         USING CLASRET,R3              Base this PDE                    00015500
         CLC   =C'RDEFINE',CMDNAME     TSO command RDEFINE?             00015600
         BNE   ENDCLAS                 No: then class is DATASET        00015700
         TM    CLASFLG,$CPRES          Is CLASS present?                00015800
         BNZ   CLAS001                 Yes: good                        00015900
         LA    R1,MSG6                 Msg: 'CLASS is required'         00016000
         LA    R0,L'MSG6               Length                           00016100
         BAL   R14,TPUT                Write message                    00016200
         B     RC08                    End with RC = 8                  00016300
CLAS001  DS    0H                                                       00016400
         MVC   CLASS,=CL8' '           Blank CLASS name                 00016500
         LH    R2,CLASL                Length of Class name             00016600
         L     R1,CLASPTR              Class name                       00016700
         BCTR  R2,0                    Minus 1 for EX                   00016800
         EX    R2,MVECLAS              Move Class name                  00016900
         B     ENDCLAS                 Branch over EX                   00017000
MVECLAS  MVC   CLASS(0),0(R1)          << Executed >>                   00017100
ENDCLAS  DS    0H                                                       00017200
         DROP  R3                      Unbase CLASRET                   00017300
ENDPARS  DS    0H                                                       00017400
*---------------------------------------------------------------------* 00017500
*        Allocate SYS1.SECURE.CNTL(PROFILES)                          * 00017600
*---------------------------------------------------------------------* 00017700
         LA    R3,DAIR08               Allocation request block         00017800
         USING DAPB08,R3               Base DAPB08                      00017900
         MVI   DA08CD+1,X'08'          Entry code 08 (allocation)       00018000
         MVC   DA08DDN,=CL8'RAKFPROF'  DDNAME to allocate               00018100
         MVC   DA08PDSN,=A(PROFDSNL)   Temporary data set name          00018200
         MVI   DA08DSP1,DA08OLD        DISP=OLD                         00018300
         MVC   DA08MNM,=CL8'PROFILES'  Fixed member name                00018400
         MVI   DA08UNIT,C' '           Clear unit name                  00018500
         MVC   DA08UNIT+1(L'DA08UNIT-1),DA08UNIT                        00018600
         MVI   DA08SER,C' '            Clear volume serial              00018700
         MVC   DA08SER+1(L'DA08SER-1),DA08UNIT                          00018800
         LR    R1,R3                   Parameter CALLTS                 00018900
         BAL   R14,CALLTS              IKJDAIR routine                  00019000
         LTR   R15,R15                 Allocation OK?                   00019100
         BZ    ADDP001                 Yes: carry on                    00019200
         LA    R1,MSG1                 Msg: 'allocation error PROF'     00019300
         LA    R0,L'MSG1               Length                           00019400
         BAL   R14,TPUT                Write the message on screen      00019500
         B     RC08                    Return code 8                    00019600
ADDP001  DS    0H                                                       00019700
*---------------------------------------------------------------------* 00019800
*        Open SYS1.SECURE.CNTL(PROFILES) with DDNAME RAKPROF          * 00019900
*---------------------------------------------------------------------* 00020000
         MVI   OPEND,X'80'             First and only DCB               00020100
         OPEN  RAKFPROF,MF=(E,OPEND)                                    00020200
         TM    SW,$913                 Access denied?                   00020300
         BNO   ADDP005                 No: assumed, that open is succes 00020400
         MVC   MSG3+9(8),=CL8'RAKFPROF'  DD-name                        00020500
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00020600
         LA    R0,L'MSG3               Length                           00020700
         BAL   R14,TPUT                Write the message on screen      00020800
         BAL   R14,FREE                Free the data sets               00020900
         B     RC08                    Return code 8                    00021000
ADDP005  DS    0H                                                       00021100
*---------------------------------------------------------------------* 00021200
*        Read the PROFILES records and check if the profile is        * 00021300
*        already added.                                               * 00021400
*        And populate the table with Profile records.                 * 00021500
*---------------------------------------------------------------------* 00021600
         XR    R5,R5                   Clear record counter             00021700
         L     R6,ADRPROF              Start of Profile table           00021800
READPROF DS    0H                                                       00021900
         GET   RAKFPROF,PROFREC        Read a record                    00022000
         CLI   PROFREC,C'*'            Comment record?                  00022100
         BE    READPROF                Yes: skip                        00022200
         LA    R5,1(,R5)               Count record                     00022300
         C     R5,=F'1495'             Already 1495 records in table?   00022400
         BL    ADDP010                 No: room enough                  00022500
         LA    R1,MSG7                 Msg: 'table full'                00022600
         LA    R0,L'MSG7               Length                           00022700
         BAL   R14,TPUT                Write the message on screen      00022800
         BAL   R14,CLOSE               Close RAKFPROF                   00022900
         BAL   R14,FREE                Free the data sets               00023000
         B     RC08                    Return code 8                    00023100
ADDP010  CLC   PROFPRF,PROFILE         Match found of Profile?          00023200
         BNE   ADDP011                 No: good                         00023300
         LA    R1,MSG4                 Msg: 'PROFILE already defined'   00023400
         LA    R0,L'MSG4               Length                           00023500
         BAL   R14,TPUT                Write the message on screen      00023600
         BAL   R14,CLOSE               Close the data sets              00023700
         BAL   R14,FREE                Free the data sets               00023800
         B     RC08                    Return code 8                    00023900
ADDP011  DS    0H                                                       00024000
         MVC   0(80,R6),PROFREC        Record into table                00024100
         LA    R6,80(,R6)              Next entry in table              00024200
         B     READPROF                Read next record                 00024300
PROFEOF  DS    0H                      EOF RACFPROF                     00024400
*                                                                       00024500
*---------------------------------------------------------------------* 00024600
*        Sort the Profile table alphabetically and                    * 00024700
*        write the Profile records in the Profile table.              * 00024800
*---------------------------------------------------------------------* 00024900
         MVC   PROFREC,PROFREC-1       Clear profile record             00025000
         MVC   PROFCLS,CLASS           Class name                       00025100
         MVC   PROFPRF,PROFILE         Move profile                     00025200
         LH    R1,UACC                 UACC PDL                         00025300
         MH    R1,=H'10'               Times 10 (MVC + B)               00025400
         B     *+4(R1)                 Branchlist                       00025500
         MVC   PROFACC,=CL8'NONE'      Default (0)                      00025600
         B     UACEND                                                   00025700
         MVC   PROFACC,=CL8'NONE'      (1)                              00025800
         B     UACEND                                                   00025900
         MVC   PROFACC,=CL8'READ'      (2)                              00026000
         B     UACEND                                                   00026100
         MVC   PROFACC,=CL8'UPDATE'    (3)                              00026200
         B     UACEND                                                   00026300
         MVC   PROFACC,=CL8'CONTROL'   (4)                              00026400
         B     UACEND                                                   00026500
         MVC   PROFACC,=CL8'ALTER'     (5)                              00026600
UACEND   MVC   0(80,R6),PROFREC        Move record in table             00026700
         LA    R5,1(,R5)               Count record                     00026800
         MVI   CLOSED,X'80'            First and only DCB               00026900
         CLOSE RAKFPROF,MF=(E,CLOSED)                                   00027000
SORT     STM   R4,R8,SAVESORT                                           00027100
         LR    R7,R5                   Copy record counter              00027200
         L     R2,ADRPROF              Point to first record            00027300
         CH    R7,=H'2'                Less than 2 records?             00027400
         BL    ENDSORT                 Do not sort                      00027500
         BCTR  R7,0                    Minus 1                          00027600
         MH    R7,=H'80'               ** Record length                 00027700
         LA    R7,0(R2,R7)             Point to last record             00027800
*                                                                       00027900
SORT01   DS    0H                      Start sort                       00028000
         ST    R7,SWAPLAST             Last record swapped              00028100
         L     R4,ADRPROF              Point to first record            00028200
         LR    R5,R4                   Next                             00028300
         LA    R5,80(,R4)                   Record                      00028400
SORT03   DS    0H                                                       00028500
         CL    R4,SWAPLAST             Last record reached?             00028600
         BNL   SORT07                  Yes: loop complete               00028700
         CLC   0(72,R4),0(R5)          Compare (skip sequence numbers)  00028800
         BNH   SORT05                  High: swap these records         00028900
         XC    0(80,R4),0(R5)          Swap                             00029000
         XC    0(80,R5),0(R4)              the                          00029100
         XC    0(80,R4),0(R5)                   records                 00029200
         LR    R7,R4                   Last record swapped in R7        00029300
SORT05   DS    0H                      Load next entry                  00029400
         LA    R4,80(,R4)              Next recodd                      00029500
         LA    R5,80(,R5)              Next record                      00029600
         B     SORT03                  Compare next record              00029700
SORT07   DS    0H                      All records done                 00029800
         CL    R7,SWAPLAST             Are these swaps executed?        00029900
         BL    SORT01                  No: sort them again              00030000
*                                      Else end of sort                 00030100
ENDSORT  LM    R4,R8,SAVESORT          Restore registers                00030200
         MVI   OPEND,X'80'             First and only DCB               00030300
         OPEN  (RAKFPROF,(OUTPUT)),MF=(E,OPEND)                         00030400
         TM    SW,$913                 Access denied?                   00030500
         BNO   ADDP017                 No: assumed, that open is succes 00030600
         MVC   MSG3+9(8),=CL8'RAKFPROF'  DD-name                        00030700
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00030800
         LA    R0,L'MSG3               Length                           00030900
         BAL   R14,TPUT                Write the message on screen      00031000
         BAL   R14,CLOSE               Close the DCBs                   00031100
         BAL   R14,FREE                Free the data sets               00031200
         B     RC08                    Return code 8                    00031300
ADDP017  L     R6,ADRPROF              Max 1500 profile entries         00031400
*---------------------------------------------------------------------* 00031500
*        Write the RAKF Profiles back in the PROFILES member.         * 00031600
*---------------------------------------------------------------------* 00031700
ADDP019  DS    0H                                                       00031800
         PUT   RAKFPROF,0(R6)          Write ...                        00031900
         LA    R6,80(,R6)                    Profile ...                00032000
         BCT   R5,ADDP019                         table back            00032100
         MVC   MSG9PROF,PROFILE        Profile in success message       00032200
         MVC   MSG9CLS,CLASS           Class in success message         00032300
         LA    R1,MSG9                 Success message                  00032400
         LA    R0,L'MSG9               Length                           00032500
         BAL   R14,TPUT                Write the message on screen      00032600
         LA    R1,MSGA                 Msg: Run RAKFPROF ...            00032700
         LA    R0,L'MSGA               Length                           00032800
         BAL   R14,TPUT                Write the message on screen      00032900
         BAL   R14,CLOSE               Close the data sets              00033000
         BAL   R14,FREE                And unallocate                   00033100
         LA    R15,0                   RC = 0                           00033200
         B     RETURN                                                   00033300
*---------------------------------------------------------------------* 00033400
*        Return to TSO TMP.                                           * 00033500
*---------------------------------------------------------------------* 00033600
RC08     DS    0H                                                       00033700
         LA    R15,8                   RC = 8                           00033800
RETURN   DS    0H                                                       00033900
         LR    R4,R15                  Save return code                 00034000
         ICM   R2,15,PPL#LA            Is the PPL allocated?            00034100
         BZ    RETURN1                 No: do not free                  00034200
         LM    R2,R3,PPL#LA            Load length and address of PPL   00034300
         FREEMAIN RU,LV=(2),A=(3)      Free the PPL                     00034400
RETURN1  ICM   R8,15,ANSWER            Pointer to PDE's (the PDL)       00034500
         BZ    RETURN2                 No: skip                         00034600
         IKJRLSA (R8)                  Release PARSE storage            00034700
RETURN2  L     R2,ADRPROF              Address of Profile table         00034800
         FREEMAIN RU,LV=120000,A=(2)                                    00034900
         LR    R3,R13                  Load working storage to free     00035000
         L     R13,4(,R13)             Load caller's save area          00035100
         FREEMAIN RU,LV=WORKL,A=(3)    Release working storage          00035200
         LR    R15,R4                  Restore return code              00035300
         RETURN (14,12),RC=(15)        Return                           00035400
*                                                                       00035500
         TITLE 'Invoke IKJDAIR, A(Parm block) in R1'                    00035600
*---------------------------------------------------------------------* 00035700
*        Routine:   CALLTS                                            * 00035800
*        Function:  Invoke IKJDAIR to allocate or unallocate data sets* 00035900
*                   Register 1 contains the address of the allocation * 00036000
*                   or unallocation DAIR parameter blocks.            * 00036100
*---------------------------------------------------------------------* 00036200
CALLTS   DS    0H                                                       00036300
         ST    R14,R14TS               Save register 14                 00036400
         LR    R14,R1                  Save A(IKJDAIR parm block)       00036500
         XC    ECB,ECB                 Clear ECB                        00036600
         LA    R1,DAIRDAPL                                              00036700
         L     R2,MYCPPL               Pickup our CPPL                  00036800
         USING CPPL,R2                 Base CPPL                        00036900
         USING DAPL,R1                 Base IKJDAPL                     00037000
         MVC   DAPLUPT(4),CPPLUPT                                       00037100
         MVC   DAPLECT(4),CPPLECT                                       00037200
         XC    ECB,ECB                 Clear Event control block        00037300
         LA    R0,ECB                  Address of our ECB               00037400
         ST    R0,DAPLECB              Set A(ECB) in DAPL               00037500
         MVC   DAPLPSCB(4),CPPLPSCB                                     00037600
         ST    R14,DAPLDAPB            Set A(parm block) in DAPL        00037700
         CALLTSSR EP=IKJDAIR,MF=(E,DAIRDAPL)                            00037800
         L     R14,R14TS               Restore register 14              00037900
         BR    R14                                                      00038000
         DROP  R1,R2                   Unbase DAPL and CPPL             00038100
         TITLE 'Write message on screen'                                00038200
*---------------------------------------------------------------------* 00038300
*        Write the message on the terminal with a PUTLINE.            * 00038400
*        Register 0 = the length of the message.                      * 00038500
*        Register 1 = adress of the message.                          * 00038600
*---------------------------------------------------------------------* 00038700
TPUT     DS    0H                                                       00038800
         ST    R14,R14TPUT             Save register 14                 00038900
         L     R3,MYCPPL               Pickup CPPL of this command      00039000
         USING CPPL,R3                 Base IKJCPPL                     00039100
         MVI   PUTLINE+4,C' '          Clear output line                00039200
         MVC   PUTLINE+5(79),PUTLINE+4         ,,                       00039300
         LR    R2,R0                   Length of message                00039400
         BCTR  R2,0                    Minus 1 for EX                   00039500
         EX    R2,MVEMSG               Move the message                 00039600
         LA    R2,5(,R2)               Length in including length field 00039700
         XC    PUTLINE+2(2),PUTLINE+2  Byte 2 and 3, reserved           00039800
         STCM  R2,B'0011',PUTLINE      Save length in byte 0 and 1      00039900
         L     R2,CPPLUPT              User Profile Table               00040000
         L     R3,CPPLECT              Environment Control Table        00040100
         XC    ECB,ECB                 Force PUTLINE to wait            00040200
         LA    R0,PUTLINE              Data line address                00040300
         PUTLINE PARM=PUTBLOK,,MF=(E,PUTIOPL),                         *00040400
               OUTPUT=((0),TERM,SINGLE,DATA),ECB=ECB,UPT=(2),ECT=(3),  *00040500
               TERMPUT=(EDIT,WAIT,NOHOLD,NOBREAK)                       00040600
         L     R14,R14TPUT             Restore register 14              00040700
         BR    R14                                                      00040800
MVEMSG   MVC   PUTLINE+4(0),0(R1)      << executed >>                   00040900
         DROP  R3                      Unbase CPPL                      00041000
         TITLE 'Free SYS1.SECURE.CNTL'                                  00041100
FREE     DS    0H                                                       00041200
         ST    R14,R14FREE             Save register 14                 00041300
         LA    R3,DAIR18               Point to unallocation parm block 00041400
         XC    DAIR18,DAIR18           Clear unallocation parm block    00041500
         USING DAPB18,R3               IKJDAP18                         00041600
         MVI   DA18CD+1,X'18'          Entry code 0018 (unallocate)     00041700
         MVI   DA18MNM,C' '            Provide no ...                   00041800
         MVC   DA18MNM+1(7),DA18MNM               member name           00041900
         MVC   DA18DDN,=CL8'RAKFPROF'  DDNAME to unallocate             00042000
         LR    R1,R3                   Parameter CALLTS                 00042100
         BAL   R14,CALLTS              IKJDAIR routine                  00042200
         L     R14,R14FREE             Restore register 14              00042300
         BR    R14                     Return                           00042400
         DROP  R3                      Unbase DAPB18                    00042500
         TITLE 'Close RAKFPROF'                                         00042600
CLOSE    ST    R14,R14CLOSE            Save register 14                 00042700
         MVI   CLOSED,X'80'            First and only DCB               00042800
         CLOSE RAKFPROF,MF=(E,CLOSED)                                   00042900
         L     R14,R14CLOSE            Restore register 14              00043000
         BR    R14                     Return                           00043100
         TITLE 'DCB abend exit'                                         00043200
DCBABEND DS    0H                                                       00043300
         TM    3(R1),B'00001110'       Processing allowed?              00043400
         BZR   R14                     No: continue with abend          00043500
         TM    3(R1),4                 Ignore bit on?                   00043600
         MVI   3(R1),0                 Prepare for NO                   00043700
         BZR   R14                                                      00043800
         MVC   DCBCOMP,0(R1)           Move completion code             00043900
         NC    DCBCOMP,=X'FFF0'        Clear last nibble                00044000
         CLC   DCBCOMP,=X'9130'        Do we have an RACF/ACF2 abend?   00044100
         BNER  R14                     No: continue with abend          00044200
         MVI   3(R1),4                 Yes: ignore abend                00044300
         OI    SW,$913                 Indicate 913 abend               00044400
         BR    R14                     Return to Access Method          00044500
