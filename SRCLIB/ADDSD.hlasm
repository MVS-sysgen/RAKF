               HELP=('a valid profile e.g. SYS1.*')                     00047400
UACCKW   IKJKEYWD                                                       00047500
         IKJNAME 'UACC',SUBFLD=UACCSF                                   00047600
CLASSKW  IKJKEYWD                                                       00047700
