ADDSD    TITLE 'Add RAKF profile records'                               00000100
*---------------------------------------------------------------------* 00000200
*                                                                     * 00000300
*        Module:       ADDSD                                          * 00000400
*        Alias:        AD                                             * 00000500
*                      RDEFINE                                        * 00000600
*                      RDEF                                           * 00000700
*                                                                     * 00000800
*        Author:       Rob Prins                                      * 00000900
*                                                                     * 00001000
*        Attributes:   RENT, REUS.                                    * 00001100
*                                                                     * 00001200
*        Function:     Parse the syntax of the ADDSD   command.       * 00001300
*                      If the CLASS is specified (if RDEFINE is used),* 00001400
*                      check the classname against the CDT.           * 00001500
*                      Allocate SYS1.SECURE.CNTL(PROFILES)            * 00001600
*                      dynamically with IKJDAIR.                      * 00001700
*                      GETMAIN room for 1500 profiles.                * 00001800
*                      Read the PROFILES member into the table and    * 00001900
*                      skip the comments records.                     * 00002000
*                      Add new RAKF profiles in the PROFILES table.   * 00002100
*                      Sort the table alpabetically.                  * 00002200
*                                                                     * 00002300
*                      Write the PROFILES table back.                 * 00002400
*                      Free the SYS1.SECURE.CNTL data set.            * 00002500
*                                                                     * 00002600
*        Syntax:       ADDSD  profile UACC(NONE/READ/UPDATE/CONTROL   * 00002700
*                             ALTER)                                  * 00002800
*                                   -- OR --                          * 00002900
*                      RDEFINE profile UACC(NONE/READ/UPDATE/CONTROL  * 00003000
*                              ALTER) CLASS(class)                    * 00003100
*                                                                     * 00003200
*                      Required: profile                              * 00003300
*                                CLASS if command name = RDEFINE.     * 00003400
*                                                                     * 00003500
*                      Default: UACC(NONE)                            * 00003600
*                                                                     * 00003700
*        Return codes: 00 - all good.                                 * 00003800
*                      08 - an error occurred, user is notified       * 00003900
*                           with a message                            * 00004000
*                                                                     * 00004100
*---------------------------------------------------------------------* 00004200
ADDSD    CSECT                                                          00004300
         SAVE  (14,12),,*                                               00004400
         LR    R12,R15                                                  00004500
         USING ADDSD,R12               Base register                    00004600
         LR    R2,R1                   Save parm (CPPL)                 00004700
         GETMAIN RU,LV=WORKL           Obtain savearea + working strg.  00004800
         ST    R1,8(,R13)              Forward pointer                  00004900
         ST    R13,4(,R1)              Backward pointer                 00005000
         LR    R13,R1                  This is our save area            00005100
         USING WORKAREA,R13            Base working storage             00005200
         ST    R2,MYCPPL               Save our CPPL address            00005300
         L     R1,0(R2)                Point to CBUF in CPPL            00005400
         MVC   CMDNAME,4(R1)           Our program name (TSO command)   00005500
         MVC   RAKFPROF,MDLPROF        Move model DCB to working strg   00005600
         XC    DAIR08,DAIR08           Clear IKJDAIR                    00005700
         XC    DAIR18,DAIR18                        ... blocks          00005800
         XC    ANSWER,ANSWER           Clear IKJPARS answer             00005900
         XC    PPL#LA,PPL#LA           Clear PPL pointers               00006000
         MVC   MSG2,MSG2X              Move message to working storage  00006100
         MVC   MSG3,MSG3X              Move message to working storage  00006200
         MVC   MSG4,MSG4X              Move message to working storage  00006300
         MVC   MSG5,MSG5X              Move message to working storage  00006400
         MVC   MSG7,MSG7X              Move message to working storage  00006500
         MVC   MSG9,MSG9X              Move message to working storage  00006600
         MVC   MSGA,MSGAX              Move message to working storage  00006700
         MVC   MSGY,MSGYX              Move message to working storage  00006800
         MVC   MSGZ,MSGZX              Move message to working storage  00006900
         CLC   =C'RDEF',CMDNAME        Are we using alias RDEFINE?      00007000
         BNE   START1                  No: do not change messages       00007100
         MVC   MSG3(7),=CL7'RDEFINE'   Move command name in message     00007200
         MVC   MSG4(7),=CL7'RDEFINE'   Move command name in message     00007300
         MVC   MSG5(7),=CL7'RDEFINE'   Move command name in message     00007400
         MVC   MSG7(7),=CL7'RDEFINE'   Move command name in message     00007500
         MVC   MSG9(7),=CL7'RDEFINE'   Move command name in message     00007600
         MVC   MSGA(7),=CL7'RDEFINE'   Move command name in message     00007700
         MVC   MSGY(7),=CL7'RDEFINE'   Move command name in message     00007800
         MVC   MSGZ(7),=CL7'RDEFINE'   Move command name in message     00007900
START1   MVI   PROFREC-1,C' '          To blank Profile record          00008000
         MVC   CLASS,=CL8'DATASET'     Default resource class           00008100
         MVI   SW,0                    Clear flags                      00008200
         LA    R0,DCBABEND             DCB abend exit                   00008300
         ST    R0,EXLST                Save JFCB in exit list           00008400
         MVI   EXLST,X'91'             DCB abend exit is last entry     00008500
         LA    R0,EXLST                Exit list (DCB abend exit)       00008600
         STCM  R0,B'0111',RAKFPROF+DCBEXLSA-IHADCB                      00008700
         GETMAIN RU,LV=120000      GETMAIN room for 1500 profiles       00008800
         ST    R1,ADRPROF              Save its address                 00008900
         USING PSA,R0                  Point to CVT                     00009000
         L     R2,PSAANEW              Load ASCB                        00009100
         L     R2,ASCBASXB-ASCB(R2)    Load ASXB                        00009200
         ICM   R2,15,ASXBSENV-ASXB(R2) Point to ACEE                    00009300
         BNZ   CONT1                   Yes: found                       00009400
         LA    R1,MSGY                 Msg: 'No ACEE found'             00009500
         LA    R0,L'MSGY               Length                           00009600
         BAL   R14,TPUT                Write the message on screen      00009700
         B     RC08                    End with RC=-08                  00009800
CONT1    TM    ACEEFLG1-ACEE(R2),ACEESPEC Do we have the SPECIAL attr   00009900
         BO    CONT2                                                    00010000
         LA    R1,MSGZ                 Msg: 'No SPECIAL attribute'      00010100
         LA    R0,L'MSGZ               Length                           00010200
         BAL   R14,TPUT                Write the message on screen      00010300
         B     RC08                    End with RC=-08                  00010400
CONT2    DS    0H                                                       00010500
*---------------------------------------------------------------------* 00010600
*        Parse parameters                                             * 00010700
*---------------------------------------------------------------------* 00010800
         GETMAIN RU,LV=PPL#L           Obtain a dynamic PPL workarea    00010900
         STM   R0,R1,PPL#LA            Save length and address of PPL   00011000
         L     R2,PPL#PTR              Get the address of the PPL       00011100
         USING PPL,R2                  Adress it                        00011200
         L     R1,MYCPPL               Get address of CPPL              00011300
         USING CPPL,R1                 Address it                       00011400
*---------------------------------------------------------------------* 00011500
*                                                                       00011600
*        Populate the Parse Parameter List (PPL) from the CPPL,         00011700
*        add the IKJPARMD list in the PPL and invoke IKJPARS            00011800
*                                                                       00011900
*---------------------------------------------------------------------* 00012000
*                                                                       00012100
         MVC   PPLUPT,CPPLUPT          Put in the UPT address from CPPL 00012200
         MVC   PPLECT,CPPLECT          Put in the ECT address from CPPL 00012300
         MVC   PPLCBUF,CPPLCBUF        Put in the command buffer addr.  00012400
*                                      From the CPPL                    00012500
         XC    ECB,ECB                 Clear Event control block        00012600
         L     R1,=A(ADDPCL)           Address of PCL                   00012700
         ST    R1,PPLPCL               Set in PPL                       00012800
         LA    R1,ANSWER               Answer area                      00012900
         ST    R1,PPLANS               Pointer into PPL                 00013000
         LA    R1,ECB                  Event control block              00013100
         ST    R1,PPLECB               Pointer into PPL                 00013200
         ST    R13,PPLUWA              User provide workarea            00013300
         CALLTSSR EP=IKJPARS,MF=(E,PPL)   Invoke parse                  00013400
         DROP  R1,R2                   CPPL and PPL                     00013500
         LTR   R15,R15                 Parse successfully processed?    00013600
         BZ    PARSEOK                 Yes: carry                       00013700
         LA    R0,L'MSG5               Length                           00013800
         LA    R1,MSG5                 Message                          00013900
         BAL   R14,TPUT                                                 00014000
         XC    ANSWER,ANSWER           Avoid IKJRLSA                    00014100
         B     RC08                    Return to TMP                    00014200
PARSEOK  DS    0H                                                       00014300
         L     R8,ANSWER               Pointer to PDL                   00014400
         USING ADDPRS,R8               mapped with IKJPARM              00014500
         MVI   PROFILE,C' '                                             00014600
         MVC   PROFILE+1(L'PROFILE-1),PROFILE initialize profile        00014700
         LA    R3,PROFPDE              Profile PDE                      00014800
         USING PROFRET,R3              Base this PDE                    00014900
         L     R1,PROFPTR              Pointer to Profile name          00015000
         LH    R2,PROFL                Length                           00015100
         BCTR  R2,0                    -1 for EX                        00015200
         EX    R2,MVEPROF              Move Profile                     00015300
         B     ENDPROF                 Branch over EX                   00015400
MVEPROF  MVC   PROFILE(0),0(R1)        << Executed >>                   00015500
ENDPROF  DS    0H                                                       00015600
         DROP  R3                      Unbase PROFRET                   00015700
         LA    R3,CLASSPDE             Point to resource class PDE      00015800
         USING CLASRET,R3              Base this PDE                    00015900
         CLC   =C'RDEF',CMDNAME        TSO command RDEFINE?             00016000
         BNE   ENDCLAS                 No: then class is DATASET        00016100
         TM    CLASFLG,$CPRES          Is CLASS present?                00016200
         BNZ   CLAS001                 Yes: good                        00016300
         LA    R1,MSG6                 Msg: 'CLASS is required'         00016400
         LA    R0,L'MSG6               Length                           00016500
         BAL   R14,TPUT                Write message                    00016600
         B     RC08                    End with RC = 8                  00016700
CLAS001  DS    0H                                                       00016800
         MVC   CLASS,=CL8' '           Blank CLASS name                 00016900
         LH    R2,CLASL                Length of Class name             00017000
         L     R1,CLASPTR              Class name                       00017100
         BCTR  R2,0                    Minus 1 for EX                   00017200
         EX    R2,MVECLAS              Move Class name                  00017300
         B     CLAS002                 Branch over EX                   00017400
MVECLAS  MVC   CLASS(0),0(R1)          << Executed >>                   00017500
CLAS002  DS    0H                                                       00017600
*---------------------------------------------------------------------* 00017700
*        Check if ClASS name is in the Class Descriptor Table (CDT).  * 00017800
*        RACSTAT will be invoked for this check.                      * 00017900
*---------------------------------------------------------------------* 00018000
         L     R14,CVTPTR              Point to CVT                     00018100
         ICM   R14,15,CVTRAC-CVTMAP(R14) Load RCVT                      00018200
         ICM   R15,15,RCVTREXP-RCVT(R14) Entry point RACSTAT            00018300
         BZ    CLAS003                 No EP, Class not found           00018400
         LA    R1,CLASS                Class name                       00018500
         ST    R1,PARMSTAT             And save in first word           00018600
         LA    R1,PARMSTAT             Parameter for RACSTAT            00018700
         BALR  R14,R15                 Try to find class                00018800
         LTR   R15,R15                 Class found?                     00018900
         BZ    ENDCLAS                 Yes: good                        00019000
CLAS003  DS    0H                                                       00019100
         MVC   MSG2+15(8),CLASS        Class name into message          00019200
         LA    R1,MSG2                 Msg: 'CLASS not known to RAKF'   00019300
         LA    R0,L'MSG2               Length                           00019400
         BAL   R14,TPUT                Write message                    00019500
         B     RC08                    End with RC = 8                  00019600
ENDCLAS  DS    0H                                                       00019700
         DROP  R3                      Unbase CLASRET                   00019800
ENDPARS  DS    0H                                                       00019900
*---------------------------------------------------------------------* 00020000
*        Allocate SYS1.SECURE.CNTL(PROFILES)                          * 00020100
*---------------------------------------------------------------------* 00020200
         LA    R3,DAIR08               Allocation request block         00020300
         USING DAPB08,R3               Base DAPB08                      00020400
         MVI   DA08CD+1,X'08'          Entry code 08 (allocation)       00020500
         MVC   DA08DDN,=CL8'RAKFPROF'  DDNAME to allocate               00020600
         MVC   DA08PDSN,=A(PROFDSNL)   Temporary data set name          00020700
         MVI   DA08DSP1,DA08OLD        DISP=OLD                         00020800
         MVC   DA08MNM,=CL8'PROFILES'  Fixed member name                00020900
         MVI   DA08UNIT,C' '           Clear unit name                  00021000
         MVC   DA08UNIT+1(L'DA08UNIT-1),DA08UNIT                        00021100
         MVI   DA08SER,C' '            Clear volume serial              00021200
         MVC   DA08SER+1(L'DA08SER-1),DA08UNIT                          00021300
         LR    R1,R3                   Parameter CALLTS                 00021400
         BAL   R14,CALLTS              IKJDAIR routine                  00021500
         LTR   R15,R15                 Allocation OK?                   00021600
         BZ    ADDP001                 Yes: carry on                    00021700
         LA    R1,MSG1                 Msg: 'allocation error PROF'     00021800
         LA    R0,L'MSG1               Length                           00021900
         BAL   R14,TPUT                Write the message on screen      00022000
         B     RC08                    Return code 8                    00022100
ADDP001  DS    0H                                                       00022200
*---------------------------------------------------------------------* 00022300
*        Open SYS1.SECURE.CNTL(PROFILES) with DDNAME RAKPROF          * 00022400
*---------------------------------------------------------------------* 00022500
         MVI   OPEND,X'80'             First and only DCB               00022600
         OPEN  RAKFPROF,MF=(E,OPEND)                                    00022700
         TM    SW,$913                 Access denied?                   00022800
         BNO   ADDP005                 No: assumed, that open is succes 00022900
         MVC   MSG3+9(8),=CL8'RAKFPROF'  DD-name                        00023000
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00023100
         LA    R0,L'MSG3               Length                           00023200
         BAL   R14,TPUT                Write the message on screen      00023300
         BAL   R14,FREE                Free the data sets               00023400
         B     RC08                    Return code 8                    00023500
ADDP005  DS    0H                                                       00023600
*---------------------------------------------------------------------* 00023700
*        Read the PROFILES records and check if the profile is        * 00023800
*        already added.                                               * 00023900
*        And populate the table with Profile records.                 * 00024000
*---------------------------------------------------------------------* 00024100
         XR    R5,R5                   Clear record counter             00024200
         L     R6,ADRPROF              Start of Profile table           00024300
READPROF DS    0H                                                       00024400
         GET   RAKFPROF,PROFREC        Read a record                    00024500
         CLI   PROFREC,C'*'            Comment record?                  00024600
         BE    READPROF                Yes: skip                        00024700
         LA    R5,1(,R5)               Count record                     00024800
         C     R5,=F'1495'             Already 1495 records in table?   00024900
         BL    ADDP010                 No: room enough                  00025000
         LA    R1,MSG7                 Msg: 'table full'                00025100
         LA    R0,L'MSG7               Length                           00025200
         BAL   R14,TPUT                Write the message on screen      00025300
         BAL   R14,CLOSE               Close RAKFPROF                   00025400
         BAL   R14,FREE                Free the data sets               00025500
         B     RC08                    Return code 8                    00025600
ADDP010  CLC   PROFCPR,CLPROF          Match found of Class/Profile?    00025700
         BNE   ADDP011                 No: good                         00025800
         LA    R1,MSG4                 Msg: 'PROFILE already defined'   00025900
         LA    R0,L'MSG4               Length                           00026000
         BAL   R14,TPUT                Write the message on screen      00026100
         BAL   R14,CLOSE               Close the data sets              00026200
         BAL   R14,FREE                Free the data sets               00026300
         B     RC08                    Return code 8                    00026400
ADDP011  DS    0H                                                       00026500
         MVC   0(80,R6),PROFREC        Record into table                00026600
         LA    R6,80(,R6)              Next entry in table              00026700
         B     READPROF                Read next record                 00026800
PROFEOF  DS    0H                      EOF RACFPROF                     00026900
*                                                                       00027000
*---------------------------------------------------------------------* 00027100
*        Sort the Profile table alphabetically and                    * 00027200
*        write the Profile records in the Profile table.              * 00027300
*---------------------------------------------------------------------* 00027400
         MVC   PROFREC,PROFREC-1       Clear profile record             00027500
         MVC   PROFCLS,CLASS           Class name                       00027600
         MVC   PROFPRF,PROFILE         Move profile                     00027700
         LH    R1,UACC                 UACC PDL                         00027800
         MH    R1,=H'10'               Times 10 (MVC + B)               00027900
         B     *+4(R1)                 Branchlist                       00028000
         MVC   PROFACC,=CL8'NONE'      Default (0)                      00028100
         B     UACEND                                                   00028200
         MVC   PROFACC,=CL8'NONE'      (1)                              00028300
         B     UACEND                                                   00028400
         MVC   PROFACC,=CL8'READ'      (2)                              00028500
         B     UACEND                                                   00028600
         MVC   PROFACC,=CL8'UPDATE'    (3)                              00028700
         B     UACEND                                                   00028800
         MVC   PROFACC,=CL8'CONTROL'   (4)                              00028900
         B     UACEND                                                   00029000
         MVC   PROFACC,=CL8'ALTER'     (5)                              00029100
UACEND   MVC   0(80,R6),PROFREC        Move record in table             00029200
         LA    R5,1(,R5)               Count record                     00029300
         MVI   CLOSED,X'80'            First and only DCB               00029400
         CLOSE RAKFPROF,MF=(E,CLOSED)                                   00029500
SORT     STM   R4,R8,SAVESORT                                           00029600
         LR    R7,R5                   Copy record counter              00029700
         L     R2,ADRPROF              Point to first record            00029800
         CH    R7,=H'2'                Less than 2 records?             00029900
         BL    ENDSORT                 Do not sort                      00030000
         BCTR  R7,0                    Minus 1                          00030100
         MH    R7,=H'80'               ** Record length                 00030200
         LA    R7,0(R2,R7)             Point to last record             00030300
*                                                                       00030400
SORT01   DS    0H                      Start sort                       00030500
         ST    R7,SWAPLAST             Last record swapped              00030600
         L     R4,ADRPROF              Point to first record            00030700
         LR    R5,R4                   Next                             00030800
         LA    R5,80(,R4)                   Record                      00030900
SORT03   DS    0H                                                       00031000
         CL    R4,SWAPLAST             Last record reached?             00031100
         BNL   SORT07                  Yes: loop complete               00031200
         CLC   0(72,R4),0(R5)          Compare (skip sequence numbers)  00031300
         BNH   SORT05                  High: swap these records         00031400
         XC    0(80,R4),0(R5)          Swap                             00031500
         XC    0(80,R5),0(R4)              the                          00031600
         XC    0(80,R4),0(R5)                   records                 00031700
         LR    R7,R4                   Last record swapped in R7        00031800
SORT05   DS    0H                      Load next entry                  00031900
         LA    R4,80(,R4)              Next recodd                      00032000
         LA    R5,80(,R5)              Next record                      00032100
         B     SORT03                  Compare next record              00032200
SORT07   DS    0H                      All records done                 00032300
         CL    R7,SWAPLAST             Are these swaps executed?        00032400
         BL    SORT01                  No: sort them again              00032500
*                                      Else end of sort                 00032600
ENDSORT  LM    R4,R8,SAVESORT          Restore registers                00032700
         MVI   OPEND,X'80'             First and only DCB               00032800
         OPEN  (RAKFPROF,(OUTPUT)),MF=(E,OPEND)                         00032900
         TM    SW,$913                 Access denied?                   00033000
         BNO   ADDP017                 No: assumed, that open is succes 00033100
         MVC   MSG3+9(8),=CL8'RAKFPROF'  DD-name                        00033200
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00033300
         LA    R0,L'MSG3               Length                           00033400
         BAL   R14,TPUT                Write the message on screen      00033500
         BAL   R14,CLOSE               Close the DCBs                   00033600
         BAL   R14,FREE                Free the data sets               00033700
         B     RC08                    Return code 8                    00033800
ADDP017  L     R6,ADRPROF              Max 1500 profile entries         00033900
*---------------------------------------------------------------------* 00034000
*        Write the RAKF Profiles back in the PROFILES member.         * 00034100
*---------------------------------------------------------------------* 00034200
ADDP019  DS    0H                                                       00034300
         PUT   RAKFPROF,0(R6)          Write ...                        00034400
         LA    R6,80(,R6)                    Profile ...                00034500
         BCT   R5,ADDP019                         table back            00034600
         MVC   MSG9PROF,PROFILE        Profile in success message       00034700
         MVC   MSG9CLS,CLASS           Class in success message         00034800
         LA    R1,MSG9                 Success message                  00034900
         LA    R0,L'MSG9               Length                           00035000
         BAL   R14,TPUT                Write the message on screen      00035100
         LA    R1,MSGA                 Msg: Run RAKFPROF ...            00035200
         LA    R0,L'MSGA               Length                           00035300
         BAL   R14,TPUT                Write the message on screen      00035400
         BAL   R14,CLOSE               Close the data sets              00035500
         BAL   R14,FREE                And unallocate                   00035600
         LA    R15,0                   RC = 0                           00035700
         B     RETURN                                                   00035800
*---------------------------------------------------------------------* 00035900
*        Return to TSO TMP.                                           * 00036000
*---------------------------------------------------------------------* 00036100
RC08     DS    0H                                                       00036200
         LA    R15,8                   RC = 8                           00036300
RETURN   DS    0H                                                       00036400
         LR    R4,R15                  Save return code                 00036500
         ICM   R2,15,PPL#LA            Is the PPL allocated?            00036600
         BZ    RETURN1                 No: do not free                  00036700
         LM    R2,R3,PPL#LA            Load length and address of PPL   00036800
         FREEMAIN RU,LV=(2),A=(3)      Free the PPL                     00036900
RETURN1  ICM   R8,15,ANSWER            Pointer to PDE's (the PDL)       00037000
         BZ    RETURN2                 No: skip                         00037100
         IKJRLSA (R8)                  Release PARSE storage            00037200
RETURN2  L     R2,ADRPROF              Address of Profile table         00037300
         FREEMAIN RU,LV=120000,A=(2)                                    00037400
         LR    R3,R13                  Load working storage to free     00037500
         L     R13,4(,R13)             Load caller's save area          00037600
         FREEMAIN RU,LV=WORKL,A=(3)    Release working storage          00037700
         LR    R15,R4                  Restore return code              00037800
         RETURN (14,12),RC=(15)        Return                           00037900
*                                                                       00038000
         TITLE 'Invoke IKJDAIR, A(Parm block) in R1'                    00038100
*---------------------------------------------------------------------* 00038200
*        Routine:   CALLTS                                            * 00038300
*        Function:  Invoke IKJDAIR to allocate or unallocate data sets* 00038400
*                   Register 1 contains the address of the allocation * 00038500
*                   or unallocation DAIR parameter blocks.            * 00038600
*---------------------------------------------------------------------* 00038700
CALLTS   DS    0H                                                       00038800
         ST    R14,R14TS               Save register 14                 00038900
         LR    R14,R1                  Save A(IKJDAIR parm block)       00039000
         XC    ECB,ECB                 Clear ECB                        00039100
         LA    R1,DAIRDAPL                                              00039200
         L     R2,MYCPPL               Pickup our CPPL                  00039300
         USING CPPL,R2                 Base CPPL                        00039400
         USING DAPL,R1                 Base IKJDAPL                     00039500
         MVC   DAPLUPT(4),CPPLUPT                                       00039600
         MVC   DAPLECT(4),CPPLECT                                       00039700
         XC    ECB,ECB                 Clear Event control block        00039800
         LA    R0,ECB                  Address of our ECB               00039900
         ST    R0,DAPLECB              Set A(ECB) in DAPL               00040000
         MVC   DAPLPSCB(4),CPPLPSCB                                     00040100
         ST    R14,DAPLDAPB            Set A(parm block) in DAPL        00040200
         CALLTSSR EP=IKJDAIR,MF=(E,DAIRDAPL)                            00040300
         L     R14,R14TS               Restore register 14              00040400
         BR    R14                                                      00040500
         DROP  R1,R2                   Unbase DAPL and CPPL             00040600
         TITLE 'Write message on screen'                                00040700
*---------------------------------------------------------------------* 00040800
*        Write the message on the terminal with a PUTLINE.            * 00040900
*        Register 0 = the length of the message.                      * 00041000
*        Register 1 = adress of the message.                          * 00041100
*---------------------------------------------------------------------* 00041200
TPUT     DS    0H                                                       00041300
         ST    R14,R14TPUT             Save register 14                 00041400
         L     R3,MYCPPL               Pickup CPPL of this command      00041500
         USING CPPL,R3                 Base IKJCPPL                     00041600
         MVI   PUTLINE+4,C' '          Clear output line                00041700
         MVC   PUTLINE+5(79),PUTLINE+4         ,,                       00041800
         LR    R2,R0                   Length of message                00041900
         BCTR  R2,0                    Minus 1 for EX                   00042000
         EX    R2,MVEMSG               Move the message                 00042100
         LA    R2,5(,R2)               Length in including length field 00042200
         XC    PUTLINE+2(2),PUTLINE+2  Byte 2 and 3, reserved           00042300
         STCM  R2,B'0011',PUTLINE      Save length in byte 0 and 1      00042400
         L     R2,CPPLUPT              User Profile Table               00042500
         L     R3,CPPLECT              Environment Control Table        00042600
         XC    ECB,ECB                 Force PUTLINE to wait            00042700
         LA    R0,PUTLINE              Data line address                00042800
         PUTLINE PARM=PUTBLOK,,MF=(E,PUTIOPL),                         *00042900
               OUTPUT=((0),TERM,SINGLE,DATA),ECB=ECB,UPT=(2),ECT=(3),  *00043000
               TERMPUT=(EDIT,WAIT,NOHOLD,NOBREAK)                       00043100
         L     R14,R14TPUT             Restore register 14              00043200
         BR    R14                                                      00043300
MVEMSG   MVC   PUTLINE+4(0),0(R1)      << executed >>                   00043400
         DROP  R3                      Unbase CPPL                      00043500
         TITLE 'Free SYS1.SECURE.CNTL'                                  00043600
FREE     DS    0H                                                       00043700
         ST    R14,R14FREE             Save register 14                 00043800
         LA    R3,DAIR18               Point to unallocation parm block 00043900
         XC    DAIR18,DAIR18           Clear unallocation parm block    00044000
         USING DAPB18,R3               IKJDAP18                         00044100
         MVI   DA18CD+1,X'18'          Entry code 0018 (unallocate)     00044200
         MVI   DA18MNM,C' '            Provide no ...                   00044300
         MVC   DA18MNM+1(7),DA18MNM               member name           00044400
         MVC   DA18DDN,=CL8'RAKFPROF'  DDNAME to unallocate             00044500
         LR    R1,R3                   Parameter CALLTS                 00044600
         BAL   R14,CALLTS              IKJDAIR routine                  00044700
         L     R14,R14FREE             Restore register 14              00044800
         BR    R14                     Return                           00044900
         DROP  R3                      Unbase DAPB18                    00045000
         TITLE 'Close RAKFPROF'                                         00045100
CLOSE    ST    R14,R14CLOSE            Save register 14                 00045200
         MVI   CLOSED,X'80'            First and only DCB               00045300
         CLOSE RAKFPROF,MF=(E,CLOSED)                                   00045400
         L     R14,R14CLOSE            Restore register 14              00045500
         BR    R14                     Return                           00045600
         TITLE 'DCB abend exit'                                         00045700
DCBABEND DS    0H                                                       00045800
         TM    3(R1),B'00001110'       Processing allowed?              00045900
         BZR   R14                     No: continue with abend          00046000
         TM    3(R1),4                 Ignore bit on?                   00046100
         MVI   3(R1),0                 Prepare for NO                   00046200
         BZR   R14                                                      00046300
         MVC   DCBCOMP,0(R1)           Move completion code             00046400
         NC    DCBCOMP,=X'FFF0'        Clear last nibble                00046500
         CLC   DCBCOMP,=X'9130'        Do we have an RACF/ACF2 abend?   00046600
         BNER  R14                     No: continue with abend          00046700
         MVI   3(R1),4                 Yes: ignore abend                00046800
         OI    SW,$913                 Indicate 913 abend               00046900
         BR    R14                     Return to Access Method          00047000
