ADDSD    TITLE 'Add RAKF profile records'                               00000100
*---------------------------------------------------------------------* 00000200
*                                                                     * 00000300
*        Module:       ADDSD                                          * 00000400
*        Alias:        AD                                             * 00000500
*                      RDEFINE                                        * 00000600
*                      RDEF                                           * 00000700
*                                                                     * 00000800
*        Author:       Rob Prins                                      * 00000900
*                                                                     * 00001000
*        Attributes:   RENT, REUS.                                    * 00001100
*                                                                     * 00001200
*        Function:     Parse the syntax of the ADDSD   command.       * 00001300
*                      Allocate SYS1.SECURE.CNTL(PROFILES)            * 00001400
*                      dynamically with IKJDAIR.                      * 00001500
*                      GETMAIN room for 1500 profiles.                * 00001600
*                      Read the PROFILES member into the table and    * 00001700
*                      skip the comments records.                     * 00001800
*                      Add new RAKF profiles in the PROFILES table.   * 00001900
*                      Sort the table alpabetically.                  * 00002000
*                                                                     * 00002100
*                      Write the PROFILES table back.                 * 00002200
*                      Free the SYS1.SECURE.CNTL data set.            * 00002300
*                                                                     * 00002400
*        Syntax:       ADDSD  profile UACC(NONE/READ/UPDATE/CONTROL   * 00002500
*                             ALTER)                                  * 00002600
*                                   -- OR --                          * 00002700
*                      RDEFINE profile UACC(NONE/READ/UPDATE/CONTROL  * 00002800
*                              ALTER) CLASS(class)                    * 00002900
*                                                                     * 00003000
*                      Required: profile                              * 00003100
*                                CLASS if command name = RDEFINE.     * 00003200
*                                                                     * 00003300
*                      Default: UACC(NONE)                            * 00003400
*                                                                     * 00003500
*        Return codes: 00 - all good.                                 * 00003600
*                      08 - an error occurred, user is notified       * 00003700
*                           with a message                            * 00003800
*                                                                     * 00003900
*---------------------------------------------------------------------* 00004000
ADDSD    CSECT                                                          00004100
         SAVE  (14,12),,*                                               00004200
         LR    R12,R15                                                  00004300
         USING ADDSD,R12               Base register                    00004400
         LR    R2,R1                   Save parm (CPPL)                 00004500
         GETMAIN RU,LV=WORKL           Obtain savearea + working strg.  00004600
         ST    R1,8(,R13)              Forward pointer                  00004700
         ST    R13,4(,R1)              Backward pointer                 00004800
         LR    R13,R1                  This is our save area            00004900
         USING WORKAREA,R13            Base working storage             00005000
         ST    R2,MYCPPL               Save our CPPL address            00005100
         L     R1,0(R2)                Point to CBUF in CPPL            00005200
         MVC   CMDNAME,4(R1)           Our program name (TSO command)   00005300
         MVC   RAKFPROF,MDLPROF        Move model DCB to working strg   00005400
         XC    DAIR08,DAIR08           Clear IKJDAIR                    00005500
         XC    DAIR18,DAIR18                        ... blocks          00005600
         XC    ANSWER,ANSWER           Clear IKJPARS answer             00005700
         XC    PPL#LA,PPL#LA           Clear PPL pointers               00005800
         MVC   MSG3,MSG3X              Move message to working storage  00005900
         MVC   MSG4,MSG4X              Move message to working storage  00006000
         MVC   MSG5,MSG5X              Move message to working storage  00006100
         MVC   MSG7,MSG7X              Move message to working storage  00006200
         MVC   MSG9,MSG9X              Move message to working storage  00006300
         MVC   MSGA,MSGAX              Move message to working storage  00006400
         MVC   MSGY,MSGYX              Move message to working storage  00006500
         MVC   MSGZ,MSGZX              Move message to working storage  00006600
         CLC   =C'RDEF',CMDNAME        Are we using alias RDEFINE?      00006700
         BNE   START1                  No: do not change messages       00006800
         MVC   MSG3(7),=CL7'RDEFINE'   Move command name in message     00006900
         MVC   MSG4(7),=CL7'RDEFINE'   Move command name in message     00007000
         MVC   MSG5(7),=CL7'RDEFINE'   Move command name in message     00007100
         MVC   MSG7(7),=CL7'RDEFINE'   Move command name in message     00007200
         MVC   MSG9(7),=CL7'RDEFINE'   Move command name in message     00007300
         MVC   MSGA(7),=CL7'RDEFINE'   Move command name in message     00007400
         MVC   MSGY(7),=CL7'RDEFINE'   Move command name in message     00007500
         MVC   MSGZ(7),=CL7'RDEFINE'   Move command name in message     00007600
START1   MVI   PROFREC-1,C' '          To blank Profile record          00007700
         MVC   CLASS,=CL8'DATASET'     Default resource class           00007800
         MVI   SW,0                    Clear flags                      00007900
         LA    R0,DCBABEND             DCB abend exit                   00008000
         ST    R0,EXLST                Save JFCB in exit list           00008100
         MVI   EXLST,X'91'             DCB abend exit is last entry     00008200
         LA    R0,EXLST                Exit list (DCB abend exit)       00008300
         STCM  R0,B'0111',RAKFPROF+DCBEXLSA-IHADCB                      00008400
         GETMAIN RU,LV=120000      GETMAIN room for 1500 profiles       00008500
         ST    R1,ADRPROF              Save its address                 00008600
         USING PSA,R0                  Point to CVT                     00008700
         L     R2,PSAANEW              Load ASCB                        00008800
         L     R2,ASCBASXB-ASCB(R2)    Load ASXB                        00008900
         ICM   R2,15,ASXBSENV-ASXB(R2) Point to ACEE                    00009000
         BNZ   CONT1                   Yes: found                       00009100
         LA    R1,MSGY                 Msg: 'No ACEE found'             00009200
         LA    R0,L'MSGY               Length                           00009300
         BAL   R14,TPUT                Write the message on screen      00009400
         B     RC08                    End with RC=-08                  00009500
CONT1    TM    ACEEFLG1-ACEE(R2),ACEESPEC Do we have the SPECIAL attr   00009600
         BO    CONT2                                                    00009700
         LA    R1,MSGZ                 Msg: 'No SPECIAL attribute'      00009800
         LA    R0,L'MSGZ               Length                           00009900
         BAL   R14,TPUT                Write the message on screen      00010000
         B     RC08                    End with RC=-08                  00010100
CONT2    DS    0H                                                       00010200
*---------------------------------------------------------------------* 00010300
*        Parse parameters                                             * 00010400
*---------------------------------------------------------------------* 00010500
         GETMAIN RU,LV=PPL#L           Obtain a dynamic PPL workarea    00010600
         STM   R0,R1,PPL#LA            Save length and address of PPL   00010700
         L     R2,PPL#PTR              Get the address of the PPL       00010800
         USING PPL,R2                  Adress it                        00010900
         L     R1,MYCPPL               Get address of CPPL              00011000
         USING CPPL,R1                 Address it                       00011100
*---------------------------------------------------------------------* 00011200
*                                                                       00011300
*        Populate the Parse Parameter List (PPL) from the CPPL,         00011400
*        add the IKJPARMD list in the PPL and invoke IKJPARS            00011500
*                                                                       00011600
*---------------------------------------------------------------------* 00011700
*                                                                       00011800
         MVC   PPLUPT,CPPLUPT          Put in the UPT address from CPPL 00011900
         MVC   PPLECT,CPPLECT          Put in the ECT address from CPPL 00012000
         MVC   PPLCBUF,CPPLCBUF        Put in the command buffer addr.  00012100
*                                      From the CPPL                    00012200
         XC    ECB,ECB                 Clear Event control block        00012300
         L     R1,=A(ADDPCL)           Address of PCL                   00012400
         ST    R1,PPLPCL               Set in PPL                       00012500
         LA    R1,ANSWER               Answer area                      00012600
         ST    R1,PPLANS               Pointer into PPL                 00012700
         LA    R1,ECB                  Event control block              00012800
         ST    R1,PPLECB               Pointer into PPL                 00012900
         ST    R13,PPLUWA              User provide workarea            00013000
         CALLTSSR EP=IKJPARS,MF=(E,PPL)   Invoke parse                  00013100
         DROP  R1,R2                   CPPL and PPL                     00013200
         LTR   R15,R15                 Parse successfully processed?    00013300
         BZ    PARSEOK                 Yes: carry                       00013400
         LA    R0,L'MSG5               Length                           00013500
         LA    R1,MSG5                 Message                          00013600
         BAL   R14,TPUT                                                 00013700
         XC    ANSWER,ANSWER           Avoid IKJRLSA                    00013800
         B     RC08                    Return to TMP                    00013900
PARSEOK  DS    0H                                                       00014000
         L     R8,ANSWER               Pointer to PDL                   00014100
         USING ADDPRS,R8               mapped with IKJPARM              00014200
         MVI   PROFILE,C' '                                             00014300
         MVC   PROFILE+1(L'PROFILE-1),PROFILE initialize profile        00014400
         LA    R3,PROFPDE              Profile PDE                      00014500
         USING PROFRET,R3              Base this PDE                    00014600
         L     R1,PROFPTR              Pointer to Profile name          00014700
         LH    R2,PROFL                Length                           00014800
         BCTR  R2,0                    -1 for EX                        00014900
         EX    R2,MVEPROF              Move Profile                     00015000
         B     ENDPROF                 Branch over EX                   00015100
MVEPROF  MVC   PROFILE(0),0(R1)        << Executed >>                   00015200
ENDPROF  DS    0H                                                       00015300
         DROP  R3                      Unbase PROFRET                   00015400
         LA    R3,CLASSPDE             Point to resource class PDE      00015500
         USING CLASRET,R3              Base this PDE                    00015600
         CLC   =C'RDEF',CMDNAME        TSO command RDEFINE?             00015700
         BNE   ENDCLAS                 No: then class is DATASET        00015800
         TM    CLASFLG,$CPRES          Is CLASS present?                00015900
         BNZ   CLAS001                 Yes: good                        00016000
         LA    R1,MSG6                 Msg: 'CLASS is required'         00016100
         LA    R0,L'MSG6               Length                           00016200
         BAL   R14,TPUT                Write message                    00016300
         B     RC08                    End with RC = 8                  00016400
CLAS001  DS    0H                                                       00016500
         MVC   CLASS,=CL8' '           Blank CLASS name                 00016600
         LH    R2,CLASL                Length of Class name             00016700
         L     R1,CLASPTR              Class name                       00016800
         BCTR  R2,0                    Minus 1 for EX                   00016900
         EX    R2,MVECLAS              Move Class name                  00017000
         B     ENDCLAS                 Branch over EX                   00017100
MVECLAS  MVC   CLASS(0),0(R1)          << Executed >>                   00017200
ENDCLAS  DS    0H                                                       00017300
         DROP  R3                      Unbase CLASRET                   00017400
ENDPARS  DS    0H                                                       00017500
*---------------------------------------------------------------------* 00017600
*        Allocate SYS1.SECURE.CNTL(PROFILES)                          * 00017700
*---------------------------------------------------------------------* 00017800
         LA    R3,DAIR08               Allocation request block         00017900
         USING DAPB08,R3               Base DAPB08                      00018000
         MVI   DA08CD+1,X'08'          Entry code 08 (allocation)       00018100
         MVC   DA08DDN,=CL8'RAKFPROF'  DDNAME to allocate               00018200
         MVC   DA08PDSN,=A(PROFDSNL)   Temporary data set name          00018300
         MVI   DA08DSP1,DA08OLD        DISP=OLD                         00018400
         MVC   DA08MNM,=CL8'PROFILES'  Fixed member name                00018500
         MVI   DA08UNIT,C' '           Clear unit name                  00018600
         MVC   DA08UNIT+1(L'DA08UNIT-1),DA08UNIT                        00018700
         MVI   DA08SER,C' '            Clear volume serial              00018800
         MVC   DA08SER+1(L'DA08SER-1),DA08UNIT                          00018900
         LR    R1,R3                   Parameter CALLTS                 00019000
         BAL   R14,CALLTS              IKJDAIR routine                  00019100
         LTR   R15,R15                 Allocation OK?                   00019200
         BZ    ADDP001                 Yes: carry on                    00019300
         LA    R1,MSG1                 Msg: 'allocation error PROF'     00019400
         LA    R0,L'MSG1               Length                           00019500
         BAL   R14,TPUT                Write the message on screen      00019600
         B     RC08                    Return code 8                    00019700
ADDP001  DS    0H                                                       00019800
*---------------------------------------------------------------------* 00019900
*        Open SYS1.SECURE.CNTL(PROFILES) with DDNAME RAKPROF          * 00020000
*---------------------------------------------------------------------* 00020100
         MVI   OPEND,X'80'             First and only DCB               00020200
         OPEN  RAKFPROF,MF=(E,OPEND)                                    00020300
         TM    SW,$913                 Access denied?                   00020400
         BNO   ADDP005                 No: assumed, that open is succes 00020500
         MVC   MSG3+9(8),=CL8'RAKFPROF'  DD-name                        00020600
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00020700
         LA    R0,L'MSG3               Length                           00020800
         BAL   R14,TPUT                Write the message on screen      00020900
         BAL   R14,FREE                Free the data sets               00021000
         B     RC08                    Return code 8                    00021100
ADDP005  DS    0H                                                       00021200
*---------------------------------------------------------------------* 00021300
*        Read the PROFILES records and check if the profile is        * 00021400
*        already added.                                               * 00021500
*        And populate the table with Profile records.                 * 00021600
*---------------------------------------------------------------------* 00021700
         XR    R5,R5                   Clear record counter             00021800
         L     R6,ADRPROF              Start of Profile table           00021900
READPROF DS    0H                                                       00022000
         GET   RAKFPROF,PROFREC        Read a record                    00022100
         CLI   PROFREC,C'*'            Comment record?                  00022200
         BE    READPROF                Yes: skip                        00022300
         LA    R5,1(,R5)               Count record                     00022400
         C     R5,=F'1495'             Already 1495 records in table?   00022500
         BL    ADDP010                 No: room enough                  00022600
         LA    R1,MSG7                 Msg: 'table full'                00022700
         LA    R0,L'MSG7               Length                           00022800
         BAL   R14,TPUT                Write the message on screen      00022900
         BAL   R14,CLOSE               Close RAKFPROF                   00023000
         BAL   R14,FREE                Free the data sets               00023100
         B     RC08                    Return code 8                    00023200
ADDP010  CLC   PROFPRF,PROFILE         Match found of Profile?          00023300
         BNE   ADDP011                 No: good                         00023400
         LA    R1,MSG4                 Msg: 'PROFILE already defined'   00023500
         LA    R0,L'MSG4               Length                           00023600
         BAL   R14,TPUT                Write the message on screen      00023700
         BAL   R14,CLOSE               Close the data sets              00023800
         BAL   R14,FREE                Free the data sets               00023900
         B     RC08                    Return code 8                    00024000
ADDP011  DS    0H                                                       00024100
         MVC   0(80,R6),PROFREC        Record into table                00024200
         LA    R6,80(,R6)              Next entry in table              00024300
         B     READPROF                Read next record                 00024400
PROFEOF  DS    0H                      EOF RACFPROF                     00024500
*                                                                       00024600
*---------------------------------------------------------------------* 00024700
*        Sort the Profile table alphabetically and                    * 00024800
*        write the Profile records in the Profile table.              * 00024900
*---------------------------------------------------------------------* 00025000
         MVC   PROFREC,PROFREC-1       Clear profile record             00025100
         MVC   PROFCLS,CLASS           Class name                       00025200
         MVC   PROFPRF,PROFILE         Move profile                     00025300
         LH    R1,UACC                 UACC PDL                         00025400
         MH    R1,=H'10'               Times 10 (MVC + B)               00025500
         B     *+4(R1)                 Branchlist                       00025600
         MVC   PROFACC,=CL8'NONE'      Default (0)                      00025700
         B     UACEND                                                   00025800
         MVC   PROFACC,=CL8'NONE'      (1)                              00025900
         B     UACEND                                                   00026000
         MVC   PROFACC,=CL8'READ'      (2)                              00026100
         B     UACEND                                                   00026200
         MVC   PROFACC,=CL8'UPDATE'    (3)                              00026300
         B     UACEND                                                   00026400
         MVC   PROFACC,=CL8'CONTROL'   (4)                              00026500
         B     UACEND                                                   00026600
         MVC   PROFACC,=CL8'ALTER'     (5)                              00026700
UACEND   MVC   0(80,R6),PROFREC        Move record in table             00026800
         LA    R5,1(,R5)               Count record                     00026900
         MVI   CLOSED,X'80'            First and only DCB               00027000
         CLOSE RAKFPROF,MF=(E,CLOSED)                                   00027100
SORT     STM   R4,R8,SAVESORT                                           00027200
         LR    R7,R5                   Copy record counter              00027300
         L     R2,ADRPROF              Point to first record            00027400
         CH    R7,=H'2'                Less than 2 records?             00027500
         BL    ENDSORT                 Do not sort                      00027600
         BCTR  R7,0                    Minus 1                          00027700
         MH    R7,=H'80'               ** Record length                 00027800
         LA    R7,0(R2,R7)             Point to last record             00027900
*                                                                       00028000
SORT01   DS    0H                      Start sort                       00028100
         ST    R7,SWAPLAST             Last record swapped              00028200
         L     R4,ADRPROF              Point to first record            00028300
         LR    R5,R4                   Next                             00028400
         LA    R5,80(,R4)                   Record                      00028500
SORT03   DS    0H                                                       00028600
         CL    R4,SWAPLAST             Last record reached?             00028700
         BNL   SORT07                  Yes: loop complete               00028800
         CLC   0(72,R4),0(R5)          Compare (skip sequence numbers)  00028900
         BNH   SORT05                  High: swap these records         00029000
         XC    0(80,R4),0(R5)          Swap                             00029100
         XC    0(80,R5),0(R4)              the                          00029200
         XC    0(80,R4),0(R5)                   records                 00029300
         LR    R7,R4                   Last record swapped in R7        00029400
SORT05   DS    0H                      Load next entry                  00029500
         LA    R4,80(,R4)              Next recodd                      00029600
         LA    R5,80(,R5)              Next record                      00029700
         B     SORT03                  Compare next record              00029800
SORT07   DS    0H                      All records done                 00029900
         CL    R7,SWAPLAST             Are these swaps executed?        00030000
         BL    SORT01                  No: sort them again              00030100
*                                      Else end of sort                 00030200
ENDSORT  LM    R4,R8,SAVESORT          Restore registers                00030300
         MVI   OPEND,X'80'             First and only DCB               00030400
         OPEN  (RAKFPROF,(OUTPUT)),MF=(E,OPEND)                         00030500
         TM    SW,$913                 Access denied?                   00030600
         BNO   ADDP017                 No: assumed, that open is succes 00030700
         MVC   MSG3+9(8),=CL8'RAKFPROF'  DD-name                        00030800
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00030900
         LA    R0,L'MSG3               Length                           00031000
         BAL   R14,TPUT                Write the message on screen      00031100
         BAL   R14,CLOSE               Close the DCBs                   00031200
         BAL   R14,FREE                Free the data sets               00031300
         B     RC08                    Return code 8                    00031400
ADDP017  L     R6,ADRPROF              Max 1500 profile entries         00031500
*---------------------------------------------------------------------* 00031600
*        Write the RAKF Profiles back in the PROFILES member.         * 00031700
*---------------------------------------------------------------------* 00031800
ADDP019  DS    0H                                                       00031900
         PUT   RAKFPROF,0(R6)          Write ...                        00032000
         LA    R6,80(,R6)                    Profile ...                00032100
         BCT   R5,ADDP019                         table back            00032200
         MVC   MSG9PROF,PROFILE        Profile in success message       00032300
         MVC   MSG9CLS,CLASS           Class in success message         00032400
         LA    R1,MSG9                 Success message                  00032500
         LA    R0,L'MSG9               Length                           00032600
         BAL   R14,TPUT                Write the message on screen      00032700
         LA    R1,MSGA                 Msg: Run RAKFPROF ...            00032800
         LA    R0,L'MSGA               Length                           00032900
         BAL   R14,TPUT                Write the message on screen      00033000
         BAL   R14,CLOSE               Close the data sets              00033100
         BAL   R14,FREE                And unallocate                   00033200
         LA    R15,0                   RC = 0                           00033300
         B     RETURN                                                   00033400
*---------------------------------------------------------------------* 00033500
*        Return to TSO TMP.                                           * 00033600
*---------------------------------------------------------------------* 00033700
RC08     DS    0H                                                       00033800
         LA    R15,8                   RC = 8                           00033900
RETURN   DS    0H                                                       00034000
         LR    R4,R15                  Save return code                 00034100
         ICM   R2,15,PPL#LA            Is the PPL allocated?            00034200
         BZ    RETURN1                 No: do not free                  00034300
         LM    R2,R3,PPL#LA            Load length and address of PPL   00034400
         FREEMAIN RU,LV=(2),A=(3)      Free the PPL                     00034500
RETURN1  ICM   R8,15,ANSWER            Pointer to PDE's (the PDL)       00034600
         BZ    RETURN2                 No: skip                         00034700
         IKJRLSA (R8)                  Release PARSE storage            00034800
RETURN2  L     R2,ADRPROF              Address of Profile table         00034900
         FREEMAIN RU,LV=120000,A=(2)                                    00035000
         LR    R3,R13                  Load working storage to free     00035100
         L     R13,4(,R13)             Load caller's save area          00035200
         FREEMAIN RU,LV=WORKL,A=(3)    Release working storage          00035300
         LR    R15,R4                  Restore return code              00035400
         RETURN (14,12),RC=(15)        Return                           00035500
*                                                                       00035600
         TITLE 'Invoke IKJDAIR, A(Parm block) in R1'                    00035700
*---------------------------------------------------------------------* 00035800
*        Routine:   CALLTS                                            * 00035900
*        Function:  Invoke IKJDAIR to allocate or unallocate data sets* 00036000
*                   Register 1 contains the address of the allocation * 00036100
*                   or unallocation DAIR parameter blocks.            * 00036200
*---------------------------------------------------------------------* 00036300
CALLTS   DS    0H                                                       00036400
         ST    R14,R14TS               Save register 14                 00036500
         LR    R14,R1                  Save A(IKJDAIR parm block)       00036600
         XC    ECB,ECB                 Clear ECB                        00036700
         LA    R1,DAIRDAPL                                              00036800
         L     R2,MYCPPL               Pickup our CPPL                  00036900
         USING CPPL,R2                 Base CPPL                        00037000
         USING DAPL,R1                 Base IKJDAPL                     00037100
         MVC   DAPLUPT(4),CPPLUPT                                       00037200
         MVC   DAPLECT(4),CPPLECT                                       00037300
         XC    ECB,ECB                 Clear Event control block        00037400
         LA    R0,ECB                  Address of our ECB               00037500
         ST    R0,DAPLECB              Set A(ECB) in DAPL               00037600
         MVC   DAPLPSCB(4),CPPLPSCB                                     00037700
         ST    R14,DAPLDAPB            Set A(parm block) in DAPL        00037800
         CALLTSSR EP=IKJDAIR,MF=(E,DAIRDAPL)                            00037900
         L     R14,R14TS               Restore register 14              00038000
         BR    R14                                                      00038100
         DROP  R1,R2                   Unbase DAPL and CPPL             00038200
         TITLE 'Write message on screen'                                00038300
*---------------------------------------------------------------------* 00038400
*        Write the message on the terminal with a PUTLINE.            * 00038500
*        Register 0 = the length of the message.                      * 00038600
*        Register 1 = adress of the message.                          * 00038700
*---------------------------------------------------------------------* 00038800
TPUT     DS    0H                                                       00038900
         ST    R14,R14TPUT             Save register 14                 00039000
         L     R3,MYCPPL               Pickup CPPL of this command      00039100
         USING CPPL,R3                 Base IKJCPPL                     00039200
         MVI   PUTLINE+4,C' '          Clear output line                00039300
         MVC   PUTLINE+5(79),PUTLINE+4         ,,                       00039400
         LR    R2,R0                   Length of message                00039500
         BCTR  R2,0                    Minus 1 for EX                   00039600
         EX    R2,MVEMSG               Move the message                 00039700
         LA    R2,5(,R2)               Length in including length field 00039800
         XC    PUTLINE+2(2),PUTLINE+2  Byte 2 and 3, reserved           00039900
         STCM  R2,B'0011',PUTLINE      Save length in byte 0 and 1      00040000
         L     R2,CPPLUPT              User Profile Table               00040100
         L     R3,CPPLECT              Environment Control Table        00040200
         XC    ECB,ECB                 Force PUTLINE to wait            00040300
         LA    R0,PUTLINE              Data line address                00040400
         PUTLINE PARM=PUTBLOK,,MF=(E,PUTIOPL),                         *00040500
               OUTPUT=((0),TERM,SINGLE,DATA),ECB=ECB,UPT=(2),ECT=(3),  *00040600
               TERMPUT=(EDIT,WAIT,NOHOLD,NOBREAK)                       00040700
         L     R14,R14TPUT             Restore register 14              00040800
         BR    R14                                                      00040900
MVEMSG   MVC   PUTLINE+4(0),0(R1)      << executed >>                   00041000
         DROP  R3                      Unbase CPPL                      00041100
         TITLE 'Free SYS1.SECURE.CNTL'                                  00041200
FREE     DS    0H                                                       00041300
         ST    R14,R14FREE             Save register 14                 00041400
         LA    R3,DAIR18               Point to unallocation parm block 00041500
         XC    DAIR18,DAIR18           Clear unallocation parm block    00041600
         USING DAPB18,R3               IKJDAP18                         00041700
         MVI   DA18CD+1,X'18'          Entry code 0018 (unallocate)     00041800
         MVI   DA18MNM,C' '            Provide no ...                   00041900
         MVC   DA18MNM+1(7),DA18MNM               member name           00042000
         MVC   DA18DDN,=CL8'RAKFPROF'  DDNAME to unallocate             00042100
         LR    R1,R3                   Parameter CALLTS                 00042200
         BAL   R14,CALLTS              IKJDAIR routine                  00042300
         L     R14,R14FREE             Restore register 14              00042400
         BR    R14                     Return                           00042500
         DROP  R3                      Unbase DAPB18                    00042600
         TITLE 'Close RAKFPROF'                                         00042700
CLOSE    ST    R14,R14CLOSE            Save register 14                 00042800
         MVI   CLOSED,X'80'            First and only DCB               00042900
         CLOSE RAKFPROF,MF=(E,CLOSED)                                   00043000
         L     R14,R14CLOSE            Restore register 14              00043100
         BR    R14                     Return                           00043200
         TITLE 'DCB abend exit'                                         00043300
DCBABEND DS    0H                                                       00043400
         TM    3(R1),B'00001110'       Processing allowed?              00043500
         BZR   R14                     No: continue with abend          00043600
         TM    3(R1),4                 Ignore bit on?                   00043700
         MVI   3(R1),0                 Prepare for NO                   00043800
         BZR   R14                                                      00043900
         MVC   DCBCOMP,0(R1)           Move completion code             00044000
         NC    DCBCOMP,=X'FFF0'        Clear last nibble                00044100
         CLC   DCBCOMP,=X'9130'        Do we have an RACF/ACF2 abend?   00044200
         BNER  R14                     No: continue with abend          00044300
         MVI   3(R1),4                 Yes: ignore abend                00044400
         OI    SW,$913                 Indicate 913 abend               00044500
         BR    R14                     Return to Access Method          00044600
