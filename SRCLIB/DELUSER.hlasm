DELUSER  TITLE 'Deleta RAKF users from the control data sets'           00000100
*---------------------------------------------------------------------* 00000200
*                                                                     * 00000300
*        Module:       DELUSER                                        * 00000400
*                                                                     * 00000500
*        Author:       Rob Prins                                      * 00000600
*                                                                     * 00000700
*        Attributes:   RENT, REUS.                                    * 00000800
*                                                                     * 00000900
*        Function:     Parse the syntax of the DELUSER command.       * 00001000
*                      Allocate SYS1.SECURE.CNTL(USERS) and           * 00001100
*                      SYS1.SECURE.SHADOW dynamically with IKJDAIR.   * 00001200
*                      Read the USERS table into storage,             * 00001300
*                      delete the user and write the table back.      * 00001400
*                      Read the SHADOW data set into storage,         * 00001500
*                      delete the user and write the table back into  * 00001600
*                      the SHADOW data set.                           * 00001700
*                      Free the SYS1.SECURE.* data sets.              * 00001800
*                                                                     * 00001900
*        Syntax:       DELUSER userid                                 * 00002000
*                                                                     * 00002100
*        Return codes: 00 - all good.                                 * 00002200
*                      08 - an error occurred, user is notified       * 00002300
*                           with a message                            * 00002400
*                                                                     * 00002500
*---------------------------------------------------------------------* 00002600
DELUSER  CSECT                                                          00002700
         SAVE  (14,12)                                                  00002800
         LR    R12,R15                                                  00002900
         USING DELUSER,R12             Base register                    00003000
         LR    R2,R1                   Save parm (CPPL)                 00003100
         GETMAIN RU,LV=WORKL           Obtain savearea + working strg.  00003200
         ST    R1,8(,R13)              Forward pointer                  00003300
         ST    R13,4(,R1)              Backward pointer                 00003400
         LR    R13,R1                  This is our save area            00003500
         USING WORKAREA,R13            Base working storage             00003600
         ST    R2,MYCPPL               Save our CPPL address            00003700
START    DS    0H                                                       00003800
         MVC   RAKFSHAD,MDLSHAD        Move ...                         00003900
         MVC   RAKFUSER,MDLUSER             ... model DCBs              00004000
         XC    DAIR08,DAIR08           Clear IKJDAIR                    00004100
         XC    DAIR18,DAIR18                        ... blocks          00004200
         XC    ANSWER,ANSWER           Clear IKJPARS answer             00004300
         XC    PPL#LA,PPL#LA           Clear PPL pointers               00004400
         MVC   MSG3,MSG3X              Move message to working storage  00004500
         MVC   MSG6,MSG6X              Move message to working storage  00004600
         MVI   SW,0                    Clear flags                      00004700
         LA    R0,DCBABEND             DCB abend exit                   00004800
         ST    R0,EXLST                Save JFCB in exit list           00004900
         MVI   EXLST,X'91'             DCB abend exit is last entry     00005000
         LA    R0,EXLST                Exit list (DCB abend exit)       00005100
         STCM  R0,B'0111',RAKFUSER+DCBEXLSA-IHADCB                      00005200
         STCM  R0,B'0111',RAKFSHAD+DCBEXLSA-IHADCB                      00005300
         GETMAIN RU,LV=104000      GETMAIN room for 1300 user records   00005400
         ST    R1,ADRUSER              Save its address                 00005500
         USING PSA,R0                  Point to CVT                     00005600
         L     R2,PSAANEW-PSA          Load ASCB                        00005700
         L     R2,ASCBASXB-ASCB(R2)    Load ASXB                        00005800
         ICM   R2,15,ASXBSENV-ASXB(R2) Point to ACEE                    00005900
         BNZ   CONT1                   Yes: found                       00006000
         LA    R1,MSGY                 Msg: 'No ACEE found'             00006100
         LA    R0,L'MSGY               Length                           00006200
         BAL   R14,TPUT                Write the message on screen      00006300
         B     RC08                    End with RC=-08                  00006400
CONT1    TM    ACEEFLG1-ACEE(R2),ACEESPEC Do we have the SPECIAL attr   00006500
         BO    CONT2                                                    00006600
         LA    R1,MSGZ                 Msg: 'No SPECIAL attribute'      00006700
         LA    R0,L'MSGZ               Length                           00006800
         BAL   R14,TPUT                Write the message on screen      00006900
         B     RC08                    End with RC=-08                  00007000
CONT2    DS    0H                                                       00007100
*---------------------------------------------------------------------* 00007200
*        Parse parameters                                             * 00007300
*---------------------------------------------------------------------* 00007400
         GETMAIN RU,LV=PPL#L           Obtain a dynamic PPL workarea    00007500
         STM   R0,R1,PPL#LA            Save length and address of PPL   00007600
         L     R2,PPL#PTR              Get the address of the PPL       00007700
         USING PPL,R2                  Adress it                        00007800
         L     R1,MYCPPL               Get address of CPPL              00007900
         USING CPPL,R1                 Address it                       00008000
*---------------------------------------------------------------------* 00008100
*        Populate the Parse Parameter List (PPL) from the CPPL,         00008200
*        add the IKJPARMD list in the PPL and invoke IKJPARS            00008300
*---------------------------------------------------------------------* 00008400
*                                                                       00008500
         MVC   PPLUPT,CPPLUPT          Put in the UPT address from CPPL 00008600
         MVC   PPLECT,CPPLECT          Put in the ECT address from CPPL 00008700
         MVC   PPLCBUF,CPPLCBUF        Put in the command buffer addr.  00008800
*                                      From the CPPL                    00008900
         XC    ECB,ECB                 Clear Event control block        00009000
         L     R1,=A(ADDPCL)           Address of PCL                   00009100
         ST    R1,PPLPCL               Set in PPL                       00009200
         LA    R1,ANSWER               Answer area                      00009300
         ST    R1,PPLANS               Pointer into PPL                 00009400
         LA    R1,ECB                  Event control block              00009500
         ST    R1,PPLECB               Pointer into PPL                 00009600
         ST    R13,PPLUWA              User provide workarea            00009700
         CALLTSSR EP=IKJPARS,MF=(E,PPL)   Invoke parse                  00009800
         DROP  R1,R2                   CPPL and PPL                     00009900
         LTR   R15,R15                 Parse successfully processed?    00010000
         BZ    PARSEOK                 Yes: carry                       00010100
         LA    R0,L'MSG5               Length                           00010200
         LA    R1,MSG5                 Message                          00010300
         BAL   R14,TPUT                                                 00010400
         B     RC08                    Return to TMP                    00010500
PARSEOK  DS    0H                                                       00010600
         L     R8,ANSWER               Pointer to PDL                   00010700
         USING ADDPRS,R8               mapped with IKJPARM              00010800
         MVC   USERID,=CL8' '          Initialize UserID                00010900
         LA    R3,UIDPDE               UserID PDE                       00011000
         USING UIDRET,R3               Base this PDE                    00011100
         L     R1,UIDPTR               Pointer to UserID                00011200
         LH    R2,UIDL                 Length                           00011300
         BCTR  R2,0                    -1 for EX                        00011400
         EX    R2,MVEUID               Move UserID                      00011500
         B     ENDPARS                 Branch over EX                   00011600
MVEUID   MVC   USERID(0),0(R1)         << Executed >>                   00011700
         DROP  R3                      Unbase UIDRET                    00011800
ENDPARS  DS    0H                                                       00011900
*---------------------------------------------------------------------* 00012000
*        Allocate SYS1.SECURE.CNTL(USERS) and SYS1.SECURE.SHADOW      * 00012100
*---------------------------------------------------------------------* 00012200
         LA    R3,DAIR08               Allocation request block         00012300
         USING DAPB08,R3               Base DAPB08                      00012400
         MVI   DA08CD+1,X'08'          Entry code 08 (allocation)       00012500
         MVC   DA08DDN,=CL8'RAKFUSER'  DDNAME to allocate               00012600
         MVC   DA08PDSN,=A(USRDSNL)    Temporary data set name          00012700
         MVI   DA08DSP1,DA08OLD        DISP=OLD                         00012800
         MVC   DA08MNM,=CL8'USERS'     Fixed member name                00012900
         MVI   DA08UNIT,C' '           Clear unit name                  00013000
         MVC   DA08UNIT+1(L'DA08UNIT-1),DA08UNIT                        00013100
         MVI   DA08SER,C' '            Clear volume serial              00013200
         MVC   DA08SER+1(L'DA08SER-1),DA08UNIT                          00013300
         LR    R1,R3                   Parameter CALLTS                 00013400
         BAL   R14,CALLTS              IKJDAIR routine                  00013500
         LTR   R15,R15                 Allocation OK?                   00013600
         BZ    DELU001                 Yes: carry on                    00013700
         LA    R1,MSG1                 Msg: 'allocation error USER'     00013800
         LA    R0,L'MSG1               Length                           00013900
         BAL   R14,TPUT                Write the message on screen      00014000
         B     RC08                    Return code 8                    00014100
DELU001  DS    0H                                                       00014200
         MVC   DA08DDN,=CL8'RAKFSHAD'  DDNAME to allocate               00014300
         MVC   DA08PDSN,=A(SHDDSNL)    Temporary data set name          00014400
         MVI   DA08MNM,C' '            Clear member name                00014500
         MVC   DA08MNM(L'DA08MNM-1),DA08MNM                             00014600
         LR    R1,R3                   Parameter CALLTS                 00014700
         BAL   R14,CALLTS              IKJDAIR routine                  00014800
         LTR   R15,R15                 Allocation OK?                   00014900
         BZ    DELU003                 Yes: carry on                    00015000
         LA    R1,MSG2                 Msg: 'allocation error SHADOW'   00015100
         LA    R0,L'MSG2               Length                           00015200
         BAL   R14,TPUT                Write the message on screen      00015300
         BAL   R14,FREE                Free the data sets               00015400
         B     RC08                    Return code 8                    00015500
         DROP  R3                      Unbase DABP08                    00015600
DELU003  DS    0H                                                       00015700
*---------------------------------------------------------------------* 00015800
*        Open SYS1.SECURE.CNTL(USERS) with DDNAME RAKUSER             * 00015900
*---------------------------------------------------------------------* 00016000
         MVI   OPEND,X'80'             First and only DCB               00016100
         OPEN  RAKFUSER,MF=(E,OPEND)                                    00016200
         TM    SW,$913                 Access denied?                   00016300
         BNO   DELU005                 No: assumed, that open is succes 00016400
         MVC   MSG3+9(8),=CL8'RAKFUSER'  DD-name                        00016500
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00016600
         LA    R0,L'MSG3               Length                           00016700
         BAL   R14,TPUT                Write the message on screen      00016800
         BAL   R14,FREE                Free the data sets               00016900
         B     RC08                    Return code 8                    00017000
DELU005  DS    0H                                                       00017100
*---------------------------------------------------------------------* 00017200
*        Open SYS1.SECURE.SHADOW with DDNAME RAKFSHAD                 * 00017300
*---------------------------------------------------------------------* 00017400
         MVI   OPEND,X'80'             First and only DCB               00017500
         OPEN  RAKFSHAD,MF=(E,OPEND)                                    00017600
         TM    SW,$913                 Access denied?                   00017700
         BNO   DELU007                 No: assumed, that open is succes 00017800
         MVC   MSG3+9(8),=CL8'RAKFSHAD'  DD-name                        00017900
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00018000
         LA    R0,L'MSG3               Length                           00018100
         BAL   R14,TPUT                Write the message on screen      00018200
         BAL   R14,CLOSE                                                00018300
         BAL   R14,FREE                Free the data sets               00018400
         B     RC08                    Return code 8                    00018500
DELU007  DS    0H                                                       00018600
*---------------------------------------------------------------------* 00018700
*        Read the USERS records and check if UserID is present        * 00018800
*        And populate the table with User records except the to       * 00018900
*        be deleted user.                                             * 00019000
*---------------------------------------------------------------------* 00019100
         XR    R5,R5                   Clear record counter             00019200
         L     R6,ADRUSER              Start of user table              00019300
DELU009  DS    0H                                                       00019400
         GET   RAKFUSER,USERREC        Read a record                    00019500
         CLC   USERUID,USERID          Match found of UserID?           00019600
         BE    DELU010                 Yes: place not in table          00019700
         MVC   0(80,R6),USERREC        Record into table                00019800
         LA    R6,80(,R6)              Next entry in table              00019900
         LA    R5,1(,R5)               Count record                     00020000
         C     R5,=F'1300'             Already 1300 records in table?   00020100
         BL    DELU009                 No: room enough                  00020200
         LA    R1,MSG7                 Msg: 'table full'                00020300
         LA    R0,L'MSG7               Length                           00020400
         BAL   R14,TPUT                Write the message on screen      00020500
         BAL   R14,CLOSE               Close RAKFUSER and RAKFSHAD      00020600
         BAL   R14,FREE                Free the data sets               00020700
         B     RC08                    Return code 8                    00020800
DELU010  OI    SW,$DELU                Mark User deleted in USERS       00020900
         B     DELU009                 Read next record                 00021000
USEREOF  DS    0H                      EOF RACFUSER                     00021100
         TM    SW,$DELU                It a user deleted from USERS?    00021200
         BZ    DELU013                 No: no sense to write table back 00021300
         L     R6,ADRUSER              Point to start of table          00021400
         MVI   CLOSED,X'80'            First and only DCB               00021500
         CLOSE RAKFUSER,MF=(E,CLOSED)                                   00021600
         MVI   OPEND,X'80'             First and only DCB               00021700
         OPEN  (RAKFUSER,(OUTPUT)),MF=(E,OPEND)                         00021800
         TM    SW,$913                 Access denied?                   00021900
         BNO   DELU012                 No: assumed, that open is succes 00022000
         MVC   MSG3+9(8),=CL8'RAKFUSER'  DD-name                        00022100
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00022200
         LA    R0,L'MSG3               Length                           00022300
         BAL   R14,TPUT                Write the message on screen      00022400
         BAL   R14,CLOSE               Close RAKFUSER and RAKFSHAD      00022500
         BAL   R14,FREE                Free the data sets               00022600
         B     RC08                    Return code 8                    00022700
DELU012  PUT   RAKFUSER,0(R6)          Write record back in USERS       00022800
         LA    R6,80(,R6)              Next user entry in table         00022900
         BCT   R5,DELU012              And write all entries back       00023000
DELU013  DS    0H                                                       00023100
         XR    R5,R5                   Re-init record counter           00023200
         L     R6,ADRUSER              Use same table for SHADOW        00023300
*---------------------------------------------------------------------* 00023400
*        Read the SHADOW record and place the user, except the to     * 00023500
*        be deleted user in the storage table.                        * 00023600
*---------------------------------------------------------------------* 00023700
DELU015  DS    0H                                                       00023800
         GET   RAKFSHAD,SHADOW         Read a shadow record             00023900
         CLC   SHDUID(8),USERID        Match found of UserID?           00024000
         BE    DELU016                 No: read next record             00024100
         MVC   0(48,R6),SHADOW         Record into table                00024200
         LA    R5,1(,R5)               Count record in table            00024300
         LA    R6,48(,R6)              Next entry in table              00024400
         B     DELU015                 Read next record                 00024500
DELU016  OI    SW,$DELS                Mark User deleted from SHADOW    00024600
         B     DELU015                 Read next record                 00024700
SHADEOF  DS    0H                      EOF RACFSHAD                     00024800
         TM    SW,$DELS                It a user deleted from SHADOW?   00024900
         BZ    DELU021                 No: no sense to write table back 00025000
         L     R6,ADRUSER              Start of user table              00025100
         MVI   CLOSED,X'80'            First and only DCB               00025200
         CLOSE RAKFSHAD,MF=(E,CLOSED)                                   00025300
         MVI   OPEND,X'80'             First and only DCB               00025400
         OPEN  (RAKFSHAD,(OUTPUT)),MF=(E,OPEND)                         00025500
         TM    SW,$913                 Access denied?                   00025600
         BNO   DELU018                 No: assumed, that open is succes 00025700
         MVC   MSG3+9(8),=CL8'RAKFSHAD'  DD-name                        00025800
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00025900
         LA    R0,L'MSG3               Length                           00026000
         BAL   R14,TPUT                Write the message on screen      00026100
         BAL   R14,CLOSE               Close RAKFUSER and RAKFSHAD      00026200
         BAL   R14,FREE                Free the data sets               00026300
         B     RC08                    Return code 8                    00026400
DELU018  PUT   RAKFSHAD,0(R6)          Write record back in SHADOW      00026500
         LA    R6,48(,R6)              Next SHADOW entry in table       00026600
         BCT   R5,DELU018              And write all entries back       00026700
*---------------------------------------------------------------------* 00026800
*        Close USERS and SHADOW and return to TMP.                    * 00026900
*---------------------------------------------------------------------* 00027000
DELU021  DS    0H                                                       00027100
         BAL   R14,CLOSE               Close the data sets              00027200
         BAL   R14,FREE                And unallocate                   00027300
         LA    R15,0                   RC = 0                           00027400
         B     RETURN                                                   00027500
*---------------------------------------------------------------------* 00027600
*        Return to TSO TMP.                                           * 00027700
*---------------------------------------------------------------------* 00027800
RC08     DS    0H                                                       00027900
         LA    R15,8                   RC = 8                           00028000
RETURN   DS    0H                                                       00028100
         LR    R4,R15                  Save return code                 00028200
         ICM   R2,15,PPL#LA            Is PPL allocated?                00028300
         BZ    RETURN1                 No: do not free                  00028400
         LM    R2,R3,PPL#LA            Address + Length PPL             00028500
         FREEMAIN RU,LV=(2),A=(3)      Free the PPL                     00028600
RETURN1  L     R2,ADRUSER              Address of user table            00028700
         FREEMAIN RU,LV=104000,A=(2)                                    00028800
         TM    SW,$DELU+$DELS          Anything deleted?                00028900
         BNZ   RETURN2                 Yes: carry on                    00029000
         LA    R1,MSG4                 Msg: 'nothing deleted'           00029100
         LA    R0,L'MSG4               Length                           00029200
         BAL   R14,TPUT                Write message on screen          00029300
         B     RETURN8                 And branch                       00029400
RETURN2  DS    0H                                                       00029500
         MVC   MSG6+14(8),USERID       UserID in message                00029600
         LA    R1,MSG6                 Msg: 'successfully deleted'      00029700
         LA    R0,L'MSG6               Length                           00029800
         BAL   R14,TPUT                Write message on screen          00029900
         LA    R1,MSGA                 Msg: 'run RAKFUSER ...'          00030000
         LA    R0,L'MSGA               Length                           00030100
         BAL   R14,TPUT                Write message on screen          00030200
RETURN8  DS    0H                                                       00030300
         ICM   R8,15,ANSWER            Pointer to PDE's (the PDL)       00030400
         BZ    RETURN9                 No: skip                         00030500
         IKJRLSA (R8)                  Release PARSE storage            00030600
RETURN9  LR    R3,R13                  Load working storage to free     00030700
         L     R13,4(,R13)             Load caller's save area          00030800
         FREEMAIN RU,LV=WORKL,A=(3)    Release working storage          00030900
         LR    R15,R4                  Restore return code              00031000
         RETURN (14,12),RC=(15)        Return                           00031100
*                                                                       00031200
         TITLE 'Invoke IKJDAIR, A(Parm block) in R1'                    00031300
*---------------------------------------------------------------------* 00031400
*        Routine:   CALLTS                                            * 00031500
*        Function:  Invoke IKJDAIR to allocate or unallocate data sets* 00031600
*                   Register 1 contains the address of the allocation * 00031700
*                   or unallocation DAIR parameter blocks.            * 00031800
*---------------------------------------------------------------------* 00031900
CALLTS   DS    0H                                                       00032000
         ST    R14,R14TS               Save register 14                 00032100
         LR    R14,R1                  Save A(IKJDAIR parm block)       00032200
         XC    ECB,ECB                 Clear ECB                        00032300
         LA    R1,DAIRDAPL                                              00032400
         L     R2,MYCPPL               Pickup our CPPL                  00032500
         USING CPPL,R2                 Base CPPL                        00032600
         USING DAPL,R1                 Base IKJDAPL                     00032700
         MVC   DAPLUPT(4),CPPLUPT                                       00032800
         MVC   DAPLECT(4),CPPLECT                                       00032900
         XC    ECB,ECB                 Clear Event control block        00033000
         LA    R0,ECB                  Address of our ECB               00033100
         ST    R0,DAPLECB              Set A(ECB) in DAPL               00033200
         MVC   DAPLPSCB(4),CPPLPSCB                                     00033300
         ST    R14,DAPLDAPB            Set A(parm block) in DAPL        00033400
         CALLTSSR EP=IKJDAIR,MF=(E,DAIRDAPL)                            00033500
         L     R14,R14TS               Restore register 14              00033600
         BR    R14                                                      00033700
         DROP  R1,R2                   Unbase DAPL and CPPL             00033800
         TITLE 'Write message on screen'                                00033900
*---------------------------------------------------------------------* 00034000
*        Write the message on the terminal with a PUTLINE.            * 00034100
*        Register 0 = the length of the message.                      * 00034200
*        Register 1 = adress of the message.                          * 00034300
*---------------------------------------------------------------------* 00034400
TPUT     DS    0H                                                       00034500
         ST    R14,R14TPUT             Save register 14                 00034600
         L     R3,MYCPPL               Pickup CPPL of this command      00034700
         USING CPPL,R3                 Base IKJCPPL                     00034800
         MVI   PUTLINE+4,C' '          Clear output line                00034900
         MVC   PUTLINE+5(79),PUTLINE+4         ,,                       00035000
         LR    R2,R0                   Length of message                00035100
         BCTR  R2,0                    Minus 1 for EX                   00035200
         EX    R2,MVEMSG               Move the message                 00035300
         LA    R2,5(,R2)               Length in including length field 00035400
         XC    PUTLINE+2(2),PUTLINE+2  Byte 2 and 3, reserved           00035500
         STCM  R2,B'0011',PUTLINE      Save length in byte 0 and 1      00035600
         L     R2,CPPLUPT              User Profile Table               00035700
         L     R3,CPPLECT              Environment Control Table        00035800
         XC    ECB,ECB                 Force PUTLINE to wait            00035900
         LA    R0,PUTLINE              Data line address                00036000
         PUTLINE PARM=PUTBLOK,,MF=(E,PUTIOPL),                         *00036100
               OUTPUT=((0),TERM,SINGLE,DATA),ECB=ECB,UPT=(2),ECT=(3),  *00036200
               TERMPUT=(EDIT,WAIT,NOHOLD,NOBREAK)                       00036300
         L     R14,R14TPUT             Restore register 14              00036400
         BR    R14                                                      00036500
MVEMSG   MVC   PUTLINE+4(0),0(R1)      << executed >>                   00036600
         DROP  R3                      Unbase CPPL                      00036700
         TITLE 'Free SYS.SECURE.CNTL and SYS1.SECURE.SHADOW'            00036800
FREE     DS    0H                                                       00036900
         ST    R14,R14FREE             Save register 14                 00037000
         LA    R3,DAIR18               Point to unallocation parm block 00037100
         XC    DAIR18,DAIR18           Clear unallocation parm block    00037200
         USING DAPB18,R3               IKJDAP18                         00037300
         MVI   DA18CD+1,X'18'          Entry code 0018 (unallocate)     00037400
         MVI   DA18MNM,C' '            Provide no ...                   00037500
         MVC   DA18MNM+1(7),DA18MNM               member name           00037600
         MVC   DA18DDN,=CL8'RAKFUSER'  DDNAME to unallocate             00037700
         LR    R1,R3                   Parameter CALLTS                 00037800
         BAL   R14,CALLTS              IKJDAIR routine                  00037900
         MVC   DA18DDN,=CL8'RAKFSHAD'  DDNAME to unallocate             00038000
         LR    R1,R3                   Parameter CALLTS                 00038100
         BAL   R14,CALLTS              IKJDAIR routine                  00038200
         L     R14,R14FREE             Restore register 14              00038300
         BR    R14                     Return                           00038400
         DROP  R3                      Unbase DAPB18                    00038500
         TITLE 'Close RAKFUSER and RAKFSHAD'                            00038600
CLOSE    ST    R14,R14CLOSE            Save register 14                 00038700
         MVI   CLOSED,X'80'            First and only DCB               00038800
         CLOSE RAKFUSER,MF=(E,CLOSED)                                   00038900
         MVI   CLOSED,X'80'            First and only DCB               00039000
         CLOSE RAKFSHAD,MF=(E,CLOSED)                                   00039100
         L     R14,R14CLOSE            Restore register 14              00039200
         BR    R14                     Return                           00039300
         TITLE 'DCB abend exit'                                         00039400
DCBABEND DS    0H                                                       00039500
         TM    3(R1),B'00001110'       Processing allowed?              00039600
         BZR   R14                     No: continue with abend          00039700
         TM    3(R1),4                 Ignore bit on?                   00039800
         MVI   3(R1),0                 Prepare for NO                   00039900
         BZR   R14                                                      00040000
         MVC   DCBCOMP,0(R1)           Move completion code             00040100
         NC    DCBCOMP,=X'FFF0'        Clear last nibble                00040200
         CLC   DCBCOMP,=X'9130'        Do we have an RACF/ACF2 abend?   00040300
         BNER  R14                     No: continue with abend          00040400
         MVI   3(R1),4                 Yes: ignore abend                00040500
         OI    SW,$913                 Indicate 913 abend               00040600
         BR    R14                     Return to Access Method          00040700
PCLSTART DS    0H                                                       00040800
ADDPCL   IKJPARM DSECT=ADDPRS          PDE's                            00040900
