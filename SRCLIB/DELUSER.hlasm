MDLSHAD  DCB   DSORG=PS,LRECL=48,DDNAME=RAKFSHAD,EODAD=SHADEOF,        *00041500
               MACRF=(GM,PM)                                            00041600
MDLSLEN  EQU   *-MDLSHAD                                                00041700
MDLUSER  DCB   DSORG=PS,LRECL=80,DDNAME=RAKFUSER,EODAD=USEREOF,        *00041800
               MACRF=(GM,PM)                                            00041900
MDLULEN  EQU   *-MDLUSER                                                00042000
