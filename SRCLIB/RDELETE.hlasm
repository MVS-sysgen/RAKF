RDELETE  TITLE 'Permit access to a certain resource'                    00000100
*---------------------------------------------------------------------* 00000200
*                                                                     * 00000300
*        Module:       RDELETE                                        * 00000400
*        Alias:        RDEL                                           * 00000500
*                                                                     * 00000600
*        Author:       Rob Prins                                      * 00000700
*                                                                     * 00000800
*        Attributes:   RENT, REUS.                                    * 00000900
*                                                                     * 00001000
*        Function:     Parse the syntax of the RDELETE command.       * 00001100
*                      Allocate SYS1.SECURE.CNTL(PROFILES)            * 00001200
*                      dynamically with IKJDAIR.                      * 00001300
*                      GETMAIN room for 1500 profiles.                * 00001400
*                      Read the PROFILES member into the table and    * 00001500
*                      skip the comments records.                     * 00001600
*                      Delete the specified profiles from the         * 00001700
*                      PROFILES table.                                * 00001800
*                                                                     * 00001900
*                      If there are profiles/resources deleted:       * 00002000
*                      Write the PROFILES table back.                 * 00002100
*                                                                     * 00002200
*                      Free the SYS1.SECURE.CNTL data set.            * 00002300
*                                                                     * 00002400
*        Syntax:       RDELETE profile ID(group) CLASS(class)         * 00002500
*                                                                     * 00002600
*                      Required: profile                              * 00002700
*                                ID(group)                            * 00002800
*                                CLASS(class)                         * 00002900
*                                                                     * 00003000
*        Note:         If ID(ALL) is specified, all occurences        * 00003100
*                      of the 'profile' are deleted including the     * 00003200
*                      universal access record.                       * 00003300
*                                                                     * 00003400
*        Return codes: 00 - all good.                                 * 00003500
*                      08 - an error occurred, user is notified       * 00003600
*                           with a message                            * 00003700
*                                                                     * 00003800
*---------------------------------------------------------------------* 00003900
RDELETE  CSECT                                                          00004000
         SAVE  (14,12),,*                                               00004100
         LR    R12,R15                                                  00004200
         USING RDELETE,R12             Base register                    00004300
         LR    R2,R1                   Save parm (CPPL)                 00004400
         GETMAIN RU,LV=WORKL           Obtain savearea + working strg.  00004500
         ST    R1,8(,R13)              Forward pointer                  00004600
         ST    R13,4(,R1)              Backward pointer                 00004700
         LR    R13,R1                  This is our save area            00004800
         USING WORKAREA,R13            Base working storage             00004900
         ST    R2,MYCPPL               Save our CPPL address            00005000
         MVC   RAKFPROF,MDLPROF        Move model DCB to working strg   00005100
         XC    DAIR08,DAIR08           Clear IKJDAIR                    00005200
         XC    DAIR18,DAIR18                        ... blocks          00005300
         XC    ANSWER,ANSWER           Clear IKJPARS answer             00005400
         XC    PPL#LA,PPL#LA           Clear PPL pointers               00005500
         MVC   MSG3,MSG3X              Move message to working storage  00005600
         MVC   MSG8,MSG8X              Move message to working storage  00005700
         MVC   MSG9,MSG9X              Move message to working storage  00005800
         MVI   PROFREC-1,C' '          To blank Profile record          00005900
         MVI   SW,0                    Clear flags                      00006000
         LA    R0,DCBABEND             DCB abend exit                   00006100
         ST    R0,EXLST                Save JFCB in exit list           00006200
         MVI   EXLST,X'91'             DCB abend exit is last entry     00006300
         LA    R0,EXLST                Exit list (DCB abend exit)       00006400
         STCM  R0,B'0111',RAKFPROF+DCBEXLSA-IHADCB                      00006500
         GETMAIN RU,LV=120000      GETMAIN room for 1500 profiles       00006600
         ST    R1,ADRPROF              Save its address                 00006700
         USING PSA,R0                  Point to CVT                     00006800
         L     R2,PSAANEW              Load ASCB                        00006900
         L     R2,ASCBASXB-ASCB(R2)    Load ASXB                        00007000
         ICM   R2,15,ASXBSENV-ASXB(R2) Point to ACEE                    00007100
         BNZ   CONT1                   Yes: found                       00007200
         LA    R1,MSGY                 Msg: 'No ACEE found'             00007300
         LA    R0,L'MSGY               Length                           00007400
         BAL   R14,TPUT                Write the message on screen      00007500
         B     RC08                    End with RC=-08                  00007600
CONT1    TM    ACEEFLG1-ACEE(R2),ACEESPEC Do we have the SPECIAL attr   00007700
         BO    CONT2                                                    00007800
         LA    R1,MSGZ                 Msg: 'No SPECIAL attribute'      00007900
         LA    R0,L'MSGZ               Length                           00008000
         BAL   R14,TPUT                Write the message on screen      00008100
         B     RC08                    End with RC=-08                  00008200
CONT2    DS    0H                                                       00008300
*---------------------------------------------------------------------* 00008400
*        Parse parameters                                             * 00008500
*---------------------------------------------------------------------* 00008600
         GETMAIN RU,LV=PPL#L           Obtain a dynamic PPL workarea    00008700
         STM   R0,R1,PPL#LA            Save length and address of PPL   00008800
         L     R2,PPL#PTR              Get the address of the PPL       00008900
         USING PPL,R2                  Adress it                        00009000
         L     R1,MYCPPL               Get address of CPPL              00009100
         USING CPPL,R1                 Base the CPPL                    00009200
*---------------------------------------------------------------------* 00009300
*                                                                       00009400
*        Populate the Parse Parameter List (PPL) from the CPPL,         00009500
*        add the IKJPARMD list in the PPL and invoke IKJPARS            00009600
*                                                                       00009700
*---------------------------------------------------------------------* 00009800
*                                                                       00009900
         MVC   PPLUPT,CPPLUPT          Put in the UPT address from CPPL 00010000
         MVC   PPLECT,CPPLECT          Put in the ECT address from CPPL 00010100
         MVC   PPLCBUF,CPPLCBUF        Put in the command buffer addr.  00010200
*                                      From the CPPL                    00010300
         XC    ECB,ECB                 Clear Event control block        00010400
         L     R1,=A(ADDPCL)           Address of PCL                   00010500
         ST    R1,PPLPCL               Set in PPL                       00010600
         LA    R1,ANSWER               Answer area                      00010700
         ST    R1,PPLANS               Pointer into PPL                 00010800
         LA    R1,ECB                  Event control block              00010900
         ST    R1,PPLECB               Pointer into PPL                 00011000
         ST    R13,PPLUWA              User provide workarea            00011100
         CALLTSSR EP=IKJPARS,MF=(E,PPL)   Invoke parse                  00011200
         DROP  R1,R2                   Unbase CPPL and PPL              00011300
         LTR   R15,R15                 Parse successfully processed?    00011400
         BZ    PARSEOK                 Yes: carry                       00011500
         LA    R0,L'MSG5               Length                           00011600
         LA    R1,MSG5                 Msg: Parse error                 00011700
         BAL   R14,TPUT                                                 00011800
         XC    ANSWER,ANSWER           Avoid IKJRLSA                    00011900
         B     RC08                    Return to TMP                    00012000
PARSEOK  DS    0H                                                       00012100
         L     R8,ANSWER               Pointer to PDL                   00012200
         USING ADDPRS,R8               mapped with IKJPARM              00012300
         MVI   PROFILE,C' '                                             00012400
         MVC   PROFILE+1(L'PROFILE-1),PROFILE initialize profile        00012500
         LA    R3,PROFPDE              Profile PDE                      00012600
         USING PROFRET,R3              Base this PDE                    00012700
         L     R1,PROFPTR              Pointer to Profile name          00012800
         LH    R2,PROFL                Length                           00012900
         BCTR  R2,0                    -1 for EX                        00013000
         EX    R2,MVEPROF              Move Profile                     00013100
         B     ENDPROF                 Branch over EX                   00013200
MVEPROF  MVC   PROFILE(0),0(R1)        << Executed >>                   00013300
ENDPROF  DS    0H                                                       00013400
         DROP  R3                      Unbase PROFRET                   00013500
         LA    R3,CLASSPDE             Point to resource class PDE      00013600
         USING CLASRET,R3              Base this PDE                    00013700
         TM    CLASFLG,$CPRES          Is CLASS present?                00013800
         BNZ   CLAS001                 Yes: good                        00013900
         LA    R1,MSG2                 Msg: CLASS is required           00014000
         LA    R0,L'MSG2               Length                           00014100
         BAL   R14,TPUT                Write the message                00014200
         B     RC08                    End with return code = 8         00014300
CLAS001  DS    0H                                                       00014400
         MVC   CLASS,=CL8' '           Blank CLASS name                 00014500
         LH    R2,CLASL                Length of Class name             00014600
         L     R1,CLASPTR              Class name                       00014700
         BCTR  R2,0                    Minus 1 for EX                   00014800
         EX    R2,MVECLAS              Move Class name                  00014900
         B     ENDCLAS                 Branch over EX                   00015000
MVECLAS  MVC   CLASS(0),0(R1)          << Executed >>                   00015100
ENDCLAS  DS    0H                                                       00015200
         MVC   GROUP,=CL8' '           Blank GROUP name of ID           00015300
         DROP  R3                      Unbase CLASRET                   00015400
         LA    R3,IDPDE                Point to ID(group) PDE           00015500
         USING IDRET,R3                Base this PDE                    00015600
         TM    IDFLG,$IPRES            Is ID present?                   00015700
         BNZ   ID001                   Yes: process group in ID         00015800
         OI    SW,$ALL                 Delete all occurences            00015900
         B     ENDPARS                 If not specified: delete all     00016000
ID001    LH    R2,IDL                  Length of Class name             00016100
         L     R1,IDPTR                Group name of ID                 00016200
         BCTR  R2,0                    Minus 1 formEX                   00016300
         EX    R2,MVEID                Move group name                  00016400
         B     ENDPARS                 Branch over EX                   00016500
MVEID    MVC   GROUP(0),0(R1)          << Executed >>                   00016600
ENDPARS  DS    0H                                                       00016700
         DROP  R3                      Unbase CLASRET                   00016800
*---------------------------------------------------------------------* 00016900
*        Allocate SYS1.SECURE.CNTL(PROFILES)                          * 00017000
*---------------------------------------------------------------------* 00017100
         LA    R3,DAIR08               Allocation request block         00017200
         USING DAPB08,R3               Base DAPB08                      00017300
         MVI   DA08CD+1,X'08'          Entry code 08 (allocation)       00017400
         MVC   DA08DDN,=CL8'RAKFPROF'  DDNAME to allocate               00017500
         MVC   DA08PDSN,=A(PROFDSNL)   Temporary data set name          00017600
         MVI   DA08DSP1,DA08OLD        DISP=OLD                         00017700
         MVC   DA08MNM,=CL8'PROFILES'  Fixed member name                00017800
         MVI   DA08UNIT,C' '           Clear unit name                  00017900
         MVC   DA08UNIT+1(L'DA08UNIT-1),DA08UNIT                        00018000
         MVI   DA08SER,C' '            Clear volume serial              00018100
         MVC   DA08SER+1(L'DA08SER-1),DA08UNIT                          00018200
         LR    R1,R3                   Parameter CALLTS                 00018300
         BAL   R14,CALLTS              IKJDAIR routine                  00018400
         LTR   R15,R15                 Allocation OK?                   00018500
         BZ    RDEL001                 Yes: carry on                    00018600
         LA    R1,MSG1                 Msg: 'allocation error PROF'     00018700
         LA    R0,L'MSG1               Length                           00018800
         BAL   R14,TPUT                Write the message on screen      00018900
         B     RC08                    Return code 8                    00019000
RDEL001  DS    0H                                                       00019100
*---------------------------------------------------------------------* 00019200
*        Open SYS1.SECURE.CNTL(PROFILES) with DDNAME RAKPROF          * 00019300
*---------------------------------------------------------------------* 00019400
         MVI   OPEND,X'80'             First and only DCB               00019500
         OPEN  RAKFPROF,MF=(E,OPEND)                                    00019600
         TM    SW,$913                 Access denied?                   00019700
         BNO   RDEL005                 No: assumed, that open is succes 00019800
         MVC   MSG3+8(8),=CL8'RAKFPROF'  DD-name                        00019900
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00020000
         LA    R0,L'MSG3               Length                           00020100
         BAL   R14,TPUT                Write the message on screen      00020200
         BAL   R14,FREE                Free the data sets               00020300
         B     RC08                    Return code 8                    00020400
RDEL005  DS    0H                                                       00020500
*---------------------------------------------------------------------* 00020600
*        Read the PROFILES records and check if the profile is        * 00020700
*        already added.                                               * 00020800
*        And populate the table with Profile records.                 * 00020900
*---------------------------------------------------------------------* 00021000
         XR    R5,R5                   Clear record counter             00021100
         L     R6,ADRPROF              Start of Profile table           00021200
READPROF DS    0H                                                       00021300
         GET   RAKFPROF,PROFREC        Read a record                    00021400
         CLI   PROFREC,C'*'            Comment record?                  00021500
         BE    READPROF                Yes: skip                        00021600
*                                      with the group (ID)              00021700
*---------------------------------------------------------------------* 00021800
*        Compare Class + Profile + Group                              * 00021900
*        If GROUP is blank, the universal access record will be       * 00022000
*        deleted too.                                                 * 00022100
*---------------------------------------------------------------------* 00022200
         LA    R1,59                   Test CLASS+PROFILE+GROUP         00022300
         TM    SW,$ALL                 Delete all occurrences of prof?  00022400
         BNO   *+8                     No: good                         00022500
         LA    R1,51                   Test CLASS+PROFILE only          00022600
         EX    R1,CMPREC               Compare                          00022700
         BNE   RDEL010                 No: test next record             00022800
         OI    SW,$DEL                 Mark entry deleted               00022900
         B     READPROF                Read next record                 00023000
CMPREC   CLC   PROFREC(0),PROFCMP      << executed >>                   00023100
RDEL010  LA    R5,1(,R5)               Count record                     00023200
         C     R5,=F'1495'             Already 1495 records in table?   00023300
         BL    RDEL013                 No: room enough                  00023400
         LA    R1,MSG7                 Msg: 'table full'                00023500
         LA    R0,L'MSG7               Length                           00023600
         BAL   R14,TPUT                Write the message on screen      00023700
         BAL   R14,CLOSE               Close RAKFPROF                   00023800
         BAL   R14,FREE                Free the data sets               00023900
         B     RC08                    Return code 8                    00024000
RDEL013  DS    0H                                                       00024100
         MVC   0(80,R6),PROFREC        Record into table                00024200
         LA    R6,80(,R6)              Next entry in table              00024300
         B     READPROF                Read next record                 00024400
PROFEOF  DS    0H                      EOF RACFPROF                     00024500
         TM    SW,$DEL                 Are there records deleted?       00024600
         BNO   RDEL019                 No: no need to write back        00024700
         MVI   CLOSED,X'80'            First and only DCB               00024800
         CLOSE RAKFPROF,MF=(E,CLOSED)                                   00024900
         MVI   OPEND,X'80'             First and only DCB               00025000
         OPEN  (RAKFPROF,(OUTPUT)),MF=(E,OPEND)                         00025100
         TM    SW,$913                 Access denied?                   00025200
         BNO   RDEL015                 No: assumed, that open is succes 00025300
         MVC   MSG3+8(8),=CL8'RAKFPROF'  DD-name                        00025400
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00025500
         LA    R0,L'MSG3               Length                           00025600
         BAL   R14,TPUT                Write the message on screen      00025700
         BAL   R14,CLOSE               Close the DCBs                   00025800
         BAL   R14,FREE                Free the data sets               00025900
         B     RC08                    Return code 8                    00026000
RDEL015  L     R6,ADRPROF              Max 1500 profile entries         00026100
*---------------------------------------------------------------------* 00026200
*        Write the RAKF Profiles back in the PROFILES member.         * 00026300
*---------------------------------------------------------------------* 00026400
RDEL017  DS    0H                                                       00026500
         PUT   RAKFPROF,0(R6)          Write ...                        00026600
         LA    R6,80(,R6)                    Profile ...                00026700
         BCT   R5,RDEL017                         table back            00026800
         B     RDEL021                 Success message to terminal      00026900
*---------------------------------------------------------------------* 00027000
*        All records written. Give success message                    * 00027100
*---------------------------------------------------------------------* 00027200
RDEL019  LA    R1,MSGA                 Msg: Profiles not found          00027300
         LA    R0,L'MSGA               Length                           00027400
         BAL   R14,TPUT                Write the message on screen      00027500
         BAL   R14,CLOSE               Close the data sets              00027600
         BAL   R14,FREE                And unallocate                   00027700
         B     RC08                    Return code 8                    00027800
RDEL021  TM    SW,$ALL                 All occurrences deleted?         00027900
         BO    RDEL023                 Yes: good                        00028000
         MVC   MSG9PROF,PROFILE        Profile in success message       00028100
         MVC   MSG9CLS,CLASS           Class in success message         00028200
         MVC   MSG9GRP,GROUP           Access in success message        00028300
         LA    R1,MSG9                 Success messages                 00028400
         LA    R0,L'MSG9               Length                           00028500
         B     RDEL025                 Write the message on screen      00028600
RDEL023  MVC   MSG8PROF,PROFILE                                         00028700
         LA    R1,MSG8                 Msg: all occurrences delete      00028800
         LA    R0,L'MSG8               Length                           00028900
RDEL025  BAL   R14,TPUT                Write the message on screen      00029000
         LA    R1,MSGB                 Msg: Run RAKFPROF ...            00029100
         LA    R0,L'MSGB               Length                           00029200
         BAL   R14,TPUT                Write the message on screen      00029300
         BAL   R14,CLOSE               Close the data sets              00029400
         BAL   R14,FREE                And unallocate                   00029500
         LA    R15,0                   RC = 0                           00029600
         B     RETURN                                                   00029700
*---------------------------------------------------------------------* 00029800
*        Return to TSO TMP.                                           * 00029900
*---------------------------------------------------------------------* 00030000
RC08     DS    0H                                                       00030100
         LA    R15,8                   RC = 8                           00030200
RETURN   DS    0H                                                       00030300
         LR    R4,R15                  Save return code                 00030400
         ICM   R2,15,PPL#LA            Is the PPL allocated?            00030500
         BZ    RETURN1                 No: don't free                   00030600
         LM    R2,R3,PPL#LA            Load length and address of PPL   00030700
         FREEMAIN RU,LV=(2),A=(3)      Free the PPL                     00030800
RETURN1  ICM   R8,15,ANSWER            Pointer to PDE's (the PDL)       00030900
         BZ    RETURN2                 No: skip                         00031000
         IKJRLSA (R8)                  Release PARSE storage            00031100
RETURN2  L     R2,ADRPROF              Address of Profile table         00031200
         FREEMAIN RU,LV=120000,A=(2)                                    00031300
         LR    R3,R13                  Load working storage to free     00031400
         L     R13,4(,R13)             Load caller's save area          00031500
         FREEMAIN RU,LV=WORKL,A=(3)    Release working storage          00031600
         LR    R15,R4                  Restore return code              00031700
         RETURN (14,12),RC=(15)        Return                           00031800
*                                                                       00031900
         TITLE 'Invoke IKJDAIR, A(Parm block) in R1'                    00032000
*---------------------------------------------------------------------* 00032100
*        Routine:   CALLTS                                            * 00032200
*        Function:  Invoke IKJDAIR to allocate or unallocate data sets* 00032300
*                   Register 1 contains the address of the allocation * 00032400
*                   or unallocation DAIR parameter blocks.            * 00032500
*---------------------------------------------------------------------* 00032600
CALLTS   DS    0H                                                       00032700
         ST    R14,R14TS               Save register 14                 00032800
         LR    R14,R1                  Save A(IKJDAIR parm block)       00032900
         XC    ECB,ECB                 Clear ECB                        00033000
         LA    R1,DAIRDAPL                                              00033100
         L     R2,MYCPPL               Pickup our CPPL                  00033200
         USING CPPL,R2                 Base CPPL                        00033300
         USING DAPL,R1                 Base IKJDAPL                     00033400
         MVC   DAPLUPT(4),CPPLUPT                                       00033500
         MVC   DAPLECT(4),CPPLECT                                       00033600
         XC    ECB,ECB                 Clear Event control block        00033700
         LA    R0,ECB                  Address of our ECB               00033800
         ST    R0,DAPLECB              Set A(ECB) in DAPL               00033900
         MVC   DAPLPSCB(4),CPPLPSCB                                     00034000
         ST    R14,DAPLDAPB            Set A(parm block) in DAPL        00034100
         CALLTSSR EP=IKJDAIR,MF=(E,DAIRDAPL)                            00034200
         L     R14,R14TS               Restore register 14              00034300
         BR    R14                                                      00034400
         DROP  R1,R2                   Unbase DAPL and CPPL             00034500
         TITLE 'Write message on screen'                                00034600
*---------------------------------------------------------------------* 00034700
*        Write the message on the terminal with a PUTLINE.            * 00034800
*        Register 0 = the length of the message.                      * 00034900
*        Register 1 = adress of the message.                          * 00035000
*---------------------------------------------------------------------* 00035100
TPUT     DS    0H                                                       00035200
         ST    R14,R14TPUT             Save register 14                 00035300
         L     R3,MYCPPL               Pickup CPPL of this command      00035400
         USING CPPL,R3                 Base IKJCPPL                     00035500
         MVI   PUTLINE+4,C' '          Clear output line                00035600
         MVC   PUTLINE+5(95),PUTLINE+4         ,,                       00035700
         LR    R2,R0                   Length of message                00035800
         BCTR  R2,0                    Minus 1 for EX                   00035900
         EX    R2,MVEMSG               Move the message                 00036000
         LA    R2,5(,R2)               Length in including length field 00036100
         XC    PUTLINE+2(2),PUTLINE+2  Byte 2 and 3, reserved           00036200
         STCM  R2,B'0011',PUTLINE      Save length in byte 0 and 1      00036300
         L     R2,CPPLUPT              User Profile Table               00036400
         L     R3,CPPLECT              Environment Control Table        00036500
         XC    ECB,ECB                 Force PUTLINE to wait            00036600
         LA    R0,PUTLINE              Data line address                00036700
         PUTLINE PARM=PUTBLOK,,MF=(E,PUTIOPL),                         *00036800
               OUTPUT=((0),TERM,SINGLE,DATA),ECB=ECB,UPT=(2),ECT=(3),  *00036900
               TERMPUT=(EDIT,WAIT,NOHOLD,NOBREAK)                       00037000
         L     R14,R14TPUT             Restore register 14              00037100
         BR    R14                                                      00037200
MVEMSG   MVC   PUTLINE+4(0),0(R1)      << executed >>                   00037300
         DROP  R3                      Unbase CPPL                      00037400
         TITLE 'Free SYS1.SECURE.CNTL'                                  00037500
FREE     DS    0H                                                       00037600
         ST    R14,R14FREE             Save register 14                 00037700
         LA    R3,DAIR18               Point to unallocation parm block 00037800
         XC    DAIR18,DAIR18           Clear unallocation parm block    00037900
         USING DAPB18,R3               IKJDAP18                         00038000
         MVI   DA18CD+1,X'18'          Entry code 0018 (unallocate)     00038100
         MVI   DA18MNM,C' '            Provide no ...                   00038200
         MVC   DA18MNM+1(7),DA18MNM               member name           00038300
         MVC   DA18DDN,=CL8'RAKFPROF'  DDNAME to unallocate             00038400
         LR    R1,R3                   Parameter CALLTS                 00038500
         BAL   R14,CALLTS              IKJDAIR routine                  00038600
         L     R14,R14FREE             Restore register 14              00038700
         BR    R14                     Return                           00038800
         DROP  R3                      Unbase DAPB18                    00038900
         TITLE 'Close RAKFPROF'                                         00039000
CLOSE    ST    R14,R14CLOSE            Save register 14                 00039100
         MVI   CLOSED,X'80'            First and only DCB               00039200
         CLOSE RAKFPROF,MF=(E,CLOSED)                                   00039300
         L     R14,R14CLOSE            Restore register 14              00039400
         BR    R14                     Return                           00039500
         TITLE 'DCB abend exit'                                         00039600
DCBABEND DS    0H                                                       00039700
         TM    3(R1),B'00001110'       Processing allowed?              00039800
         BZR   R14                     No: continue with abend          00039900
         TM    3(R1),4                 Ignore bit on?                   00040000
         MVI   3(R1),0                 Prepare for NO                   00040100
         BZR   R14                                                      00040200
         MVC   DCBCOMP,0(R1)           Move completion code             00040300
         NC    DCBCOMP,=X'FFF0'        Clear last nibble                00040400
         CLC   DCBCOMP,=X'9130'        Do we have an RACF/ACF2 abend?   00040500
         BNER  R14                     No: continue with abend          00040600
         MVI   3(R1),4                 Yes: ignore abend                00040700
         OI    SW,$913                 Indicate 913 abend               00040800
         BR    R14                     Return to Access Method          00040900
PCLSTART DS    0H                                                       00041000
ADDPCL   IKJPARM DSECT=ADDPRS          PDE's                            00041100
PROFPDE  IKJPOSIT DSTHING,PROMPT='RAKF Profile name',                  *00041200
               HELP=('a valid profile to delete e.g. SYS1.*')           00041300
IDKW     IKJKEYWD                                                       00041400
         IKJNAME 'ID',SUBFLD=IDSF                                       00041500
CLASSKW  IKJKEYWD                                                       00041600
         IKJNAME 'CLASS',SUBFLD=CLASSF                                  00041700
IDSF     IKJSUBF                                                        00041800
IDPDE    IKJIDENT 'ID',                                                *00041900
               FIRST=ALPHA,OTHER=ALPHANUM,MAXLNTH=8,                   *00042000
               PROMPT='name of GROUP of max. 8 characters'              00042100
CLASSF   IKJSUBF                                                        00042200
CLASSPDE IKJIDENT 'Class',                                             *00042300
