LISTUSER TITLE 'Display RAKF users and connected groups'                00000100
*---------------------------------------------------------------------* 00000200
*                                                                     * 00000300
*        Module:       LISTUSER                                       * 00000400
*        Alias:        LU                                             * 00000500
*                                                                     * 00000600
*        Author:       Rob Prins                                      * 00000700
*                                                                     * 00000800
*        Attributes:   RENT, REUS, AC=1.                              * 00000900
*                                                                     * 00001000
*        Function:     Obtain the RAKF RCVT, point to the users       * 00001100
*                      table and list the specified user              * 00001200
*                      on the TSO terminal.                           * 00001300
*                      The RAKF users table is in fetch protected     * 00001400
*                      storage. So, a MODESET is used.                * 00001500
*                                                                     * 00001600
*        Syntax:       LISTUSER userid                                * 00001700
*                      'userid' can be the first part.                * 00001800
*                      E.g.: LU HERC list all UserIds starting with   * 00001900
*                      HERC.                                          * 00002000
*                                                                     * 00002100
*        Return codes: 00 - all good.                                 * 00002200
*                      08 - an error occurred, user is notified       * 00002300
*                           with a message                            * 00002400
*                                                                     * 00002500
*---------------------------------------------------------------------* 00002600
LISTUSER CSECT                                                          00002700
         SAVE  (14,12)                                                  00002800
         LR    R12,R15                                                  00002900
         USING LISTUSER,R12            Base register                    00003000
         LR    R2,R1                   Save parm (CPPL)                 00003100
         GETMAIN RU,LV=WORKL           Obtain savearea + working strg.  00003200
         ST    R1,8(,R13)              Forward pointer                  00003300
         ST    R13,4(,R1)              Backward pointer                 00003400
         LR    R13,R1                  This is our save area            00003500
         USING WORKAREA,R13            Base working storage             00003600
         ST    R2,MYCPPL               Save our CPPL address            00003700
         XC    ANSWER,ANSWER           Clear IKJPARS answer             00003800
         XC    PPL#LA,PPL#LA           Clear pointer to PPL             00003900
         MVC   MSG4,MSG4X              Move message to working storage  00004000
         MVI   SW,0                    Clear flags                      00004100
         USING PSA,R0                  Point to CVT                     00004200
         L     R2,PSAANEW              Load ASCB                        00004300
         L     R2,ASCBASXB-ASCB(R2)    Load ASXB                        00004400
         ICM   R2,15,ASXBSENV-ASXB(R2) Point to ACEE                    00004500
         BNZ   CONT1                   Yes: found                       00004600
         LA    R1,MSGY                 Msg: 'No ACEE found'             00004700
         LA    R0,L'MSGY               Length                           00004800
         BAL   R14,TPUT                Write the message on screen      00004900
         B     RC08                    End with RC=-08                  00005000
CONT1    TM    ACEEFLG1-ACEE(R2),ACEESPEC Do we have the SPECIAL attr   00005100
         BO    CONT2                                                    00005200
         LA    R1,MSGZ                 Msg: 'No SPECIAL attribute'      00005300
         LA    R0,L'MSGZ               Length                           00005400
         BAL   R14,TPUT                Write the message on screen      00005500
         B     RC08                    End with RC=-08                  00005600
CONT2    DS    0H                                                       00005700
*---------------------------------------------------------------------* 00005800
*        Parse parameters                                             * 00005900
*---------------------------------------------------------------------* 00006000
         GETMAIN RU,LV=PPL#L           Obtain a dynamic PPL workarea    00006100
         STM   R0,R1,PPL#LA            Save length and address of PPL   00006200
         L     R2,PPL#PTR              Get the address of the PPL       00006300
         USING PPL,R2                  Adress it                        00006400
         L     R1,MYCPPL               Get address of CPPL              00006500
         USING CPPL,R1                 Address it                       00006600
*---------------------------------------------------------------------* 00006700
*                                                                       00006800
*        Populate the Parse Parameter List (PPL) from the CPPL,         00006900
*        add the IKJPARMD list in the PPL and invoke IKJPARS            00007000
*                                                                       00007100
*---------------------------------------------------------------------* 00007200
*                                                                       00007300
         MVC   PPLUPT,CPPLUPT          Put in the UPT address from CPPL 00007400
         MVC   PPLECT,CPPLECT          Put in the ECT address from CPPL 00007500
         MVC   PPLCBUF,CPPLCBUF        Put in the command buffer addr.  00007600
*                                      From the CPPL                    00007700
         XC    ECB,ECB                 Clear Event control block        00007800
         L     R1,=A(ADDPCL)           Address of PCL                   00007900
         ST    R1,PPLPCL               Set in PPL                       00008000
         LA    R1,ANSWER               Answer area                      00008100
         ST    R1,PPLANS               Pointer into PPL                 00008200
         LA    R1,ECB                  Event control block              00008300
         ST    R1,PPLECB               Pointer into PPL                 00008400
         ST    R13,PPLUWA              User provide workarea            00008500
         CALLTSSR EP=IKJPARS,MF=(E,PPL)   Invoke parse                  00008600
         DROP  R1,R2                   CPPL and PPL                     00008700
         LTR   R15,R15                 Parse successfully processed?    00008800
         BZ    PARSEOK                 Yes: carry                       00008900
         LA    R0,L'MSG5               Length                           00009000
         LA    R1,MSG5                 Message                          00009100
         BAL   R14,TPUT                                                 00009200
         XC    ANSWER,ANSWER           Avoid IKJRLSA                    00009300
         B     RC08                    Return to TMP                    00009400
PARSEOK  DS    0H                                                       00009500
         L     R8,ANSWER               Pointer to PDL                   00009600
         USING ADDPRS,R8               mapped with IKJPARM              00009700
         MVC   USERID,=CL8' '          Initialize UserID                00009800
         LA    R3,UIDPDE               UserID PDE                       00009900
         USING UIDRET,R3               Base this PDE                    00010000
         L     R1,UIDPTR               Pointer to UserID                00010100
         LH    R2,UIDL                 Length                           00010200
         STH   R2,USERIDL              Save for later use               00010300
         BCTR  R2,0                    -1 for EX                        00010400
         EX    R2,MVEUID               Move UserID                      00010500
         B     ENDPARS                 Branch over EX                   00010600
MVEUID   MVC   USERID(0),0(R1)         << Executed >>                   00010700
         DROP  R3                      Unbase UIDRET                    00010800
ENDPARS  DS    0H                                                       00010900
         L     R4,CVTPTR               Load CVT                         00011000
         ICM   R4,B'1111',CVTRAC-CVTMAP(R4) Check RCVT                  00011100
         BNZ   LISTU001                Yes: RAKF is active              00011200
         LA    R1,MSG1                 No: RAKF is not active           00011300
         LA    R0,L'MSG1               Length                           00011400
         BAL   R14,TPUT                Inform user                      00011500
         B     RC08                    Return to TMP                    00011600
LISTU001 DS    0H                                                       00011700
*---------------------------------------------------------------------* 00011800
*        CJYRCVT contains 2 pointers. 1 = address of users table      * 00011900
*                                     2 = address of profiles table   * 00012000
*---------------------------------------------------------------------* 00012100
         ICM   R4,B'1111',RCVTISTL-RCVT(R4) CJYRCVTD present?           00012200
         BZ    LISTU003                No: error                        00012300
         ICM   R4,B'1111',CJYUSERS-CJYRCVTD(R4) Point to user table     00012400
         BNZ   LISTU005                Yes: found                       00012500
LISTU003 DS    0H                                                       00012600
         LA    R1,MSG2                 Msg: Users table is not present  00012700
         LA    R0,L'MSG2               Length                           00012800
         BAL   R14,TPUT                Inform user                      00012900
         B     RC08                    Return to TMP                    00013000
LISTU005 DS    0H                                                       00013100
         USING CBLK,R4                 Base CJYUCBLK                    00013200
         MODESET KEY=ZERO,MODE=SUP     Users table is in protected core 00013300
LISTU007 DS    0H                      Does user match?                 00013400
         LH    R1,USERIDL              Length of (partial) UserId       00013500
         BCTR  R1,0                    Minus 1                          00013600
         EX    R1,LISTUCMP             Does user match?                 00013700
         BE    LISTU009                Yes: display                     00013800
         ICM   R4,B'1111',CBLKNEXT     Next entry                       00013900
         BNZ   LISTU007                Test again                       00014000
         TM    SW,$LISTED              Already an entry listed?         00014100
         BO    READY                   Do not issue MSG4                00014200
         MVC   MSG4+17(8),USERID       UserId in message                00014300
         LA    R1,MSG4                 Msg: UserID=xxxxxx not defined   00014400
         LA    R0,L'MSG4               Length                           00014500
         BAL   R14,TPUT                Inform user                      00014600
         BAL   R14,PROB                Back to problem state            00014700
         B     RC08                    Return                           00014800
LISTUCMP CLC   CBLKUSRI(0),USERID      << executed >>                   00014900
LISTU009 MVI   MSG3,C' '               Blank message                    00015000
         MVC   MSG3+1(L'MSG3-1),MSG3                                    00015100
         MVC   MSG3(10),=C'LISTUSER: '                                  00015200
         MVC   MSG3+10(7),=C'UserID='                                   00015300
         MVC   MSG3+17(8),CBLKUSRI     UserId from users table          00015400
         OI    SW,$LISTED              At least 1 UserId listed         00015500
         LA    R15,0                   RC = 0                           00015600
         LA    R1,MSG3                                                  00015700
         LA    R0,L'MSG3               Length                           00015800
         BAL   R14,TPUT                Inform user                      00015900
         MVI   MSG3,C' '               Blank message                    00016000
         MVC   MSG3+1(L'MSG3-1),MSG3                                    00016100
         MVC   MSG3+10(10),=C'Authority=' 2nd line                      00016200
         MVC   MSG3+20(13),=C'NOOPERATIONS,'                            00016300
         MVC   MSG3+33(09),=C'NOSPECIAL'                                00016400
         CLI   CBLKFLG1,C'Y'           Operations?                      00016500
         BNE   *+10                    No: nooperations                 00016600
         MVC   MSG3+20(2),=CL2' '      Blank 'NO'                       00016700
         CLI   CBLKSPEC,C'Y'           Special?                         00016800
         BNE   *+10                    No: nospecial                    00016900
         MVC   MSG3+33(2),=CL2' '      Blank 'NO'                       00017000
         LA    R1,MSG3                                                  00017100
         LA    R0,L'MSG3               Length                           00017200
         BAL   R14,TPUT                Inform user                      00017300
         MVI   MSG3,C' '               Blank message                    00017400
         MVC   MSG3+1(L'MSG3-1),MSG3                                    00017500
         MVC   MSG3+10(17),=C'Connected GROUPS:'                        00017600
         LA    R1,MSG3                                                  00017700
         LA    R0,L'MSG3               Length                           00017800
         BAL   R14,TPUT                Inform user                      00017900
         MVI   MSG3,C' '               Blank message                    00018000
         MVC   MSG3+1(L'MSG3-1),MSG3                                    00018100
         MVC   MSG3+10(8),CBLKGRPN     Group name                       00018200
         MVC   MSG3+18(10),=C' (DFLTGRP)'                               00018300
         LA    R1,MSG3                                                  00018400
         LA    R0,L'MSG3               Length                           00018500
         BAL   R14,TPUT                Inform user                      00018600
         USING CONNGRUP,R5             Connected groups                 00018700
         ICM   R5,15,CBLKGRPS          Point to connected groups        00018800
         BZ    READY                   No more groups                   00018900
         MVI   MSG3,C' '               Blank message                    00019000
         MVC   MSG3+1(L'MSG3-1),MSG3                                    00019100
LISTU011 CLC   CONNGRPN,CBLKGRPN       Same as DFLTGRP?                 00019200
         BE    LISTU013                Yes: skip                        00019300
         MVC   MSG3+10(8),CONNGRPN     Group name                       00019400
         LA    R1,MSG3                                                  00019500
         LA    R0,L'MSG3               Length                           00019600
         BAL   R14,TPUT                Inform user                      00019700
LISTU013 ICM   R5,15,CONNNEXT          Next connected group             00019800
         BNZ   LISTU011                If there, display                00019900
         ICM   R4,B'1111',CBLKNEXT     Next entry                       00020000
         BNZ   LISTU007                Test again for next UserId       00020100
READY    BAL   R14,PROB                Back to problem state            00020200
         XR    R15,R15                 Return code 0                    00020300
         B     RETURN                  Return                           00020400
*---------------------------------------------------------------------* 00020500
*        Return to TSO TMP.                                           * 00020600
*---------------------------------------------------------------------* 00020700
RC08     DS    0H                                                       00020800
         LA    R15,8                   RC = 8                           00020900
RETURN   DS    0H                                                       00021000
         LR    R4,R15                  Save return code                 00021100
         ICM   R2,15,PPL#LA            Filled in?                       00021200
         BZ    RETURN1                 No: do not free                  00021300
         LM    R2,R3,PPL#LA            Load length and address of PPL   00021400
         FREEMAIN RU,LV=(2),A=(3)      Free the PPL                     00021500
RETURN1  ICM   R8,15,ANSWER            Pointer to PDE's (the PDL)       00021600
         BZ    RETURN2                 No: skip                         00021700
         IKJRLSA (R8)                  Release PARSE storage            00021800
RETURN2  LR    R3,R13                  Load working storage to free     00021900
         L     R13,4(,R13)             Load caller's save area          00022000
         FREEMAIN RU,LV=WORKL,A=(3)    Release working storage          00022100
         LR    R15,R4                  Restore return code              00022200
         RETURN (14,12),RC=(15)        Return                           00022300
*                                                                       00022400
         TITLE 'Back to problem state'                                  00022500
PROB     ST    R14,R14PROB             Save register 14                 00022600
         MODESET KEY=NZERO,MODE=PROB   Back to problem state            00022700
         L     R14,R14PROB             Restore register 14              00022800
         BR    R14                     Return                           00022900
         TITLE 'Write message on screen'                                00023000
*---------------------------------------------------------------------* 00023100
*        Write the message on the terminal with a PUTLINE.            * 00023200
*        Register 0 = the length of the message.                      * 00023300
*        Register 1 = adress of the message.                          * 00023400
*---------------------------------------------------------------------* 00023500
TPUT     DS    0H                                                       00023600
         ST    R14,R14TPUT             Save register 14                 00023700
         L     R3,MYCPPL               Pickup CPPL of this command      00023800
         USING CPPL,R3                 Base IKJCPPL                     00023900
         MVI   PUTLINE+4,C' '          Clear output line                00024000
         MVC   PUTLINE+5(79),PUTLINE+4         ,,                       00024100
         LR    R2,R0                   Length of message                00024200
         BCTR  R2,0                    Minus 1 for EX                   00024300
         EX    R2,MVEMSG               Move the message                 00024400
         LA    R2,5(,R2)               Length in including length field 00024500
         XC    PUTLINE+2(2),PUTLINE+2  Byte 2 and 3, reserved           00024600
         STCM  R2,B'0011',PUTLINE      Save length in byte 0 and 1      00024700
         L     R2,CPPLUPT              User Profile Table               00024800
         L     R3,CPPLECT              Environment Control Table        00024900
         XC    ECB,ECB                 Force PUTLINE to wait            00025000
         LA    R0,PUTLINE              Data line address                00025100
         PUTLINE PARM=PUTBLOK,,MF=(E,PUTIOPL),                         *00025200
               OUTPUT=((0),TERM,SINGLE,DATA),ECB=ECB,UPT=(2),ECT=(3),  *00025300
               TERMPUT=(EDIT,WAIT,NOHOLD,NOBREAK)                       00025400
         L     R14,R14TPUT             Restore register 14              00025500
         BR    R14                                                      00025600
MVEMSG   MVC   PUTLINE+4(0),0(R1)      << executed >>                   00025700
         DROP  R3                      Unbase CPPL                      00025800
PCLSTART DS    0H                                                       00025900
ADDPCL   IKJPARM DSECT=ADDPRS          PDE's                            00026000
UIDPDE   IKJPOSIT JOBNAME,PROMPT='RAKF UserID',                        *00026100
               HELP=('a valid UserID')                                  00026200
         IKJENDP                                                        00026300
PCL#L    EQU   *-PCLSTART                                               00026400
         TITLE 'CONSTANTS'                                              00026500
*                                                                       00026600
MSG1     DC    C'LISTUSER: RAKF is not active'                          00026700
MSG2     DC    C'LISTUSER: No user table present'                       00026800
MSG4X    DC    C'LISTUSER: UserId=xxxxxxxx not defined in RAKF'         00026900
MSG5     DC    C'LISTUSER: Parse error'                                 00027000
MSGY     DC    C'LISTUSER: No ACEE found'                               00027100
MSGZ     DC    C'LISTUSER: Not authorized, no SPECIAL attribute'        00027200
         LTORG ,                                                        00027300
         DROP                                                           00027400
*                                                                       00027500
UIDRET   DSECT                         PDE of UserID                    00027600
UIDPTR   DS    F                       Pointer to UserID                00027700
UIDL     DS    H                       Length of UserID                 00027800
UIDFLG   DS    C                                                        00027900
$UPRES   EQU   128                     UserId is present                00028000
         DS    C                       Reserved                         00028100
*                                                                       00028200
WORKAREA DSECT                         Working storage                  00028300
         DS    18F                     Our save area                    00028400
MYCPPL   DS    F                                                        00028500
ECB      DS    F                       For IKJDAIR                      00028600
R14TPUT  DS    F                       Register 14 TPUT                 00028700
R14PROB  DS    F                       Register 14 PROB                 00028800
ANSWER   DS    F                       Parse answer area                00028900
PUTIOPL  DS    4F                      IKJIOPL                          00029000
PUTBLOK  PUTLINE MF=L                  PUTLINE PTPB                     00029100
PUTLINE  DS    CL84                    Output of PUTLINE                00029200
USERIDL  DS    H                       Length from IKJPOSIT             00029300
USERID   DS    CL8                     To receive UserID                00029400
*                                                                       00029500
PPL#LA   DS    F                       \___ Length + address PPL ____/  00029600
PPL#PTR  DS    F                       /                             \  00029700
*                                                                       00029800
MSG3     DS    CL50                                                     00029900
MSG4     DS    CL(L'MSG4X)                                              00030000
*                                                                       00030100
SW       DS    X                                                        00030200
$LISTED  EQU   128                                                      00030300
WORKL    EQU   *-WORKAREA              Length of working storage        00030400
*                                                                       00030500
         COPY  CJYUCBLK                Users table entry                00030600
         COPY  CJYRCVTD                RCVT CBLK                        00030700
         ICHPRCVT                      RACF CVT                         00030800
         CVT   DSECT=YES,LIST=NO                                        00030900
         IKJCPPL                                                        00031000
         IKJUPT                                                         00031100
         IKJPPL                        Parse parameter list             00031200
PPL#L    EQU   *-PPL                                                    00031300
         IHAPSA                                                         00031400
         IHAASCB                                                        00031500
         IHAASXB                                                        00031600
         IHAACEE                                                        00031700
*                                                                       00031800
R0       EQU   0                                                        00031900
R1       EQU   1                                                        00032000
R2       EQU   2                                                        00032100
R3       EQU   3                                                        00032200
R4       EQU   4                       Base register CBLK               00032300
R5       EQU   5                       Base register CONNGRUP           00032400
R6       EQU   6                                                        00032500
R7       EQU   7                                                        00032600
R8       EQU   8                       Address of IKJPARS PDL           00032700
R9       EQU   9                                                        00032800
R10      EQU   10                                                       00032900
R11      EQU   11                                                       00033000
R12      EQU   12                      Base register                    00033100
R13      EQU   13                      Address of working storage       00033200
R14      EQU   14                                                       00033300
R15      EQU   15                                                       00033400
         END                                                            00033500
