PERMIT   TITLE 'Permit access to a certain resource'                    00000100
*---------------------------------------------------------------------* 00000200
*                                                                     * 00000300
*        Module:       PERMIT                                         * 00000400
*        Alias:        PE                                             * 00000500
*                                                                     * 00000600
*        Author:       Rob Prins                                      * 00000700
*                                                                     * 00000800
*        Attributes:   RENT, REUS.                                    * 00000900
*                                                                     * 00001000
*        Function:     Parse the syntax of the PERMIT  command.       * 00001100
*                      Allocate SYS1.SECURE.CNTL(PROFILES)            * 00001200
*                      dynamically with IKJDAIR.                      * 00001300
*                      GETMAIN room for 1500 profiles.                * 00001400
*                      Read the PROFILES member into the table and    * 00001500
*                      skip the comments records.                     * 00001600
*                      Add new RAKF profiles in the PROFILES table.   * 00001700
*                      Sort the table alpabetically.                  * 00001800
*                                                                     * 00001900
*                      Write the PROFILES table back.                 * 00002000
*                      Free the SYS1.SECURE.CNTL data set.            * 00002100
*                                                                     * 00002200
*        Syntax:       PERMIT profile ACCESS(NONE/READ/UPDATE/CONTROL * 00002300
*                             ALTER)                                  * 00002400
*                             ID(group) CLASS(class)                  * 00002500
*                                                                     * 00002600
*                      Required: profile                              * 00002700
*                                ID(group)                            * 00002800
*                                                                     * 00002900
*                      Default: ACCESS(NONE)                          * 00003000
*                               CLASS(DATASET)                        * 00003100
*                                                                     * 00003200
*        Return codes: 00 - all good.                                 * 00003300
*                      08 - an error occurred, user is notified       * 00003400
*                           with a message                            * 00003500
*                                                                     * 00003600
*---------------------------------------------------------------------* 00003700
PERMIT   CSECT                                                          00003800
         SAVE  (14,12),,*                                               00003900
         LR    R12,R15                                                  00004000
         USING PERMIT,R12              Base register                    00004100
         LR    R2,R1                   Save parm (CPPL)                 00004200
         GETMAIN RU,LV=WORKL           Obtain savearea + working strg.  00004300
         ST    R1,8(,R13)              Forward pointer                  00004400
         ST    R13,4(,R1)              Backward pointer                 00004500
         LR    R13,R1                  This is our save area            00004600
         USING WORKAREA,R13            Base working storage             00004700
         ST    R2,MYCPPL               Save our CPPL address            00004800
         MVC   RAKFPROF,MDLPROF        Move model DCB to working strg   00004900
         XC    DAIR08,DAIR08           Clear IKJDAIR                    00005000
         XC    DAIR18,DAIR18                        ... blocks          00005100
         XC    ANSWER,ANSWER           Clear IKJPARS answer             00005200
         XC    PPL#LA,PPL#LA           Clear PPL pointers               00005300
         MVC   MSG3,MSG3X              Move message to working storage  00005400
         MVC   MSG9,MSG9X              Move message to working storage  00005500
         MVC   MSGA,MSGAX              Move message to working storage  00005600
         MVI   PROFREC-1,C' '          To blank Profile record          00005700
         MVI   SW,0                    Clear flags                      00005800
         LA    R0,DCBABEND             DCB abend exit                   00005900
         ST    R0,EXLST                Save JFCB in exit list           00006000
         MVI   EXLST,X'91'             DCB abend exit is last entry     00006100
         LA    R0,EXLST                Exit list (DCB abend exit)       00006200
         STCM  R0,B'0111',RAKFPROF+DCBEXLSA-IHADCB                      00006300
         GETMAIN RU,LV=120000      GETMAIN room for 1500 profiles       00006400
         ST    R1,ADRPROF              Save its address                 00006500
         USING PSA,R0                  Point to CVT                     00006600
         L     R2,PSAANEW              Load ASCB                        00006700
         L     R2,ASCBASXB-ASCB(R2)    Load ASXB                        00006800
         ICM   R2,15,ASXBSENV-ASXB(R2) Point to ACEE                    00006900
         BNZ   CONT1                   Yes: found                       00007000
         LA    R1,MSGY                 Msg: 'No ACEE found'             00007100
         LA    R0,L'MSGY               Length                           00007200
         BAL   R14,TPUT                Write the message on screen      00007300
         B     RC08                    End with RC=-08                  00007400
CONT1    TM    ACEEFLG1-ACEE(R2),ACEESPEC Do we have the SPECIAL attr   00007500
         BO    CONT2                                                    00007600
         LA    R1,MSGZ                 Msg: 'No SPECIAL attribute'      00007700
         LA    R0,L'MSGZ               Length                           00007800
         BAL   R14,TPUT                Write the message on screen      00007900
         B     RC08                    End with RC=-08                  00008000
CONT2    DS    0H                                                       00008100
*---------------------------------------------------------------------* 00008200
*        Parse parameters                                             * 00008300
*---------------------------------------------------------------------* 00008400
         GETMAIN RU,LV=PPL#L           Obtain a dynamic PPL workarea    00008500
         STM   R0,R1,PPL#LA            Save length and address of PPL   00008600
         L     R2,PPL#PTR              Get the address of the PPL       00008700
         USING PPL,R2                  Adress it                        00008800
         L     R1,MYCPPL               Get address of CPPL              00008900
         USING CPPL,R1                 Base the CPPL                    00009000
*---------------------------------------------------------------------* 00009100
*                                                                       00009200
*        Populate the Parse Parameter List (PPL) from the CPPL,         00009300
*        add the IKJPARMD list in the PPL and invoke IKJPARS            00009400
*                                                                       00009500
*---------------------------------------------------------------------* 00009600
*                                                                       00009700
         MVC   PPLUPT,CPPLUPT          Put in the UPT address from CPPL 00009800
         MVC   PPLECT,CPPLECT          Put in the ECT address from CPPL 00009900
         MVC   PPLCBUF,CPPLCBUF        Put in the command buffer addr.  00010000
*                                      From the CPPL                    00010100
         XC    ECB,ECB                 Clear Event control block        00010200
         L     R1,=A(ADDPCL)           Address of PCL                   00010300
         ST    R1,PPLPCL               Set in PPL                       00010400
         LA    R1,ANSWER               Answer area                      00010500
         ST    R1,PPLANS               Pointer into PPL                 00010600
         LA    R1,ECB                  Event control block              00010700
         ST    R1,PPLECB               Pointer into PPL                 00010800
         ST    R13,PPLUWA              User provide workarea            00010900
         CALLTSSR EP=IKJPARS,MF=(E,PPL)   Invoke parse                  00011000
         DROP  R1,R2                   Unbase CPPL and PPL              00011100
         LTR   R15,R15                 Parse successfully processed?    00011200
         BZ    PARSEOK                 Yes: carry                       00011300
         LA    R0,L'MSG5               Length                           00011400
         LA    R1,MSG5                 Message                          00011500
         BAL   R14,TPUT                                                 00011600
         XC    ANSWER,ANSWER           Avoid IKJRLSA                    00011700
         B     RC08                    Return to TMP                    00011800
PARSEOK  DS    0H                                                       00011900
         L     R8,ANSWER               Pointer to PDL                   00012000
         USING ADDPRS,R8               mapped with IKJPARM              00012100
         MVI   PROFILE,C' '                                             00012200
         MVC   PROFILE+1(L'PROFILE-1),PROFILE initialize profile        00012300
         LA    R3,PROFPDE              Profile PDE                      00012400
         USING PROFRET,R3              Base this PDE                    00012500
         L     R1,PROFPTR              Pointer to Profile name          00012600
         LH    R2,PROFL                Length                           00012700
         BCTR  R2,0                    -1 for EX                        00012800
         EX    R2,MVEPROF              Move Profile                     00012900
         B     ENDPROF                 Branch over EX                   00013000
MVEPROF  MVC   PROFILE(0),0(R1)        << Executed >>                   00013100
ENDPROF  DS    0H                                                       00013200
         DROP  R3                      Unbase PROFRET                   00013300
         LA    R3,CLASSPDE             Point to resource class PDE      00013400
         USING CLASRET,R3              Base this PDE                    00013500
         TM    CLASFLG,$CPRES          Is CLASS present?                00013600
         BNZ   CLAS001                 Yes: good                        00013700
         MVC   CLASS,=CL8'DATASET'     Default is the DATASET class     00013800
         B     ENDCLAS                                                  00013900
CLAS001  DS    0H                                                       00014000
         MVC   CLASS,=CL8' '           Blank CLASS name                 00014100
         LH    R2,CLASL                Length of Class name             00014200
         L     R1,CLASPTR              Class name                       00014300
         BCTR  R2,0                    Minus 1 for EX                   00014400
         EX    R2,MVECLAS              Move Class name                  00014500
         B     ENDCLAS                 Branch over EX                   00014600
MVECLAS  MVC   CLASS(0),0(R1)          << Executed >>                   00014700
ENDCLAS  DS    0H                                                       00014800
         DROP  R3                      Unbase CLASRET                   00014900
         LA    R3,IDPDE                Point to ID(group) PDE           00015000
         USING IDRET,R3                Base this PDE                    00015100
         TM    IDFLG,$IPRES            Is ID present?                   00015200
         BNZ   ID001                   Yes: process group in ID         00015300
         LA    R1,MSG6                 Msg: ID is required              00015400
         LA    R0,L'MSG6               Length                           00015500
         BAL   R14,TPUT                Write the message                00015600
         B     RC08                    End with return code = 8         00015700
ID001    MVC   GROUPCPY,=CL8' '        Blank group name of ID           00015800
         LH    R2,IDL                  Length of Class name             00015900
         L     R1,IDPTR                Group name of ID                 00016000
         BCTR  R2,0                    Minus 1 for EX                   00016100
         EX    R2,MVEID                Move group name                  00016200
         B     ENDID                   Branch over EX                   00016300
MVEID    MVC   GROUPCPY(0),0(R1)       << Executed >>                   00016400
ENDID    DS    0H                                                       00016500
         DROP  R3                      Unbase CLASRET                   00016600
         LH    R1,ACCESS               ACCESS PDL                       00016700
         MH    R1,=H'10'               Times 10 (MVC + B)               00016800
         B     *+4(R1)                 Branchlist                       00016900
         MVC   ACC,=CL8'NONE'          Default (0) = NONE               00017000
         B     ENDPARS                                                  00017100
         MVC   ACC,=CL8'NONE'          (1)                              00017200
         B     ENDPARS                                                  00017300
         MVC   ACC,=CL8'READ'          (2)                              00017400
         B     ENDPARS                                                  00017500
         MVC   ACC,=CL8'UPDATE'        (3)                              00017600
         B     ENDPARS                                                  00017700
         MVC   ACC,=CL8'CONTROL'       (4)                              00017800
         B     ENDPARS                                                  00017900
         MVC   ACC,=CL8'ALTER'         (5)                              00018000
ENDPARS  DS    0H                                                       00018100
*---------------------------------------------------------------------* 00018200
*        Allocate SYS1.SECURE.CNTL(PROFILES)                          * 00018300
*---------------------------------------------------------------------* 00018400
         LA    R3,DAIR08               Allocation request block         00018500
         USING DAPB08,R3               Base DAPB08                      00018600
         MVI   DA08CD+1,X'08'          Entry code 08 (allocation)       00018700
         MVC   DA08DDN,=CL8'RAKFPROF'  DDNAME to allocate               00018800
         MVC   DA08PDSN,=A(PROFDSNL)   Temporary data set name          00018900
         MVI   DA08DSP1,DA08OLD        DISP=OLD                         00019000
         MVC   DA08MNM,=CL8'PROFILES'  Fixed member name                00019100
         MVI   DA08UNIT,C' '           Clear unit name                  00019200
         MVC   DA08UNIT+1(L'DA08UNIT-1),DA08UNIT                        00019300
         MVI   DA08SER,C' '            Clear volume serial              00019400
         MVC   DA08SER+1(L'DA08SER-1),DA08UNIT                          00019500
         LR    R1,R3                   Parameter CALLTS                 00019600
         BAL   R14,CALLTS              IKJDAIR routine                  00019700
         LTR   R15,R15                 Allocation OK?                   00019800
         BZ    PERM001                 Yes: carry on                    00019900
         LA    R1,MSG1                 Msg: 'allocation error PROF'     00020000
         LA    R0,L'MSG1               Length                           00020100
         BAL   R14,TPUT                Write the message on screen      00020200
         B     RC08                    Return code 8                    00020300
PERM001  DS    0H                                                       00020400
*---------------------------------------------------------------------* 00020500
*        Open SYS1.SECURE.CNTL(PROFILES) with DDNAME RAKPROF          * 00020600
*---------------------------------------------------------------------* 00020700
         MVI   OPEND,X'80'             First and only DCB               00020800
         OPEN  RAKFPROF,MF=(E,OPEND)                                    00020900
         TM    SW,$913                 Access denied?                   00021000
         BNO   PERM005                 No: assumed, that open is succes 00021100
         MVC   MSG3+8(8),=CL8'RAKFPROF'  DD-name                        00021200
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00021300
         LA    R0,L'MSG3               Length                           00021400
         BAL   R14,TPUT                Write the message on screen      00021500
         BAL   R14,FREE                Free the data sets               00021600
         B     RC08                    Return code 8                    00021700
PERM005  DS    0H                                                       00021800
*---------------------------------------------------------------------* 00021900
*        Read the PROFILES records and check if the profile is        * 00022000
*        already added.                                               * 00022100
*        And populate the table with Profile records.                 * 00022200
*---------------------------------------------------------------------* 00022300
         XR    R5,R5                   Clear record counter             00022400
         L     R6,ADRPROF              Start of Profile table           00022500
READPROF DS    0H                                                       00022600
         MVC   GROUP,=CL8' '           Blank ID(group) in PROFCMP       00022700
         GET   RAKFPROF,PROFREC        Read a record                    00022800
         CLI   PROFREC,C'*'            Comment record?                  00022900
         BE    READPROF                Yes: skip                        00023000
         LA    R5,1(,R5)               Count record                     00023100
         C     R5,=F'1495'             Already 1495 records in table?   00023200
         BL    PERM010                 No: room enough                  00023300
         LA    R1,MSG7                 Msg: 'table full'                00023400
         LA    R0,L'MSG7               Length                           00023500
         BAL   R14,TPUT                Write the message on screen      00023600
         BAL   R14,CLOSE               Close RAKFPROF                   00023700
         BAL   R14,FREE                Free the data sets               00023800
         B     RC08                    Return code 8                    00023900
PERM010  TM    SW,$UACREC              Universal access record found?   00024000
         BNZ   PERM011                 Yes: good                        00024100
*---------------------------------------------------------------------* 00024200
*        Compare Class + Profile + Blank group = Universal record     * 00024300
*---------------------------------------------------------------------* 00024400
         CLC   PROFREC(60),PROFCMP     Is this the universal access?    00024500
         BNE   PERM013                 No: test if resource granted     00024600
         OI    SW,$UACREC              Mark UACC record found           00024700
PERM011  MVC   GROUP,GROUPCPY          Move ID(group) name in PROFCMP   00024800
*---------------------------------------------------------------------* 00024900
*        Compare Class + Profile + Group.                             * 00025000
*        If this record is there, replace ACCESS unconditionally,     * 00025100
*        flag this replacement and don't write a new record to        * 00025200
*        avoid duplicate records in the PROFILES member.              * 00025300
*---------------------------------------------------------------------* 00025400
         CLC   PROFREC(60),PROFCMP     Resource already granted?        00025500
         BNE   PERM013                 No: good                         00025600
         MVC   PROFACC,ACC          Yes: replace ACCESS unconditionally 00025700
         OI    SW,$ACCREP              Flag it                          00025800
PERM013  DS    0H                                                       00025900
         MVC   0(80,R6),PROFREC        Record into table                00026000
         LA    R6,80(,R6)              Next entry in table              00026100
         B     READPROF                Read next record                 00026200
PROFEOF  DS    0H                      EOF RACFPROF                     00026300
*                                                                       00026400
*---------------------------------------------------------------------* 00026500
*        Add the new profile record if not already there and if       * 00026600
*        a universal access record is found.                          * 00026700
*        Sort the Profile table alphabetically and                    * 00026800
*        write the Profile records in the Profile table.              * 00026900
*---------------------------------------------------------------------* 00027000
         TM    SW,$UACREC              Did we find a Universal Access?  00027100
         BNZ   PERM014                 Yes: good                        00027200
         LA    R1,MSG2                 Msg: 'No universal acces found'  00027300
         LA    R0,L'MSG2               Length                           00027400
         BAL   R14,TPUT                Write the message on screen      00027500
         BAL   R14,CLOSE               Close the data sets              00027600
         BAL   R14,FREE                Free the data sets               00027700
         B     RC08                    Return code 8                    00027800
PERM014  TM    SW,$ACCREP              Profile record found and         00027900
*                                      ACCESS replaced?                 00028000
         BNZ   PERM015                 No new record needed to          00028100
*                                      avoid duplicate records          00028200
         MVC   PROFREC,PROFREC-1       Clear profile record             00028300
         MVC   PROFCLS,CLASS           Class name                       00028400
         MVC   PROFPRF,PROFILE         Move profile                     00028500
         MVC   PROFGRP,GROUPCPY        Move ID(group)                   00028600
         MVC   PROFACC,ACC             Access level                     00028700
         MVC   0(80,R6),PROFREC        Move record in table             00028800
         LA    R5,1(,R5)               Count record                     00028900
PERM015  MVI   CLOSED,X'80'            First and only DCB               00029000
         CLOSE RAKFPROF,MF=(E,CLOSED)                                   00029100
SORT     STM   R4,R8,SAVESORT                                           00029200
         LR    R7,R5                   Copy record counter              00029300
         L     R2,ADRPROF              Point to first record            00029400
         CH    R7,=H'2'                Less than 2 records?             00029500
         BL    ENDSORT                 Do not sort                      00029600
         BCTR  R7,0                    Minus 1                          00029700
         MH    R7,=H'80'               ** Record length                 00029800
         LA    R7,0(R2,R7)             Point to last record             00029900
*                                                                       00030000
SORT01   DS    0H                      Start sort                       00030100
         ST    R7,SWAPLAST             Last record swapped              00030200
         L     R4,ADRPROF              Point to first record            00030300
         LR    R5,R4                   Next                             00030400
         LA    R5,80(,R4)                   Record                      00030500
SORT03   DS    0H                                                       00030600
         CL    R4,SWAPLAST             Last record reached?             00030700
         BNL   SORT07                  Yes: loop complete               00030800
         CLC   0(72,R4),0(R5)          Compare (skip sequence numbers)  00030900
         BNH   SORT05                  High: swap these records         00031000
         XC    0(80,R4),0(R5)          Swap                             00031100
         XC    0(80,R5),0(R4)              the                          00031200
         XC    0(80,R4),0(R5)                   records                 00031300
         LR    R7,R4                   Last record swapped in R7        00031400
SORT05   DS    0H                      Load next entry                  00031500
         LA    R4,80(,R4)              Next record                      00031600
         LA    R5,80(,R5)              Next record                      00031700
         B     SORT03                  Compare next record              00031800
SORT07   DS    0H                      All records done                 00031900
         CL    R7,SWAPLAST             Are these swaps executed?        00032000
         BL    SORT01                  No: sort them again              00032100
*                                      Else end of sort                 00032200
ENDSORT  LM    R4,R8,SAVESORT          Restore registers                00032300
         MVI   OPEND,X'80'             First and only DCB               00032400
         OPEN  (RAKFPROF,(OUTPUT)),MF=(E,OPEND)                         00032500
         TM    SW,$913                 Access denied?                   00032600
         BNO   PERM017                 No: assumed, that open is succes 00032700
         MVC   MSG3+8(8),=CL8'RAKFPROF'  DD-name                        00032800
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00032900
         LA    R0,L'MSG3               Length                           00033000
         BAL   R14,TPUT                Write the message on screen      00033100
         BAL   R14,CLOSE               Close the DCBs                   00033200
         BAL   R14,FREE                Free the data sets               00033300
         B     RC08                    Return code 8                    00033400
PERM017  L     R6,ADRPROF              Max 1500 profile entries         00033500
*---------------------------------------------------------------------* 00033600
*        Write the RAKF Profiles back in the PROFILES member.         * 00033700
*---------------------------------------------------------------------* 00033800
PERM019  DS    0H                                                       00033900
         PUT   RAKFPROF,0(R6)          Write ...                        00034000
         LA    R6,80(,R6)                    Profile ...                00034100
         BCT   R5,PERM019                         table back            00034200
         MVC   MSG9PROF,PROFILE        Profile in success message       00034300
         MVC   MSG9CLS,CLASS           Class in success message         00034400
         MVC   MSG9ACC,ACC             Access in success message        00034500
         LA    R1,MSG9                 Success messages                 00034600
         LA    R0,L'MSG9               Length                           00034700
         BAL   R14,TPUT                Write the message on screen      00034800
         MVC   MSGA+13(8),GROUPCPY     Group that's granted             00034900
         LA    R1,MSGA                 Msg: ID = xxxxxxxx               00035000
         LA    R0,L'MSGA               Length                           00035100
         BAL   R14,TPUT                Write the message on screen      00035200
         LA    R1,MSGB                 Msg: Run RAKFPROF ...            00035300
         LA    R0,L'MSGB               Length                           00035400
         BAL   R14,TPUT                Write the message on screen      00035500
         BAL   R14,CLOSE               Close the data sets              00035600
         BAL   R14,FREE                And unallocate                   00035700
         LA    R15,0                   RC = 0                           00035800
         B     RETURN                                                   00035900
*---------------------------------------------------------------------* 00036000
*        Return to TSO TMP.                                           * 00036100
*---------------------------------------------------------------------* 00036200
RC08     DS    0H                                                       00036300
         LA    R15,8                   RC = 8                           00036400
RETURN   DS    0H                                                       00036500
         LR    R4,R15                  Save return code                 00036600
         ICM   R2,15,PPL#LA            Is the PPL allocated?            00036700
         BZ    RETURN1                 No: don't free                   00036800
         LM    R2,R3,PPL#LA            Load length and address of PPL   00036900
         FREEMAIN RU,LV=(2),A=(3)      Free the PPL                     00037000
RETURN1  ICM   R8,15,ANSWER            Pointer to PDE's (the PDL)       00037100
         BZ    RETURN2                 No: skip                         00037200
         IKJRLSA (R8)                  Release PARSE storage            00037300
RETURN2  L     R2,ADRPROF              Address of Profile table         00037400
         FREEMAIN RU,LV=120000,A=(2)                                    00037500
         LR    R3,R13                  Load working storage to free     00037600
         L     R13,4(,R13)             Load caller's save area          00037700
         FREEMAIN RU,LV=WORKL,A=(3)    Release working storage          00037800
         LR    R15,R4                  Restore return code              00037900
         RETURN (14,12),RC=(15)        Return                           00038000
*                                                                       00038100
         TITLE 'Invoke IKJDAIR, A(Parm block) in R1'                    00038200
*---------------------------------------------------------------------* 00038300
*        Routine:   CALLTS                                            * 00038400
*        Function:  Invoke IKJDAIR to allocate or unallocate data sets* 00038500
*                   Register 1 contains the address of the allocation * 00038600
*                   or unallocation DAIR parameter blocks.            * 00038700
*---------------------------------------------------------------------* 00038800
CALLTS   DS    0H                                                       00038900
         ST    R14,R14TS               Save register 14                 00039000
         LR    R14,R1                  Save A(IKJDAIR parm block)       00039100
         XC    ECB,ECB                 Clear ECB                        00039200
         LA    R1,DAIRDAPL                                              00039300
         L     R2,MYCPPL               Pickup our CPPL                  00039400
         USING CPPL,R2                 Base CPPL                        00039500
         USING DAPL,R1                 Base IKJDAPL                     00039600
         MVC   DAPLUPT(4),CPPLUPT                                       00039700
         MVC   DAPLECT(4),CPPLECT                                       00039800
         XC    ECB,ECB                 Clear Event control block        00039900
         LA    R0,ECB                  Address of our ECB               00040000
         ST    R0,DAPLECB              Set A(ECB) in DAPL               00040100
         MVC   DAPLPSCB(4),CPPLPSCB                                     00040200
         ST    R14,DAPLDAPB            Set A(parm block) in DAPL        00040300
         CALLTSSR EP=IKJDAIR,MF=(E,DAIRDAPL)                            00040400
         L     R14,R14TS               Restore register 14              00040500
         BR    R14                                                      00040600
         DROP  R1,R2                   Unbase DAPL and CPPL             00040700
         TITLE 'Write message on screen'                                00040800
*---------------------------------------------------------------------* 00040900
*        Write the message on the terminal with a PUTLINE.            * 00041000
*        Register 0 = the length of the message.                      * 00041100
*        Register 1 = adress of the message.                          * 00041200
*---------------------------------------------------------------------* 00041300
TPUT     DS    0H                                                       00041400
         ST    R14,R14TPUT             Save register 14                 00041500
         L     R3,MYCPPL               Pickup CPPL of this command      00041600
         USING CPPL,R3                 Base IKJCPPL                     00041700
         MVI   PUTLINE+4,C' '          Clear output line                00041800
         MVC   PUTLINE+5(91),PUTLINE+4         ,,                       00041900
         LR    R2,R0                   Length of message                00042000
         BCTR  R2,0                    Minus 1 for EX                   00042100
         EX    R2,MVEMSG               Move the message                 00042200
         LA    R2,5(,R2)               Length in including length field 00042300
         XC    PUTLINE+2(2),PUTLINE+2  Byte 2 and 3, reserved           00042400
         STCM  R2,B'0011',PUTLINE      Save length in byte 0 and 1      00042500
         L     R2,CPPLUPT              User Profile Table               00042600
         L     R3,CPPLECT              Environment Control Table        00042700
         XC    ECB,ECB                 Force PUTLINE to wait            00042800
         LA    R0,PUTLINE              Data line address                00042900
         PUTLINE PARM=PUTBLOK,,MF=(E,PUTIOPL),                         *00043000
               OUTPUT=((0),TERM,SINGLE,DATA),ECB=ECB,UPT=(2),ECT=(3),  *00043100
               TERMPUT=(EDIT,WAIT,NOHOLD,NOBREAK)                       00043200
         L     R14,R14TPUT             Restore register 14              00043300
         BR    R14                                                      00043400
MVEMSG   MVC   PUTLINE+4(0),0(R1)      << executed >>                   00043500
         DROP  R3                      Unbase CPPL                      00043600
         TITLE 'Free SYS1.SECURE.CNTL'                                  00043700
FREE     DS    0H                                                       00043800
         ST    R14,R14FREE             Save register 14                 00043900
         LA    R3,DAIR18               Point to unallocation parm block 00044000
         XC    DAIR18,DAIR18           Clear unallocation parm block    00044100
         USING DAPB18,R3               IKJDAP18                         00044200
         MVI   DA18CD+1,X'18'          Entry code 0018 (unallocate)     00044300
         MVI   DA18MNM,C' '            Provide no ...                   00044400
         MVC   DA18MNM+1(7),DA18MNM               member name           00044500
         MVC   DA18DDN,=CL8'RAKFPROF'  DDNAME to unallocate             00044600
         LR    R1,R3                   Parameter CALLTS                 00044700
         BAL   R14,CALLTS              IKJDAIR routine                  00044800
         L     R14,R14FREE             Restore register 14              00044900
         BR    R14                     Return                           00045000
         DROP  R3                      Unbase DAPB18                    00045100
         TITLE 'Close RAKFPROF'                                         00045200
CLOSE    ST    R14,R14CLOSE            Save register 14                 00045300
         MVI   CLOSED,X'80'            First and only DCB               00045400
         CLOSE RAKFPROF,MF=(E,CLOSED)                                   00045500
         L     R14,R14CLOSE            Restore register 14              00045600
         BR    R14                     Return                           00045700
         TITLE 'DCB abend exit'                                         00045800
DCBABEND DS    0H                                                       00045900
         TM    3(R1),B'00001110'       Processing allowed?              00046000
         BZR   R14                     No: continue with abend          00046100
         TM    3(R1),4                 Ignore bit on?                   00046200
         MVI   3(R1),0                 Prepare for NO                   00046300
         BZR   R14                                                      00046400
         MVC   DCBCOMP,0(R1)           Move completion code             00046500
         NC    DCBCOMP,=X'FFF0'        Clear last nibble                00046600
         CLC   DCBCOMP,=X'9130'        Do we have an RACF/ACF2 abend?   00046700
         BNER  R14                     No: continue with abend          00046800
         MVI   3(R1),4                 Yes: ignore abend                00046900
         OI    SW,$913                 Indicate 913 abend               00047000
         BR    R14                     Return to Access Method          00047100
PCLSTART DS    0H                                                       00047200
