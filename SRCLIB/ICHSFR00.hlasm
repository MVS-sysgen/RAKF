         LTR   R3,R3               yes --> no password entered?         00072900
         BZ    RTRNFAIL            yes --> don't write message          00073000
RACIFWTO MVC   WORKWTO+4(60),WTOMSG4  ATTEMPTED ACCESS                  00073100
         ICM   R5,B'1111',4(R8)    GO TO USERID                         00073200
         IC    R1,0(R5)            GET LENGTH                           00073300
         EX    R1,RACIWTO2         MOVE NAME FOR WTO                    00073400
         WTO   MF=(E,WORKWTO)      WRITE IT                             00073500
         XC    SAFPRREA,SAFPRREA   NOTHING ...                          00073600
         XC    WORKPASS,WORKPASS   CLEAR JUST IN CASE                   00073700
         B     RTRNFAIL            BYE ............                     00073800
RACIWTO2 MVC   WORKWTO+4+WTOMSG4U(0),1(R5) MOVE USERID                  00073900
         TITLE 'ALL ROADS LEAD HERE'                                    00074000
RTRN0000 LA    R15,0               RC = 0                               00074100
         B     RTRNRTRN            GO BACK                              00074200
*                                                                       00074300
RTRNGOOD LA    R15,0               RACF RC=0                            00074400
         B     RTRNRTRN            GO BACK                              00074500
*                                                                       00074600
RTRNWARN LA    R15,4               RACF RC=4                       @rp2 00074700
         B     RTRNRTRN            GO BACK                              00074800
*                                                                       00074900
RTRNFAIL LA    R15,8               RACF RC=8                       @rp2 00075000
         B     RTRNRTRN            GO BACK                              00075100
*                                                                       00075200
RTRNRTRN L     R13,WORKSAVE+4      RETURN R13                           00075300
         RETURN (14,12),RC=(15)    BYE                                  00075400
*                                                                       00075500
         TITLE 'CHECK FOR ACCESS'                                       00075600
ENTYCHCK MVI   WORKENTL,0          Nullify Entity length           @rp2 00075700
         L     R2,FLCCVT           LOAD CVT                             00075800
         ICM   R2,B'1111',CVTRAC-CVTMAP(R2) CHECK RCVT                  00075900
         BZ    ENTYERR1            WHO KNOWS?                           00076000
         ICM   R2,B'1111',RCVTISTL-RCVT(R2) OUR STUFF?                  00076100
         BZ    ENTYERR1            WHO KNOWS?                           00076200
         ICM   R2,B'1111',CJYPROFS-CJYRCVTD(R2) OUR STUFF?              00076300
         BZ    ENTYERR1            WHO KNOWS?                           00076400
         USING RPECBLK,R2          ADDRESS CBLK                         00076500
         CLC   WORKCLAS(8),=CL8' '    CLASS blank?                      00076600
         BNE   ENTYNBLK                  --> no, continue               00076700
         MVC   WORKCLAS(8),=CL8'DATASET' --> yes, assume DATASET        00076800
ENTYNBLK CLC   =C'DATASET',WORKCLAS  CHECK FOR OUR OWN DSNS.            00076900
         BNE   ENTYCLLP            NO, GO ON                            00077000
         XR    R1,R1               Clear is needed for LA          @mg1 00077100
         IC    R1,ACEEUSRL         GET LENGTH                           00077200
         BCTR  R1,0                DOWN 1 FOR CLC                       00077300
         EX    R1,ENTYEXUS         CLC 0(0,ENTYREG),ACEEUSRN            00077400
         BNE   ENTYTEMP            No: not our dataset             @mg1 00077500
         LA    R14,1(R1,ENTYREG)   Point after UserID              @mg1 00077600
         CLI   0(R14),C'.'         First qualifier is UserID?      @mg1 00077700
         BE    AUTHGOOD            Yes: definitely our dataset     @mg1 00077800
ENTYTEMP DS    0H                                                  @mg1 00077900
         CLC   0(3,ENTYREG),=C'SYS' is it a ..                          00078000
         BNE   ENTYCLLP              --> no                             00078100
         CLC   8(2,ENTYREG),=C'.T'            .. temporary ..           00078200
         BNE   ENTYCLLP              --> no                             00078300
         CLC   16(3,ENTYREG),=C'.RA'                         .. dataset 00078400
         BNE   ENTYCLLP              --> no, go on                      00078500
         B     AUTHGOOD              --> yes, go for it                 00078600
ENTYCLLP XC    WORKSTAT,WORKSTAT   Parameter for RACSTAT           @rp2 00078700
         LA    R1,WORKCLAS         Class name                      @rp2 00078800
         ST    R1,WORKSTAT         Class name to check             @rp2 00078900
         LA    R1,WORKSTAT         Parameter for RACSTAT           @rp2 00079000
         L     R3,X'4C'            Pointer CVT                     @rp2 00079100
         ICM   R3,B'1111',CVTRAC-CVTMAP(R3) Load RCVT              @rp2 00079200
         ICM   R15,15,RCVTREXP-RCVT(R3)  Entry point RACSTAT       @rp2 00079300
         BZ    ENTYCLL2            Give it the benefit of the doubt@rp2 00079400
         BALR  R14,R15             Invoke RACSTAT (in CJYRCVT)     @rp2 00079500
         LTR   R15,R15             Is CLASS present in CDT?        @rp2 00079600
         BZ    ENTYCLL2            Yes: continue                   @rp2 00079700
         LR    R5,R10              Save entry register             @rp2 00079800
         BAL   R10,WTOUNKN         Msg: Undefined Class xxxxxxxx   @rp2 00079900
         LR    R10,R5              Restore entry register          @rp2 00080000
         B     AUTHFAIL            RC=8 --> exit                   @rp2 00080100
ENTYCLL2 IC    R1,RPECLASL         Get length from Profile entry   @rp2 00080200
         BCTR  R1,0                SUBTRACT 1 FOR CLC                   00080300
         EX    R1,ENTYEXEC         CLC RPECLASN(0),WORKCLAS             00080400
         BL    ENTYNFND            NOT FOUND                            00080500
         BNE   ENTYNCLS            NO, GET NEXT                         00080600
         MVC   WORKENTL,RPEENTYL   Copy Entity length field        @rp2 00080700
         ICM   R1,B'0001',RPEENTYL GET LENGTH                           00080800
         BZ    ENTYENFN            '*' ONLY ENTITY?                     00080900
         BCTR  R1,0                NO, SUBTRACT 1 FOR CLC               00081000
         EX    R1,ENTYEXEN         CLC RPEENTYN(0),0(ENTYREG)           00081100
         BE    ENTYENFN            FOUND ENTITY                         00081200
ENTYNCLS ICM   R2,B'1111',RPENEXT  GET NEXT                             00081300
         BNZ   ENTYCLLP            GO FOR NEXT                          00081400
ENTYNFND B     ENTYWARN            RETURN WARN                          00081500
ENTYEXEC CLC   RPECLASN(0),WORKCLAS SAME CLASS? << executed >>          00081600
ENTYEXEN CLC   RPEENTYN(0),0(ENTYREG) CHECK ENTITY                      00081700
ENTYEXUS CLC   0(0,ENTYREG),ACEEUSRI US?                                00081800
*                                                                       00081900
ENTYENFN ICM   R3,B'1111',RPEACCPT POINTER TO ACCESSES                  00082000
         BZ    ENTYUACC            GO CHECK UACC                        00082100
*                                                                       00082200
         USING RPEACCLE,R3         VARIABLE SECTION                     00082300
ENTYULOP CLC   RPEAUSR,ACEEUSRI    USER EXCEPTION?                      00082400
         BE    ENTYEXCP            MATCH, GO CHECK                      00082500
         ICM   R3,B'1111',RPEANEXT NEXT POINTER                         00082600
         BNZ   ENTYULOP            GO CHECK NEXT                        00082700
*                                                                       00082800
ENTYCONN ICM   R4,B'1111',ACEECGRP CONNECT GROUPS                       00082900
         BZ    ENTYUACC            NONE, GO ON                          00083000
         USING CONNGRUP,R4         ADDRESS IT                           00083100
ENTYCONL L     R3,RPEACCPT         GET POINTER AGAIN                    00083200
ENTYCON2 CLC   RPEAUSR,CONNGRPN    GROUP EXCEPTION?                     00083300
         BNE   ENTYNCRP            NO, NEXT RPE                         00083400
         OI    WORKFLAG,WORKOPRB   SET OPER BYPASS                      00083500
         CLC   WORKAUTH,RPEACS     SUFFICENT ACCESS IN PERMIT?          00083600
         BH    ENTYNCRP            NO, CHECK NEXT AUTH.                 00083700
         B     AUTHGOOD            YES, GO ON ...                       00083800
ENTYNCRP ICM   R3,B'1111',RPEANEXT NEXT POINTER                         00083900
         BNZ   ENTYCON2            GO CHECK NEXT EXCEPTION              00084000
ENTYNCON ICM   R4,B'1111',CONNNEXT NEXT POINTER                         00084100
         BNZ   ENTYCONL            GO CHECK NEXT CONNECT                00084200
         TM    WORKFLAG,WORKOPRB   BYPASS OPER CHECK?                   00084300
         BNO   ENTYUACC            NO, GO UACC                          00084400
         B     ENTYFAIL            ALL CONN.S FAILED                    00084500
*                                                                       00084600
ENTYUACC CLC   WORKAUTH,RPEUACC    SUFFICENT ACCESS IN UACC?            00084700
         BH    ENTYOPER            NO, RETURN CHECK FOR OP. AUTH        00084800
         B     AUTHGOOD            YES, GO ON ...                       00084900
*                                                                       00085000
ENTYEXCP CLC   WORKAUTH,RPEACS     SUFFICENT ACCESS IN PERMIT?          00085100
         BH    ENTYFAIL            NO, RETURN CHECK FOR OP. AUTH        00085200
         B     AUTHGOOD            YES, GO ON ...                       00085300
*                                                                       00085400
ENTYOPER CLC   =C'DATASET',RPECLASN  DATASET CLASS                      00085500
         BE    ENTYOPR2            YES, CHECK OPER AUTH                 00085600
         CLC   =C'DASDVOL',RPECLASN DASDVOL CLASS                       00085700
         BE    ENTYOPR2            YES, CHECK OPER AUTH                 00085800
         B     ENTYFAIL            TOUGH                                00085900
ENTYOPR2 TM    ACEEFLG1,ACEEOPER   MAKE OPER AUTH.                      00086000
         BNO   ENTYFAIL            TOUGH                                00086100
*                                                                       00086200
         DROP  R4,R3,R2            RPEACCLE CONNGRUP RPECBLK       @rp2 00086300
         CLC   =C'PROD',ACEEUSRI   PROD USERID?                         00086400
         BNE   AUTHGOOD            NO MSG NEC. -> OPER ALLOWED          00086500
         TM    WORKFLAG,WORKNLOG   NO LOG REQUESTED?                    00086600
         BO    AUTHGOOD            YES, NO MESS..                       00086700
         MVC   WORKWTO+4(60),WTOMSG7 INVALID ACCESS TO RESOURCE         00086800
         MVC   WORKWTO+4+WTOMSG7U(L'WTOMSG7U),ACEEUSRI MOVE USERID      00086900
         WTO   MF=(E,WORKWTO)      WRITE IT                             00087000
         MVC   WORKWTO+4(60),WTOMSGE ENTITY SKELETON                    00087100
         MVC   WORKWTO+4(9),=C'RAKF0006 ' USERID/CLASS                  00087200
         BAL   R4,ENTYENTY         ENTY COMMON                          00087300
         B     AUTHGOOD            ALLOW ACCESS                         00087400
*                                                                       00087500
ENTYERR1 MVC   WORKWTO+4(60),WTOMSG3 PROFS IN ERROR                     00087600
         MVC   WORKWTO+4+WTOMSG3U(L'WTOMSG3U),ACEEUSRI MOVE USERID      00087700
         WTO   MF=(E,WORKWTO)      WRITE IT                             00087800
         MVC   WORKWTO+4(60),WTOMSGE ENTITY SKELETON                    00087900
         MVC   WORKWTO+4(9),=C'RAKF0009 ' USERID/CLASS                  00088000
         BAL   R4,ENTYENTY         ENTY COMMON                          00088100
         B     AUTHGOOD            ALLOW ACCESS                         00088200
*                                                                       00088300
ENTYWARN OI    WORKENTY,4          RC = 4                               00088400
         TM    WORKFLAG,WORKNLOG   NO LOG REQUESTED?                    00088500
         BO    AUTHWARN            SORRY ....                           00088600
         MVC   WORKWTO+4(60),WTOMSG8 INVALID ACCESS TO RESOURCE         00088700
         WTO   MF=(E,WORKWTO)      WRITE IT                             00088800
         MVC   WORKWTO+4(60),WTOMSGE ENTITY SKELETON                    00088900
         MVC   WORKWTO+4(9),=C'RAKF000B ' USERID/CLASS                  00089000
         BAL   R4,ENTYENTY         ENTY COMMON                          00089100
         B     AUTHGOOD            ALLOW ACCESS                         00089200
*                                                                       00089300
ENTYFAIL OI    WORKENTY,8          RC = 8                               00089400
         TM    WORKFLAG,WORKNLOG   NO LOG REQUESTED?                    00089500
         BO    AUTHFAIL            SORRY ....                           00089600
         MVC   WORKWTO+4(60),WTOMSG5 INVALID ACCESS TO RESOURCE         00089700
         WTO   MF=(E,WORKWTO)      WRITE IT                             00089800
         MVC   WORKWTO+4(60),WTOMSGE ENTITY SKELETON                    00089900
         MVC   WORKWTO+4(9),=C'RAKF000A ' USERID/CLASS                  00090000
         BAL   R4,ENTYENTY         ENTY COMMON                          00090100
         B     AUTHFAIL            FAIL ACCESS                          00090200
*                                                                       00090300
ENTYENTY MVC   WORKWTO+4+WTOMSGEU(L'WTOMSGEU),ACEEUSRI MOVE USERID      00090400
         MVC   WORKWTO+4+WTOMSGEC(L'WTOMSGEC),WORKCLAS MOVE CLASS       00090500
         L     R2,PSAAOLD          ASCB ADDRESS                         00090600
         ICM   R3,B'1111',ASCBJBNI-ASCB(R2) JOBNAME SPEC.?              00090700
         BNZ   ENTYJOBN            YES, GO USE NAME                     00090800
         L     R3,ASCBJBNS-ASCB(R2) STC ... NAME                        00090900
ENTYJOBN MVC   WORKWTO+4+WTOMSGEJ(L'WTOMSGEJ),0(R3) MOVE JOBNAME        00091000
         XR    R1,R1               Entity length                   @rp2 00091100
         IC    R1,WORKENTL         Saved entity length             @rp2 00091200
         LTR   R1,R1               Length is zero?                 @rp2 00091300
         BZ    ENTYWTO1            Yes: assume some lengths        @rp2 00091400
         BCTR  R1,0                Minus 1 for EX                  @rp2 00091500
         B     ENTYWTO2            Set ENTITY in WTO               @rp2 00091600
ENTYWTO1 L     R1,WORKSTAT+4       Default entity len from RACSTAT @rp2 00091700
         BCTR  R1,0                Minus 1 for EX instruction      @rp2 00091800
         LA    R2,L'WTOMSGEE-1     Maximum room in WTO             @rp2 00091900
         CR    R2,R1               Too long?                       @rp2 00092000
         BH    ENTYWTO2            No: good                        @rp2 00092100
         LR    R1,R2               Yes: truncate                   @rp2 00092200
ENTYWTO2 EX    R1,ENTYERRX         MVC WORKWTO+4+WTOMSGEE(0),0(ENTYREG) 00092300
         WTO   MF=(E,WORKWTO)      WRITE IT                             00092400
         BR    R4                  RETURN                               00092500
*                                                                       00092600
ENTYERRX MVC   WORKWTO+4+WTOMSGEE(0),0(ENTYREG) MOVE ENTITY             00092700
*                                                                  @rp2 00092800
*        Report unknown CLASS                                      @rp2 00092900
*                                                                  @rp2 00093000
WTOUNKN  MVC   WORKWTO(REALWTOL),REALWTO Initialize WTO            @rp2 00093100
         MVC   WORKWTO+4(60),WTOMSG12 Move message                 @rp2 00093200
         MVC   WORKWTO+4+WTMSG12C(8),WORKCLAS   Move class name    @rp2 00093300
         WTO   MF=(E,WORKWTO)      Inform operator                 @rp2 00093400
         BR    R10                 Return                          @rp2 00093500
*                                                                       00093600
*                                                                       00093700
* Report when hardcoded STC account is used                             00093800
*                                                                       00093900
WTOSTC   MVC   WORKWTO(REALWTOL),REALWTO INIT WTO                       00094000
         MVC   WORKWTO+4(60),WTOMSG10 MOVE MESSAGE                      00094100
         ICM   R2,B'1111',X'C'(R8) GET STC PROC NAME PTR                00094200
         BZ    WTOSTC1             NO PROC NAME                         00094300
         MVC   WORKWTO+4+WTMSG10P(8),0(R2) MOVE PROC NAME               00094400
WTOSTC1  WTO   MF=(E,WORKWTO)      ISSUE MESSAGE                        00094500
         BR    R10                 RETURN                               00094600
*                                                                       00094700
* Report when hardcoded PROD account is used                            00094800
*                                                                       00094900
WTOPROD  MVC   WORKWTO(REALWTOL),REALWTO INIT WTO                       00095000
         MVC   WORKWTO+4(60),WTOMSG11 MOVE MESSAGE                      00095100
         ICM   R2,B'1111',PSAAOLD  GET ASCB                             00095200
         BZ    WTOPROD1            NO ASCB                              00095300
         ICM   R2,B'1111',ASCBJBNI-ASCB(R2)  Point to jobname           00095400
         BZ    WTOPROD1            No Jobname                           00095500
         MVC   WORKWTO+4+WTMSG11J(8),0(R2) Move Jobname                 00095600
WTOPROD1 WTO   MF=(E,WORKWTO)      ISSUE MESSAGE                        00095700
         BR    R10                 RETURN                               00095800
*                                                                       00095900
         TITLE 'CONSTANTS AND SUCH'                                     00096000
         LTORG                                                          00096100
*                                                                       00096200
STCUID   DC    AL4(0),X'03',CL8'STC',X'08',C'STCGROUP'                  00096300
STCPASS  DC    X'08251C06253A1F362D',C'Y'                               00096400
STCGROUP DC    AL4(0),AL1(8),CL8'STCGROUP'                              00096500
PRODUID  DC    AL4(0),X'04',CL8'PROD',X'08',C'PRDGROUP'                 00096600
PRODPASS DC    X'08251C06253A1F362D',C'N'                               00096700
PRDGROUP DC    AL4(0),AL1(8),CL8'PRDGROUP'                              00096800
*                                                                       00096900
REALWTO  WTO   '1234567 101234567 201234567 301234567 401234567 5012345X00097000
               67 60',MF=L                                              00097100
REALWTOL EQU   *-REALWTO           LENGTH                               00097200
*                                                                       00097300
WTOMSG1  DC    CL60'RAKF0001 USERID TABLE INVALID OR MISSING'           00097400
WTOMSG2  DC    C'RAKF0002 STC ACCESS ALLOWED: USER:'                    00097500
WTOMSG2U EQU   *-WTOMSG2,8                                              00097600
         DC    CL8' ',CL(60-(*-WTOMSG2))' '                             00097700
WTOMSG3  DC    C'RAKF0003 RESOURCE TABLE INVALID/MISSING: ALLOWED:'     00097800
*        DC    C': USER ALLOWED:'                                       00097900
WTOMSG3U EQU   *-WTOMSG3,8                                              00098000
         DC    CL8' ',CL(60-(*-WTOMSG3))' '                             00098100
WTOMSG4  DC    C'RAKF0004 INVALID ATTEMPT TO ACCESS SYSTEM:  USER:'     00098200
WTOMSG4U EQU   *-WTOMSG4,8                                              00098300
         DC    CL8' ',CL(60-(*-WTOMSG4))' '                             00098400
WTOMSG5  DC    CL60'RAKF0005 INVALID ATTEMPT TO ACCESS RESOURCE'        00098500
WTOMSG7  DC    C'RAKF0007 ACCESS ALLOWED VIA OPERATIONS:  USER:'        00098600
WTOMSG7U EQU   *-WTOMSG7,8                                              00098700
         DC    CL8' ',CL(60-(*-WTOMSG7))' '                             00098800
WTOMSG8  DC    CL60'RAKF0008 UNDEFINED RESOURCE - ACCESS ALLOWED'       00098900
WTOMSG10 DC    C'RAKF0010I STC '                                        00099000
WTMSG10P EQU   *-WTOMSG10,8                                             00099100
         DC    CL8' ',C' STARTED USING DEFAULT STC ACCOUNT'             00099200
         DC    CL(60-(*-WTOMSG10))' '                                   00099300
WTOMSG11 DC    C'RAKF0011I JOB '                                        00099400
WTMSG11J EQU   *-WTOMSG11,8                                             00099500
         DC    CL8' ',C' STARTED USING DEFAULT PROD ACCOUNT'            00099600
         DC    CL(60-(*-WTOMSG11))' '                                   00099700
WTOMSG12 DC    C'RAKF0012 UNDEFINED CLASS '                        @rp2 00099800
WTMSG12C EQU   *-WTOMSG12,8                                        @rp2 00099900
         DC    CL8' '                  To contain unknown class    @rp2 00100000
         DC    CL(60-(*-WTOMSG12))' '                              @rp2 00100100
WTOMSGE  DC    C'XXXXXXXXX '                                            00100200
WTOMSGEU EQU   *-WTOMSGE,8                                              00100300
         DC    CL8' ',C','                                              00100400
WTOMSGEJ EQU   *-WTOMSGE,8                                              00100500
         DC    CL8' ',C','                                              00100600
WTOMSGEC EQU   *-WTOMSGE,8                                              00100700
         DC    CL8' ',C','                                              00100800
WTOMSGEE EQU   *-WTOMSGE,20                                             00100900
         DC    CL20' ',CL(60-(*-WTOMSGE))' '                            00101000
         DC    CL133' '                                                 00101100
*                                  spaceholder blanks removed       @02 00101200
         DC    CL23' '             rest of spaceholder blanks       @02 00101300
         TITLE 'REGISTERS AND SUCH'                                     00101400
R0       EQU   0                                                        00101500
R1       EQU   1                                                        00101600
R2       EQU   2                                                        00101700
R3       EQU   3                                                        00101800
R4       EQU   4                                                        00101900
R5       EQU   5                                                        00102000
ENTYREG  EQU   6                                                        00102100
ACEEREG  EQU   7                                                        00102200
R8       EQU   8                                                        00102300
R9       EQU   9                                                        00102400
R10      EQU   10                                                       00102500
R11      EQU   11                                                       00102600
R12      EQU   12                                                       00102700
R13      EQU   13                                                       00102800
R14      EQU   14                                                       00102900
R15      EQU   15                                                       00103000
         PRINT NOGEN                                                    00103100
         TITLE 'DSECTS AND SUCH'                                        00103200
*                                                                       00103300
*        WORKAREA is the area provided by the caller of                 00103400
*        RACROUTE (the WORKA paramer). The maximum length = 512 bytes   00103500
*                                                                       00103600
WORKAREA DSECT                     159 BYTE AREA                   @rp2 00103700
WORKSAVE DS    18F                 Our save area                        00103800
WORKSTAT DS    D                   Parameter for RACSTAT           @rp2 00103900
*                                  Word 1 = address of class name  @rp2 00104000
*                                  Word 2 = Max. length of class   @rp2 00104100
WORKWTO  DS    XL(REALWTOL)        FOR WTO                              00104200
WORKKEY  DS    X                   RACINIT KEY SAVE                     00104300
WORKENTY DS    X                   ENTITY RETURN                        00104400
WORKENTL DS    X                   Entity length                   @rp2 00104500
WORKFLAG DS    X                   FLAG BYTES                           00104600
WORKSUPO EQU   X'80'                  WE SET SUPERVISOR STATE           00104700
WORKNLOG EQU   X'40'                  NO LOG IF FAILURE                 00104800
WORKOPRB EQU   X'20'                  RPE MATCH ON USERID/CLASS         00104900
WORKPASS DS    XL9                 RACINIT LEN/PSWD                     00105000
         ORG   WORKPASS                                                 00105100
WORKCLAS DS    XL8                 RACHECK/DEF/FRAC CLASS               00105200
WORKAUTH DS    X                   RACHECK/DEF/FRAC AUTHORITY REQ.      00105300
         ORG                                                            00105400
         DS    XL(159-(*-WORKAREA)) MAKE SURE                      @rp2 00105500
WORKAREL EQU   *-WORKAREA           S.B 159                        @rp2 00105600
*                                                                       00105700
*        GETMAIN'd scratch for the RAKFPWH password-hash call           00105800
HASHWKD  DSECT                                                          00105900
HWPL     DS    5F                  Parmlist (salt,pw,pwlen,out,work)    00106000
HWPWLEN  DS    F                   Candidate password length            00106100
HWR13    DS    F                   Saved caller save-area pointer       00106200
HWOUT    DS    CL32                Computed SHA-256 hash                00106300
HWSAVE   DS    18F                 Save area for the RAKFPWH call       00106400
HWWORK   DS    CL640               RAKFPWH work area (>= RPWWORKL)      00106500
HASHWKL  EQU   *-HASHWKD           Total length to GETMAIN              00106600
*                                                                       00106700
AUTHDS   DSECT                     USED FOR RETURN FROM SUBS(R10)       00106800
AUTHGOOD DS    F'0'                                                     00106900
AUTHWARN DS    F'0'                                                     00107000
AUTHFAIL DS    F'0'                                                     00107100
*                                                                       00107200
         COPY  CJYUCBLK            USERID CBLK                          00107300
*                                                                       00107400
         COPY  CJYPCBLK            PROFILE CBLK                         00107500
*                                                                       00107600
         COPY  CJYRCVTD            RCVT CBLK                            00107700
*                                                                       00107800
         CVT     DSECT=YES,LIST=NO                                      00107900
         ICHACHKL                                                       00108000
         ICHPRCVT                                                       00108100
         ICHRDDFL                                                       00108200
         ICHSAFP                                                        00108300
         IEFAJCTB                                                       00108400
         IEZJSCB                                                        00108500
         IHAASCB DSECT=YES                                              00108600
         IHAASXB DSECT=YES                                              00108700
         IHACDE                                                         00108800
         IHAPSA  DSECT=YES                                              00108900
         IKJRB   DSECT=YES                                              00109000
         IKJTCB  DSECT=YES,LIST=NO                                      00109100
         IHAACEE                                                        00109200
ACEEL    EQU   *-ACEE                                                   00109300
         END                                                            00109400
