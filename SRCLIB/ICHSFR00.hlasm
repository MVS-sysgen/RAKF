         MVC   ACEELEN,=AL3(ACEEL) LENGTH                               00056600
         MVI   ACEEVRSN,C'1'       VERSION 1                            00056700
         MVC   ACEEUSER,CBLKUSER   USERID                               00056800
         MVC   ACEEGRP,CBLKGRP     GROUP                                00056900
         OI    ACEEFLG1,ACEERACF+ACEECNTL                               00057000
