ICHSFR00 TITLE 'SAF ROUTER - ENTRY FOR ALL SECURITY CALLS'              00000100
* CPARM='XREF(SHORT),RENT,OBJ,NODECK',LPARM='RENT,REUS,MAP'   ICHSFR00  00000200
*      DD DSN=SYS1.MACLIB,DISP=SHR                                      00000300
*      DD DSN=SYS1.AMODGEN,DISP=SHR                                     00000400
*      DD DSN=RAKF.MACLIB,DISP=SHR                                      00000500
ICHSFR00 CSECT                                                          00000600
*                                                                       00000700
**********************************************************************  00000800
*                                                                    *  00000900
*    COPYRIGHT (C) 1991 BY CRAIG J. YASUNA.  ALL RIGHTS RESERVED.    *  00001000
*                                                                    *  00001100
*    THIS SOFTWARE PRODUCT OR ANY OF ITS COMPONENTS MUST NOT BE      *  00001200
*    SOLD, GIVEN, OR OTHERWISE DISTRIBUTED TO ANY OTHER COMPANY      *  00001300
*    WITHOUT THE PRIOR WRITTEN PERMISSION OF:                        *  00001400
*                                                                    *  00001500
*                                  CRAIG J. YASUNA, PRESIDENT        *  00001600
*                                  ENTERPRISE SYSTEMS GROUP          *  00001700
*                                  2 MARC COURT                      *  00001800
*                                  EDISON, NEW JERSEY 08820          *  00001900
*                                                                    *  00002000
*    Function:                                                       *  00002100
*    ICHSFR00 will be invoked from CVTSAF if a RACROUTE is used      *  00002200
*             This is a RACROUTE with the 31 bit address of the      *  00002300
*             installation data, Entity and Class.                   *  00002400
*             ICHSFR00 will be invoked by a branch entry.            *  00002500
*                           -- OR --                                 *  00002600
*    from SVC 130, SVC 131 or SVC 133 if RACHECK, FRACHECK, RACDEF   *  00002700
*    or RACINIT is issued.                                           *  00002800
*    SVC 130 = RACHECK and FRACHECK                                  *  00002900
*    SVC 131 = RACDEF                                                *  00003000
*    SVC 133 = RACINIT                                               *  00003100
*    These SVC's generates a RACROUTE in standard form.              *  00003200
*    So, ICHSFR00 will be invoked.                                   *  00003300
*                                                                    *  00003400
*    ICHSFR00 performs the following functions:                      *  00003500
*             1. RACROUTE REQUEST=VERIFY/RACINIT.                    *  00003600
*             2. RACROUTE REQUEST=AUTH/RACHECK.                      *  00003700
*             3. RACROUTE REQUEST=FASTAUTH/FRACHECK.                 *  00003800
*             4. RACROUTE REQUEST=DEFINE/RACDEF.                     *  00003900
*                                                                    *  00004000
*   !!!!! DO NOT RENUMBER !!!!! enter NUMBER OFF before editing      *  00004100
*                               But better is letting SMP doing      *  00004200
*                               the EDIT.                            *  00004300
*                                                                    *  00004400
**********************************************************************  00004500
*                                                                   @02 00004600
*    Change History                                                 @02 00004700
*                                                                   @02 00004800
*    2011/04/03 TRKF120 base version                                @02 00004900
*    2011/04/26 RRKF002 introduce change history                    @02 00005000
*                       enable end users to change their passwords  @02 00005100
*                       permanently: store user's password change   @02 00005200
*                       request in fetch protected CSA and pass the @02 00005300
*                       request address to RAKFPWUP which queues it @02 00005400
*                       for replacement in the RAKF users table     @02 00005500
*                       at next run of RAKFUSER                     @02 00005600
*                                                                   @02 00005700
*    2026/02/28 RRKF005 Two users, STC and PROD, were hard coded    @05 00005800
*                       in to RAKF with a username and password     @05 00005900
*                       added to the user table. These have since   @05 00006000
*                       been updated so that they can't be used     @05 00006100
*                       interactively, a new WTO has been added also@05 00006200
*                                                                   @02 00006300
*    2026/09/23 @mg1    Test if first qualifier really match with  @mg1 00006400
*                       UserID. Test the '.' after first qualifier @mg1 00006500
*                                                                   @02 00006600
*    2026/09/25 @rp2    The places of the ENTITY names and CLASS   @rp2 00006700
*               (RobP)  in the RACF parameter list (ICHACHKL) are  @rp2 00006800
*                       differs between a RACHECK/FRACHECK         @rp2 00006900
*                       and the embedded RACF parameter list       @rp2 00007000
*                       in the RACROUTE parameter.                 @rp2 00007100
*                       Use the 31 bit addresses if a RACROUTE     @rp2 00007200
*                       macro is used (flag ACHK31IN)              @rp2 00007300
*                                                                  @rp2 00007400
*                       Invoke RACSTAT (RCVTREXP) to check if the  @rp2 00007500
*                       class is in the Class Descriptor table     @rp2 00007600
*                       (CDT) pointed to by RCVTCDTP.              @rp2 00007700
*                                                                  @rp2 00007800
*                       Permit all resources in the TAPEVOL class  @rp2 00007900
*                       if the user has the OPERATIONS authority   @rp2 00008000
*                                                                  @rp2 00008100
*                       Turn on ACEESPEC if the user has the       @rp2 00008200
*                       SPECIAL authority and move the APPL        @rp2 00008300
*                       from RACINIT into field ACEEAPLN in ACEE.  @rp2 00008400
*                                                                  @rp2 00008500
*                       Check if a UserID is specified if the      @rp2 00008600
*                       requester of RACROUTE REQUEST=VERYFY       @rp2 00008700
*                       or RACINIT with ENVIR=CREATE for a         @rp2 00008800
*                       started TASK. If found create an ACEE      @rp2 00008900
*                       of the STC with the specified UserID and   @rp2 00009000
*                       GROUP. If not found use UserID=STC and     @rp2 00009100
*                       GROUP=STCGROUP.                            @rp2 00009200
*                                                                  @rp2 00009300
********************************************************************@02 00009400
*                                                                       00009500
         USING AUTHDS,R10                                               00009600
         SAVE  (14,12),,ICHSFR00.&SYSDATE..&SYSTIME                     00009700
         LR    R12,R15                                                  00009800
         LA    R11,2048(,R12)      SECOND BASE (COVERS 4096-8191)       00009900
         LA    R11,2048(,R11)      R11 = ICHSFR00 + 4096                00010000
         USING ICHSFR00,R12,R11    Base registers                  @rp2 00010100
         USING ACEE,ACEEREG        ADDRESS ACEE                         00010200
         USING PSA,0               ADDRESS PSA                          00010300
         L     R9,24(R1)           Address exit work area (WORKA)       00010400
         USING WORKSAVE,R9         ... Base our save area          @rp2 00010500
         XC    WORKAREA(WORKAREL),WORKAREA CLEAR WORKAREA               00010600
         ST    R13,WORKSAVE+4      Backward pointer                @rp2 00010700
         ST    R9,8(,R13)          Forward pointer                 @rp2 00010800
         LR    R13,R9              ADDRESS SAVE AREA                    00010900
         DROP  R9                                                       00011000
         USING WORKSAVE,R13        ... HELLO SAVE AREA                  00011100
         MVC   WORKWTO,REALWTO     MOVE WTO SKEL                        00011200
*                                                                       00011300
STRTROUT LR    R9,R1               GET ADDR. OF SAF PARAMETER LIST      00011400
         USING SAFP,R9             BASE FOR SAFP PARAMETER LIST         00011500
         LA    R2,SAFPAU           RACHECK                              00011600
         CH    R2,SAFPREQT         CHECK REQUEST TYPE                   00011700
         BE    RACHECK             YES, GO ON                           00011800
         LA    R2,SAFPFAU          FRACHECK                             00011900
         CH    R2,SAFPREQT         CHECK REQUEST TYPE                   00012000
         BE    FRACHECK            YES, GO ON                           00012100
         LA    R2,SAFPDEF          RACDEF                               00012200
         CH    R2,SAFPREQT         CHECK REQUEST TYPE                   00012300
         BE    RACDEF              YES, GO ON                           00012400
         LA    R2,SAFPVER          RACINIT                              00012500
         CH    R2,SAFPREQT         CHECK REQUEST TYPE                   00012600
         BE    RACINIT             YES, GO ON                           00012700
         LA    R2,SAFPEXT          RACXTRT                              00012800
         CH    R2,SAFPREQT         CHECK REQUEST TYPE                   00012900
         BE    RACXTRT             YES, GO ON                           00013000
         LA    R2,SAFPLIS          RACLIST                              00013100
         CH    R2,SAFPREQT         CHECK REQUEST TYPE                   00013200
         BE    RTRNGOOD            YES, GO ON                           00013300
         B     RTRN0000            GO AWAY                              00013400
         TITLE 'RACHECK PROCESSING (EXISTING RESOURCE) '                00013500
*---------------------------------------------------------------------* 00013600
*        RACHECK or RACROUTE REQUEST=AUTH from the caller.              00013700
*        If the caller uses a RACROUTE, the flag ACHK31IN is            00013800
*        set, telling you that the ENTITY and CLASS are in              00013900
*        a different place in the RACHECK parameter list.               00014000
*---------------------------------------------------------------------* 00014100
RACHECK  L     R8,SAFPRACP         OFFSET TO RACHECK PARAMETER LIST     00014200
         AR    R8,R9               ADDR. OF RACHECK PARAMETER LIST.     00014300
         USING ACHKLIST,R8                                              00014400
RACHLN31 XR    R2,R2               CLEAR R2                             00014500
         XR    ENTYREG,ENTYREG     Clear entity register           @rp2 00014600
         TM    ACHKFLG1,ACHK31IN   Are the 31 bit addresses used?  @rp2 00014700
         BZ    RACHNC31            No: take the old address        @rp2 00014800
         ICM   ENTYREG,B'1111',ACHKEN31 Get entity from 31 bit fld @rp2 00014900
         ICM   R2,B'1111',ACHKCL31 Get CLASS from 31 bit field     @rp2 00015000
         BNZ   RACHACEE            Found --> continue              @rp2 00015100
         LA    R2,RACDDSNC         use our DSN CLASS               @rp2 00015200
         B     RACHACEE            Carry on                        @rp2 00015300
RACHNC31 ICM   ENTYREG,B'0111',ACHKENT GET ENTITY                       00015400
         ICM   R2,B'0111',ACHKCLN  GET CLASS                            00015500
         BNZ   RACHACEE            found --> continue                   00015600
         LA    R2,RACDDSNC         use our DSN CLASS                    00015700
*                                                                       00015800
RACHACEE MVC   WORKCLAS,=CL8' '    BLANK IT OUT                         00015900
         IC    R1,0(R2)            Length of class                      00016000
         BCTR  R1,0                Minus 1 for EX                       00016100
         EX    R1,RACHMVCC         MVC WORKCLAS(0),1(R2)                00016200
         CLC   WORKCLAS(8),=CL8' ' CLASS blank?                         00016300
         BNE   RACHNBLK               --> no, continue                  00016400
         MVC   WORKCLAS,=CL8'DATASET' --> yes, assume DATASET           00016500
RACHNBLK ICM   ACEEREG,B'1111',ACHKACEE POINT TO ACEE                   00016600
         BNZ   RACHCHCK            NO ACEE -> ALLOW ACCES               00016700
         L     R2,PSAAOLD          OUR ASCB                             00016800
         L     R2,ASCBASXB-ASCB(R2) OUR ASXB                            00016900
         ICM   ACEEREG,B'1111',ASXBSENV-ASXB(R2) ACEE                   00017000
         BZ    RACHGOOD            WHO KNOWS                            00017100
RACHCHCK IC    R2,ACHKFLG2         GET AUTH. REQ.                       00017200
         SLL   R2,3                CONFORM TO RACDEF                    00017300
         STC   R2,WORKAUTH         SAVE IT                              00017400
         OC    WORKAUTH,ACHKFLG2   ADD BACK X'80'                       00017500
         NI    WORKAUTH,X'F0'      TURN OFF LOW ORDER                   00017600
*                                                                       00017700
         TM    ACHKFLG1,ACHKLOGS   LOG SUPPRESSED?                      00017800
         BZ    RACHCHK1            DO ENTITY CHECK                      00017900
         OI    WORKFLAG,WORKNLOG   SUPPRESS LOG                         00018000
*                                                                       00018100
RACHCHK1 BAL   R10,ENTYCHCK        GO DO ENTITY CHECK                   00018200
         B     RACHGOOD            GOOD RETURN                          00018300
         B     RACHUNKN            RC4 - UNKN                           00018400
         B     RACHFAIL            RC8 - FAIL                           00018500
RACHMVCC MVC   WORKCLAS(0),1(R2)   MOVE CLASS << executed >>            00018600
*                                                                       00018700
RACHGOOD XC    SAFPRRET,SAFPRRET   NOTHING ...                          00018800
         XC    SAFPRREA,SAFPRREA   NOTHING ...                          00018900
         B     RTRNGOOD            GO TO RC 200 CODE                    00019000
*                                                                       00019100
RACHUNKN MVC   SAFPRRET,=F'04'     NOT PROTECTED ...                    00019200
         XC    SAFPRREA,SAFPRREA   NOTHING ...                          00019300
         B     RTRNWARN            GO TO RC 204 CODE                    00019400
*                                                                       00019500
RACHFAIL MVC   SAFPRRET,=F'08'     FAIL ....                            00019600
         XC    SAFPRREA,SAFPRREA   NOTHING ...                          00019700
         B     RTRNFAIL            DO ANY EXCEPTIONS                    00019800
         TITLE 'FRACHECK PROCESSING (EXISTING RESOURCE IN-CORE) '       00019900
*---------------------------------------------------------------------* 00020000
*        FRACHECK or RACROUTE REQUEST=FASTAUTH from the caller.         00020100
*---------------------------------------------------------------------* 00020200
FRACHECK L     R8,SAFPRACP         OFFSET TO RACHECK PARAMETER LIST     00020300
         AR    R8,R9               ADDR. OF RACHECK PARAMETER LIST.     00020400
         L     R2,ACHKCLNW         Class FRACHECK                  @rp2 00020500
         LA    R2,0(,R2)           Clear high order byte           @rp2 00020600
         L     ENTYREG,ACHKENTW    Get FRACHECK entity             @rp2 00020700
         LA    ENTYREG,0(,ENTYREG) Clear high order byte           @rp2 00020800
         TM    ACHKFLG1,ACHK31IN   Invoked from RACROUTE?          @rp2 00020900
         BNO   FRACCN31            No: we are invoked from FRACHECK@rp2 00021000
         L     R2,ACHKCL31         Take 31 bit addr from RACROUTE  @rp2 00021100
         L     ENTYREG,ACHKEN31    Take 31 bit addr from RACROUTE  @rp2 00021200
FRACCN31 MVC   WORKCLAS,0(R2)      Move class                           00021300
         ICM   ACEEREG,B'1111',ACHKACEE Point to ACEE              @rp2 00021400
         BNZ   FRACCHCK            GO DO CHECK                          00021500
         L     R2,PSAAOLD          OUR ASCB                             00021600
         L     R2,ASCBASXB-ASCB(R2) OUR ASXB                            00021700
         ICM   ACEEREG,B'1111',ASXBSENV-ASXB(R2) ACEE                   00021800
         BZ    FRACUNKN            UNKNOWN                              00021900
FRACCHCK IC    R2,0(R8)            GET AUTH. REQ.                       00022000
         SLL   R2,3                CONFORM TO RACDEF                    00022100
         STC   R2,WORKAUTH         SAVE IT                              00022200
         OC    WORKAUTH,0(R8)      ADD BACK X'80'                       00022300
         NI    WORKAUTH,X'F0'      TURN OFF LOW ORDER                   00022400
         BAL   R10,ENTYCHCK        GO DO ENTITY CHECK                   00022500
         B     FRACGOOD            GOOD RETURN                          00022600
         B     FRACUNKN            RC4 - UNKN                           00022700
         B     FRACFAIL            RC8 - FAIL                           00022800
*                                                                       00022900
FRACGOOD XC    SAFPRRET,SAFPRRET   NOTHING ...                          00023000
         XC    SAFPRREA,SAFPRREA   NOTHING ...                          00023100
         B     RTRNGOOD            GO TO RC 200 CODE                    00023200
FRACUNKN MVC   SAFPRRET,=F'04'     NOT PROTECTED ...                    00023300
         XC    SAFPRREA,SAFPRREA   NOTHING ...                          00023400
         B     RTRNWARN            GO TO RC 204 CODE                    00023500
FRACFAIL MVC   SAFPRRET,=F'08'     FAIL ....                            00023600
         XC    SAFPRREA,SAFPRREA   NOTHING ...                          00023700
         B     RTRNFAIL            DO ANY EXCEPTIONS                    00023800
         TITLE 'RACDEF PROCESSING (NEW RESOURCE) '                      00023900
*---------------------------------------------------------------------* 00024000
*        RACDEF or RACROUTE REQUEST=DEFINE from the caller.             00024100
*---------------------------------------------------------------------* 00024200
RACDEF   L     R8,SAFPRACP         OFFSET TO RACDEF  PARAMETER LIST     00024300
         AR    R8,R9               ADDR. OF RACDEF PARAMETER LIST.      00024400
         USING RDDFLIST,R8                                              00024500
         XC    SAFPRRET,SAFPRRET   PRIME RC/REAS = 0                    00024600
         XC    SAFPRREA,SAFPRREA   PRIME RC/REAS = 0                    00024700
         TM    RDDFFLGS,RDDFTDEL+RDDFNEWN DELETE OR NEWNAME             00024800
         BZ    RACDNDEL            NOT DELETE                           00024900
         TM    RDDFFLG2,RDDFCHKA   CHECKAUTH SPEC.?                     00025000
         BZ    RACDGOOD            NO, RC=0                             00025100
*                                                                       00025200
RACDNDEL XR    ENTYREG,ENTYREG     CLEAR ENTYREG                        00025300
         XR    R2,R2               Clear R2 (to contain CLASS)     @rp2 00025400
         TM    RDDFFLGS,RDDF31IN   31 bit mode from RACROUTE?           00025500
         BO    RACDGCLS            Yes: take from 31 bit segment   @rp2 00025600
         ICM   ENTYREG,B'0111',RDDFENT Get entity name                  00025700
         ICM   R2,B'0111',RDDFCLNW CLASS ???                            00025800
         BNZ   RACDACEE            Yes: carry on                   @rp2 00025900
         LA    R2,RACDDSNC         Use our DATASET class           @rp2 00026000
         B     RACDACEE            Carry on                        @rp2 00026100
RACDGCLS ICM   ENTYREG,B'1111',RDDFEN31 Get entity from 31 bit     @rp2 00026200
         ICM   R2,B'0111',RDDFCLNW Get class                       @rp2 00026300
         BNZ   RACDACEE            We have the CLASS               @rp2 00026400
         LA    R2,RACDDSNC         Use our DATASET class           @rp2 00026500
RACDACEE MVC   WORKCLAS,=CL8' '    BLANK IT OUT                         00026600
         IC    R1,0(R2)            LENGTH                               00026700
         BCTR  R1,0                SUB 1 FOR MVC                        00026800
         EX    R1,RACDMVCC         MVC WORKCLAS(0),1(R2)                00026900
         CLC   WORKCLAS(8),=CL8' ' CLASS blank?                         00027000
         BNE   RACDNBLK               --> no, continue                  00027100
         MVC   WORKCLAS,=CL8'DATASET' --> yes, assume DATASET           00027200
RACDNBLK ICM   ACEEREG,B'1111',RDDFACEE POINT TO ACEE                   00027300
         BNZ   RACDCHCK            GO CHECK                             00027400
         L     R2,PSAAOLD          OUR ASCB                             00027500
         L     R2,ASCBASXB-ASCB(R2) OUR ASXB                            00027600
         ICM   ACEEREG,B'1111',ASXBSENV-ASXB(R2) ACEE                   00027700
         BZ    RACDGOOD            WHO KNOWS                            00027800
RACDCHCK MVI   WORKAUTH,RACFALTR   MOVE AUTH REQ.                       00027900
*                                                                       00028000
         TM    RDDFFLG2,RDDFRFI    RACFIND IND?                         00028100
         BZ    RACDCHK1            NO, DO ENTITY CHECK                  00028200
         OI    WORKFLAG,WORKNLOG   YES, SUPPRESS LOG                    00028300
*                                                                       00028400
RACDCHK1 BAL   R10,ENTYCHCK        GO DO ENTITY CHECK                   00028500
         B     RACDNEW             GOOD RETURN - CHECK RENAME           00028600
         B     RACDNEW             RC4 - UNKN                           00028700
         B     RACDFAIL            RC8 - FAIL                           00028800
RACDMVCC MVC   WORKCLAS(0),1(R2)   MOVE CLASS                           00028900
RACDDSNC DC    X'07',CL8'DATASET'  DATASET CLASS                        00029000
*                                                                       00029100
RACDNEW  TM    RDDFFLGS,RDDFNEWN   NEWNAME SPEC?                        00029200
         BNO   RACDCK18            CHECK 1.8 STUFF                      00029300
         L     ENTYREG,RDDFNNAM    LOAD NEWNAME                         00029400
         BAL   R10,ENTYCHCK        GO DO ENTITY CHECK                   00029500
         B     RACDCK18            CHECK 1.8 STUFF                      00029600
         B     RACDCK18            CHECK 1.8 STUFF                      00029700
         B     RACDFAIL            RC8 - FAIL                           00029800
*                                                                       00029900
RACDCK18 EQU   *                                                        00030000
*                                                                       00030100
RACDCMCL EQU   *                                                        00030200
         B     RACDGOOD            RC4 - UNKN                           00030300
*                                                                       00030400
RACDGOOD TM    WORKENTY,8          RC=8                                 00030500
         BO    RACDFAIL            BYPASS RC=4                          00030600
RACDNVFY TM    WORKENTY,4          RC=4                                 00030700
         BO    RACDUNKN            AT LEAST 1 WARN                      00030800
         TM    RDDFFLGS,RDDFCHGV   DELETE OR ADD                        00030900
         BNZ   RACDGDD0            GOOD 0                               00031000
         TM    RDDFFLG2,RDDFRFIY   RACFIND=YES                          00031100
         BO    RACDGDD0            --> Yes, RC=0                        00031200
         TM    RDDFFLG2,RDDFRFI    RACFIND=NO                           00031300
         BNO   RACDGDD0            --> No, RC=0                         00031400
         MVC   SAFPRREA,=F'04'     --> Yes, RC=0 & Reason=4             00031500
RACDGDD0 XC    SAFPRRET,SAFPRRET   NOTHING ...                          00031600
         B     RTRNGOOD            GO TO RC 200 CODE                    00031700
*                                                                       00031800
RACDUNKN MVC   SAFPRRET,=F'04'     NOT PROTECTED ...                    00031900
         XC    SAFPRREA,SAFPRREA   NOTHING ...                          00032000
         B     RTRNWARN            GO TO RC 204 CODE                    00032100
*                                                                       00032200
RACDFAIL MVC   SAFPRRET,=F'08'     FAIL ....                            00032300
         B     RTRNFAIL            DO ANY EXCEPTIONS                    00032400
         TITLE 'RACXTRT CODE - RETRIEVE DATA FROM PROFILE'              00032500
RACXTRT  L     R8,SAFPRACP         OFFSET TO RACXTRT PARAMETER LIST     00032600
         AR    R8,R9               ADDR. OF RACXTRT PARAMETER LIST.     00032700
         TM    3(R8),X'01'         EXTRACT ...                          00032800
         BO    RACXEXTR            GO ON                                00032900
         TM    3(R8),X'03'         EXTRACTN...                          00033000
         BO    RACXEXTR            GO ON                                00033100
         B     RACXUNKN            NOT YET SUPPORTED ...                00033200
*                                                                       00033300
RACXEXTR XR    R2,R2               CLEAR R2                             00033400
         LH    R2,6(R8)            GET OFFSET TO VARIABLE STUFF.        00033500
         AR    R2,R8               ADD BEGINNING OF RACXTRT             00033600
         ICM   R3,B'1111',0(R2)    GET CLASS ADDRESS                    00033700
         BZ    RACXUNKN            NONE ....                            00033800
         CLC   =C'USER',0(R3)      USER CLASS ????                      00033900
         BNE   RACXUNKN            NO, NOT SUPPORTED                    00034000
*                                                                       00034100
         ICM   R3,B'1111',8(R8)    GET ENTITY ADDRESS                   00034200
         BNZ   RACXENTY            GOT ENTITY(USERNAME)                 00034300
         ICM   ACEEREG,B'1111',X'14'(R2) ACEE REQ?                      00034400
         BNZ   RACXACEE            GO ON...                             00034500
         L     R3,PSAAOLD-PSA(0)   OUR ASCB                             00034600
         L     R3,ASCBASXB-ASCB(R3) OUR ASXB                            00034700
         ICM   ACEEREG,B'1111',ASXBSENV-ASXB(R3) ACEE                   00034800
         BZ    RACXUNKN            WHO KNOWS                            00034900
RACXACEE LA    R3,ACEEUSRI         GET ACEEUSER                         00035000
RACXENTY ICM   R8,B'1111',X'0C'(R2) CHECK SEGMENT                       00035100
         BZ    RACXUNKN            BASE NOT SUPPORTED                   00035200
         CLC   =C'TSO',0(R8)       TSO SEGMENT?                         00035300
         BNE   RACXUNKN            NO, NOT SUPPORTED                    00035400
         B     RACXUNKN            GO THERE ANYWAY                      00035500
*        FIELDS ...                                                     00035600
*  GETMAIN AREA IN SP... & RETURN IN ...                                00035700
*                                                                       00035800
RACXUNKN MVC   SAFPRRET,=F'08'     NOT PROTECTED ...                    00035900
         XC    SAFPRREA,SAFPRREA   NOTHING ...                          00036000
         B     RTRNWARN            GO TO RC 208 CODE                    00036100
*                                                                       00036200
         TITLE 'RACINIT PROCESS. (GET INTO/OUT OF SYSTEM) - CHECK AUTH' 00036300
*---------------------------------------------------------------------* 00036400
*        RACINIT or RACROUTE REQUEST=VERIFY from the caller.            00036500
*---------------------------------------------------------------------* 00036600
RACINIT  L     R8,SAFPRACP         OFFSET TO RACINIT PARAMETER LIST     00036700
         AR    R8,R9               ADDR. OF RACINIT PARAMETER LIST.     00036800
         TM    3(R8),X'C0'         TEST FOR VERIFY                      00036900
         BO    RTRN0000            ENVIR=VERIFY USED BY JES2 EARLY VFY  00037000
*                                                                       00037100
         L     R2,PSATOLD          ADDRESS TCB                          00037200
         L     R2,TCBRBP-TCB(R2)   ADDRESS RB                           00037300
         TM    RBSTAB1-RBSECT(R2),RBFTP CHECK RBTYPE                    00037400
         BZ    RACIRACR            PRB DID RACROUTE                     00037500
*                                                                       00037600
         XR    R3,R3               CLEAR R3                             00037700
         ICM   R3,B'0111',RBLINKB-RBSECT(R2) PRIOR RB                   00037800
         S     R3,=A(RBSECT-RBPREFIX) SUBTRACT PFIX LENG                00037900
         CLI   RBINTCOD-RBPREFIX+1(R3),X'83' SVC 131 (RACINIT SVC)      00038000
         BNE   RACIRACR            SVC ISSUED RACROUTE                  00038100
*                                                                       00038200
         ICM   R2,B'0111',RBLINKB-RBSECT(R2) PRIOR RB                   00038300
         TM    RBSTAB1-RBSECT(R2),RBFTP PRB?????                        00038400
         BNZ   RACINAUT            NO, DON'T BOTHER WITH TABLE          00038500
*                                                                       00038600
         ICM   R2,B'0111',RBCDE1-RBSECT(R2) PRIOR RB                    00038700
         BZ    RACINAUT            NO CDE                               00038800
         L     R3,FLCCVT           LOAD CVT                             00038900
         ICM   R3,B'1111',CVTRAC-CVTMAP(R3) CHECK RCVT                  00039000
         BZ    RACIERR1            WHO KNOWS                            00039100
         ICM   R3,B'1111',RCVTAUTP-RCVT(R3) CHECK AUTHORIZED CALLERS    00039200
         BZ    RACINAUT            NO TABLE                             00039300
*                                                                       00039400
RACIAUTL CLC   =F'0',0(R3)         END OF TABLE?                        00039500
         BE    RACINAUT            YES, SORRY                           00039600
         CLC   CDNAME-CDENTRY(,R2),0(R3) IS THIS US?                    00039700
         BE    RACIMDST            YES, BYPASS TESTAUTH                 00039800
         LA    R3,12(,R3)          NEXT ENTRY                           00039900
         B     RACIAUTL            GO ON                           @rp1 00040000
*                                                                       00040100
RACINAUT TESTAUTH FCTN=1,STATE=YES,KEY=YES    APF/SUP/KEY0-7            00040200
         LTR   R15,R15             GOT IT?                              00040300
         BZ    RACIMDST            YES, GO ON                           00040400
         ABEND 1667,,,SYSTEM       Abend S683                           00040500
*                                                                       00040600
RACIRACR TESTAUTH FCTN=1,STATE=YES,KEY=YES,RBLEVEL=1 APF/SUP/KEY0-7     00040700
         LTR   R15,R15             GOT IT?                              00040800
         BZ    RACISCHP            YES, GO ON                           00040900
         ABEND 1667,,,SYSTEM       Abend S683                           00041000
*                                                                       00041100
RACISCHP TESTAUTH STATE=YES,RBLEVEL=1 SUPV STATE?                       00041200
         LTR   R15,R15             GOT IT?                              00041300
         BZ    RACIMDST            YES, GO ON                           00041400
         OI    WORKFLAG,WORKSUPO   SUP. ON                              00041500
         MODESET MODE=SUP          SET STATE                            00041600
*                                                                       00041700
RACIMDST MODESET EXTKEY=ZERO,SAVEKEY=WORKKEY,WORKREG=2                  00041800
         TITLE 'RACINIT PROCESS. (GET INTO/OUT OF SYSTEM) '             00041900
         TM    3(R8),X'40'         ENVIR=CHANGE?                   @rp2 00042000
         BO    RACIGOOD            NOT YET SUPPORTED ...                00042100
         TM    3(R8),X'80'         ENVIR=DELETE?                   @rp2 00042200
         BO    RACINDEL            NO, GO DELETE ACEE                   00042300
*                                                                       00042400
         L     R4,FLCCVT           LOAD CVT                             00042500
         ICM   R4,B'1111',CVTRAC-CVTMAP(R4) CHECK RCVT                  00042600
         BZ    RACIERR1            Error: No RCVT                  @rp2 00042700
*---------------------------------------------------------------------* 00042800
*        CJYRCVT contains 2 pointers. 1 = address of users table      * 00042900
*                                     2 = address of profiles table   * 00043000
*---------------------------------------------------------------------* 00043100
         ICM   R4,B'1111',RCVTISTL-RCVT(R4) CJYRCVTD present?      @rp2 00043200
         BZ    RACIERR1            WHO KNOWS                            00043300
         ICM   R4,B'1111',CJYUSERS-CJYRCVTD(R4) Point to user table@rp2 00043400
         BZ    RACIERR1            Not there: error                     00043500
         USING CBLK,R4             Base CJYUCBLK                        00043600
         ICM   R5,B'1111',4(R8)    UserID from RACINIT parmlist    @rp2 00043700
*                                  1 byte length + 8 byte UserID   @rp2 00043800
         BZ    RACINOID            No UserID check for STC (START=)@rp2 00043900
RACICKLP IC    R1,CBLKUSRL         Length of UserID                     00044000
         EX    R1,RACINCLC         CLC CBLKUSER(0),0(R5)                00044100
         BE    RACIIDOK            Yes: UserID OK                  @rp2 00044200
         ICM   R4,B'1111',CBLKNEXT GO TO NEXT ID                        00044300
         BNZ   RACICKLP            GO FOR NEXT                          00044400
         B     RACIREVK            Not in Users table - reject          00044500
RACINCLC CLC   CBLKUSER(0),0(R5)   CORE UID VS RACINIT < executed >@rp2 00044600
*                                                                       00044700
RACIIDOK TM    3(R8),X'08'         PASSCHK=NO in RACINIT parmlist? @rp2 00044800
         BO    RACIACEE            Yes: go make ACEE                    00044900
         ICM   R3,B'1111',8(R8)    Pickup password address              00045000
         BZ    RACIINPW            No password -> invalid               00045100
         MVC   WORKPASS,0(R3)      MOVE PASSWORD (LEN + UP TO 8 CHARS)  00045200
*---------------------------------------------------------------------* 00045300
*        Hash SALT||candidate via RAKFPWH and compare to stored hash  * 00045400
*---------------------------------------------------------------------* 00045500
         GETMAIN RU,LV=HASHWKL     Work area for hashing (key 0 here)   00045600
         LR    R2,R1               R2 -> gotten area                    00045700
         USING HASHWKD,R2                                               00045800
         ST    R13,HWR13           Save caller save-area pointer        00045900
         LA    R0,CBLKSALT         A(salt) - CBLK based on R4           00046000
         ST    R0,HWPL+0                                                00046100
         LA    R0,WORKPASS+1       A(candidate password chars)          00046200
         ST    R0,HWPL+4                                                00046300
         SR    R0,R0                                                    00046400
         IC    R0,WORKPASS         Candidate password length            00046500
         ST    R0,HWPWLEN                                               00046600
         LA    R0,HWPWLEN                                               00046700
         ST    R0,HWPL+8           A(PASSWORD length)                   00046800
         LA    R0,HWOUT                                                 00046900
         ST    R0,HWPL+12          A(output hash)                       00047000
         LA    R0,HWWORK                                                00047100
         ST    R0,HWPL+16          A(RAKFPWH work area)                 00047200
         LA    R1,HWPL             R1 -> parameter list                 00047300
         LA    R13,HWSAVE          Save area for the call               00047400
         L     R15,=V(RAKFPWH)                                          00047500
         BALR  R14,R15             Compute SHA-256(salt||password)      00047600
         L     R13,HWR13           Restore caller save-area pointer     00047700
         CLC   CBLKHASH,HWOUT      Stored Hash vs computed Hash         00047800
         BNE   RACIPWNO            mismatch                             00047900
         LA    R3,1                Passwords do match                   00048000
         B     RACIPWFR                                                 00048100
RACIPWNO LA    R3,0                Passwords dont match                 00048200
RACIPWFR LR    R1,R2               Area to free                         00048300
         DROP  R2                                                       00048400
         FREEMAIN RU,LV=HASHWKL,A=(R1)  Release work area               00048500
         LTR   R3,R3               Matched?                             00048600
         BNZ   RACIPWOK            Yes, password is correct             00048700
         B     RACIINPW            No, invalid password                 00048800
RACIPWOK EQU   *                                                        00048900
RACICHPW EQU   *                                                        00049000
RACINCL2 EQU   *                                                        00049100
*                                                                       00049200
         ICM   R3,15,24(R8)        Set new password in RACINIT PLIST?   00049300
         BZ    RACIACEE            No: go make ACEE                     00049400
         MVC   WORKPASS,0(R3)      Yes, move new password               00049500
         GETMAIN RU,LV=PWUPL,SP=227 Get fetch protected CSA         @02 00049600
         MVC   0(PWUPCMDL,R1),PWUPSTRT move SVC 34 plist to CSA area@02 00049700
         L     R3,PWUPXTBA         Get translate table address      @02 00049800
         USING PWUPSTRT,R1         Address CSA area now             @02 00049900
         ST    R1,PWUPADDR         Store CSA area address for unpack@02 00050000
         UNPK  PWUPUNPK(9),PWUPADDR(5) unpack CSA area address      @02 00050100
         MVC   PWUPAHEX(8),PWUPUNPK unpacked address to SVC 34 plist@02 00050200
         TR    PWUPAHEX(8),0(R3)   Translate address to printable   @02 00050300
         DROP  R1                  Revert to standard addressability@02 00050400
         MVC   PWUPCMDL(PWUPRECL,R1),PWUP initialize change record  @02 00050500
         IC    R3,0(,R5)           Length of user                   @02 00050600
         BCTR  R3,0                Subtract 1 for MVC               @02 00050700
         EX    R3,PWUPMVCU         Copy user                        @02 00050800
         IC    R3,WORKPASS         Length of new password           @02 00050900
         BCTR  R3,0                Subtract 1 for MVC               @02 00051000
         EX    R3,PWUPMVCP         Copy new password                @02 00051100
         XR    R0,R0               Set R0 = 0 for SVC 34            @02 00051200
         SVC   34                  S RAKFPWUP,PARM='PWUPAHEX'       @02 00051300
         XC    WORKPASS+1(8),=C'SECURITY' encrypt                       00051400
         IC    R1,WORKPASS         Length of new password               00051500
         EX    R1,RACIRPWD         Replace password                     00051600
         B     RACIACEE            Go make ACEE                         00051700
PWUPSTRT DC    AL2(PWUPCMDL)       Parameter list to start RAKFPWUP>@02 00051800
         DC    X'0000'              >is copied to CSA subpool 227  >@02 00051900
         DC    C'S RAKFPWUP,PARM=''' >fetch protected storage with >@02 00052000
PWUPAHEX DS    CL8                 >address passed in PARM field  > @02 00052100
         DC    C''''               >in hexadecimal printable format @02 00052200
PWUPCMDL EQU   *-PWUPSTRT          Length of parameter list         @02 00052300
PWUP     DS    0C                  Changes queue record             @02 00052400
PWUPUSER DC    CL8' '              UserID                           @02 00052500
         DC    C' '                Filler                           @02 00052600
PWUPPSWD DC    CL8' '              New password                     @02 00052700
         DC    C' '                Filler                           @02 00052800
PWUPRECL EQU   *-PWUP              Record length of changes queue   @02 00052900
PWUPL    EQU   *-PWUPSTRT          Total length of CSA area         @02 00053000
         ORG   PWUP                Changes queue record is >        @02 00053100
PWUPADDR DS    F                      > temporarily used   >        @02 00053200
         DS    X                      > for conversion of  >        @02 00053300
PWUPUNPK DS    CL8                    > CSA area to        >        @02 00053400
         DS    X                      > unpacked format             @02 00053500
         ORG   PWUP+PWUPRECL       Restore program counter          @02 00053600
         USING PWUPSTRT,R1         Address CSA area now             @02 00053700
PWUPMVCU MVC   PWUPUSER(1),1(R5)   Get user and new password >      @02 00053800
PWUPMVCP MVC   PWUPPSWD(1),WORKPASS+1  > into change queue record   @02 00053900
         DROP  R1                  Revert to standard addressability@02 00054000
PWUPHXTB DC    C'0123456789ABCDEF' Translate RAKFPWUP address to >  @02 00054100
PWUPXTBA DC    A(PWUPHXTB-240)      > hex printable format          @02 00054200
RACIRPWD MVC   CBLKPWDL(1),WORKPASS replace in core password            00054300
RACICKPW CLC   CBLKPWDL(1),WORKPASS check password                      00054400
RACIERR1 MVC   WORKWTO+4(60),WTOMSG1 CJYUSERS INVALID                   00054500
         WTO   MF=(E,WORKWTO)      WRITE IT                             00054600
         MVC   WORKWTO+4(60),WTOMSG2 STC ACCESS                         00054700
         ICM   R5,B'1111',4(R8)    GO TO USERID                         00054800
         IC    R1,0(R5)            GET LENGTH                           00054900
         EX    R1,RACIWTO1         MOVE NAME FOR WTO                    00055000
         WTO   MF=(E,WORKWTO)      WRITE IT                             00055100
         B     RACISSTC            ASSUME STC                           00055200
RACIWTO1 MVC   WORKWTO+5+WTOMSG2U(0),1(R5) MOVE USERID                  00055300
*                                                                       00055400
RACINOID CLC   =F'0',12(R8)        STC (START= specified) in RACINIT?   00055500
         BNE   RACISSTC            Yes: check if a user in table spec.  00055600
         CLC   =F'0',40(R8)        TERMID specified in RACINIT parmlist 00055700
         BNE   RACIREVK            TSO ---- > REVOKED                   00055800
         CLC   =F'0',44(R8)        JOBNAME SPEC.?                       00055900
         BNE   RACISBAT            BATCH, OK ....                       00056000
         ICM   R2,B'1111',PSAAOLD   POINT TO ASCB OLD                   00056100
         BZ    RACISSTC            ASSUME STC                           00056200
         CLC   =F'0',ASCBJBNI-ASCB(R2) JOBNAME SPEC.?                   00056300
         BNE   RACISBAT            BATCH, OK ....                       00056400
*---------------------------------------------------------------------* 00056500
*        Test if the STC (specified with START= in RACINIT) is        * 00056600
*        in the USERS table (pointed to by register 4 and mapped      * 00056700
*        by CBLK in macro CJYUCBLK).                                  * 00056800
*        If present assign a UserID and the GROUP in the ACEE         * 00056900
*        from the Users table entry (CBLK).                           * 00057000
*        If not present, assign UserID=STC and GROUP=STCGROUP.        * 00057100
*---------------------------------------------------------------------* 00057200
RACISSTC DS    0H                                                  @rp2 00057300
         ICM   R1,15,12(R8)        Pickup STC pointer              @rp2 00057400
         MVC   WORKSTC+1(8),0(R1)  Move START= value from RACINIT  @rp2 00057500
         CLI   WORKSTC+1,C' '      Nothing specified?              @rp2 00057600
         BE    RACIESTC            Yes: take default (STC/STCGROUP)@rp2 00057700
         LA    R1,WORKSTC+1        Point to STC procname value     @rp2 00057800
         XR    R2,R2               Count Procname bytes            @rp2 00057900
         LA    R0,8                Loop max 8 times                @rp2 00058000
RACISST2 CLI   0(R1),C' '          Blank found?                    @rp2 00058100
         BE    RACISST3            Yes: all done                   @rp2 00058200
         LA    R1,1(,R1)           Next byte in WORKSTC            @rp2 00058300
         LA    R2,1(,R2)           Count                           @rp2 00058400
         BCT   R0,RACISST2         Loop until all done             @rp2 00058500
RACISST3 STC   R2,WORKSTC          Length byte                     @rp2 00058600
RACISST4 EX    R2,RACISCLC         CLC CBLKUSER(0),WORKSTC         @rp2 00058700
         BE    RACIACEE            Yes: STC has a user in table    @rp2 00058800
         ICM   R4,B'1111',CBLKNEXT Go to next ID in Users table    @rp2 00058900
         BNZ   RACISST4            Test next UserID against STC    @rp2 00059000
         B     RACIESTC            Not in Users table - default    @rp2 00059100
RACISCLC CLC   CBLKUSER(0),WORKSTC Core UID vs START= name         @rp2 00059200
RACIESTC LA    R4,STCUID-L'CBLKNEXT Point to Default STC UserID         00059300
         BAL   R10,WTOSTC          REPORT STC DEFAULT USAGE             00059400
         B     RACIACEE            GO BUILD ACEE                        00059500
RACISBAT LA    R4,PRODUID-L'CBLKNEXT Point to default JOB UserID        00059600
         BAL   R10,WTOPROD         REPORT PROD DEFAULT USAGE            00059700
         B     RACIACEE            GO BUILD ACEE                        00059800
         TITLE 'RACINIT PROCESS. (GET INTO/OUT OF SYSTEM) - BUILD ACEE' 00059900
*---------------------------------------------------------------------* 00060000
*        Build the Accesor Environment Element (ACEE)                 * 00060100
*        From the RACINIT PLIST (pointed to by R8) and the            * 00060200
*        entry in the USERS core table or from PRODUID or STCUID      * 00060300
*        (point to by R4).                                            * 00060400
*---------------------------------------------------------------------* 00060500
RACIACEE LA    R2,255              PRE-FILL WITH LSQA SUBPOOL           00060600
         TM    3(R8),X'10'         Subpool specified?              @rp2 00060700
         BNO   RACINDGM            DO GETMAIN                           00060800
         IC    R2,1(R8)            Subpool number from RACINIT     @rp2 00060900
RACINDGM GETMAIN RC,LV=ACEEL,SP=(R2) DO GETMAIN                         00061000
         LR    ACEEREG,R1          ADDRESS AREA                         00061100
         XC    ACEE(ACEEL),ACEE    CLEAR IT                             00061200
         MVC   ACEEACEE,=C'ACEE'   ACEE NAME                            00061300
         STC   R2,ACEESP           Subpool to GETRAIN              @rp2 00061400
         MVC   ACEEAPLN,=CL8' '    Application name                @rp2 00061500
         ICM   R2,B'1111',48(R8)   APPL specified in RACINIT?      @rp2 00061600
         BZ    *+10                No: leave blank                 @rp2 00061700
         MVC   ACEEAPLN,0(R2)      Move APPL name                  @rp2 00061800
         MVC   ACEELEN,=AL3(ACEEL) LENGTH                               00061900
         MVI   ACEEVRSN,C'1'       VERSION 1                            00062000
         MVC   ACEEUSER,CBLKUSER   UserID (Length + User)          @rp2 00062100
         MVC   ACEEGRP,CBLKGRP     Default GROUP (Length + group)  @rp2 00062200
         OI    ACEEFLG1,ACEERACF+ACEECNTL                               00062300
         OI    ACEEFLG2,ACEENONE   Default UACC = NONE             @rp2 00062400
         L     R2,FLCCVT           CVT                                  00062500
         MVC   ACEEDATE,CVTDATE+1-CVT(R2) MOVE DATE                     00062600
         CLI   CBLKFLG1,C'Y'       Operations authority?           @rp2 00062700
         BNE   RACINNOP            No: do not set flag                  00062800
         OI    ACEEFLG1,ACEEOPER   Set OPERATIONS authority        @rp2 00062900
RACINNOP CLI   CBLKSPEC,C'Y'       SPECIAL authority?              @rp2 00063000
         BNE   RACIPROC            No: do not set flag             @rp2 00063100
         OI    ACEEFLG1,ACEESPEC   Set SPECIAL authority           @rp2 00063200
RACIPROC MVC   ACEEPROC,=CL8' '    Blank STC procedure name        @rp2 00063300
         ICM   R2,B'1111',12(R8)   STC ?                                00063400
         BZ    RACINANS            NO, BATCH                            00063500
         MVC   ACEEPROC,0(R2)      MOVE PROC NAME FOR STC               00063600
RACINANS ICM   R2,B'1111',40(R8)   TERMID specified?               @rp2 00063700
         BZ    RACINNTR            No: not specified               @rp2 00063800
         MVC   ACEETRID,0(R2)      Move Terminal ID                @rp2 00063900
RACINNTR CLM   ACEEREG,B'1000',=X'00' ABOVE THE LINE?                   00064000
         BE    RACICGRP            NO, ADD GROUPS                       00064100
*                                                                       00064200
RACICGRP ICM   R3,B'1111',CBLKGRPS Pointer to connected groups     @rp2 00064300
         BNZ   RACICGP1            NONE IN PROFS                        00064400
         LA    R3,STCGROUP         STC GROUP IF STC                     00064500
         CLC   =CL8'STC',ACEEUSRI  STC?                                 00064600
         BE    RACICGP1            YES, GO ON                           00064700
         LA    R3,PRDGROUP         NO USE PRD GROUP                     00064800
RACICGP1 LA    R5,ACEECGRP         FIRST POINTER                        00064900
         XR    R2,R2               CLEAR R2                             00065000
         IC    R2,ACEESP           GET SUBPOOL                          00065100
RACICGPL GETMAIN RC,LV=CONNL,SP=(R2)                                    00065200
         XC    0(CONNL,R1),0(R1)   CLEAR AREA                           00065300
         ST    R1,0(R5)            SAVE IN PTR                          00065400
         MVC   CONNGRP-CONNGRUP(,R1),CONNGRP-CONNGRUP(R3) THEM TO US    00065500
         LA    R5,CONNNEXT-CONNGRUP(R1) NEXT POINTER                    00065600
         ICM   R3,B'1111',CONNNEXT-CONNGRUP(R3) NEXT CONN.              00065700
         BNZ   RACICGPL            NEXT CGRP.                           00065800
*                                                                       00065900
         CLI   0(R8),X'34'         check length of RACINIT plist        00066000
         BNL   RACIAPPL            -> ge x'34' continue                 00066100
         B     RACINSTA            -> lt x'34' store ACEE addr in ASXB  00066200
RACIAPPL ICM   ENTYREG,B'1111',X'30'(R8) ANY APPL REQ?                  00066300
         BZ    RACITERM            NO, GO ON                            00066400
         MVC   WORKCLAS,=CL8'APPL' APPL CLASS                           00066500
         MVI   WORKAUTH,RACFREAD   READ REQ                             00066600
         BAL   R10,ENTYCHCK        CHECK ENTITY                         00066700
         B     RACITERM            0 -> OK                              00066800
         B     RACITERM            4 -> OK                              00066900
         B     RACIFAPL            8 -> NG                              00067000
*                                                                       00067100
RACITERM ICM   ENTYREG,B'1111',X'28'(R8) ANY APPL REQ?                  00067200
         BZ    RACIALOK            NO, GO ON                            00067300
         MVC   WORKCLAS,=CL8'TERMINAL' TERM CLASS                       00067400
         MVI   WORKAUTH,RACFREAD   READ REQ                             00067500
         BAL   R10,ENTYCHCK        CHECK ENTITY                         00067600
         B     RACIALOK            0 -> OK                              00067700
         B     RACIALOK            4 -> OK                              00067800
         B     RACIFTRM            8 -> NG                              00067900
*                                                                       00068000
RACIALOK ICM   R2,B'1111',X'34'(R8) ACEE PTR                            00068100
         BZ    RACINSTA            SAVE ACEE                            00068200
         ST    ACEEREG,0(R2)       SAVE ACEE ADDRESS                    00068300
         B     RACIGOOD            OK ..........                        00068400
RACINSTA EQU   *                                                        00068500
         L     R2,PSAAOLD          ADDRESS ASCB                         00068600
         L     R2,ASCBASXB-ASCB(R2) ADDRESS ASCB                        00068700
         ST    ACEEREG,ASXBSENV-ASXB(R2) STORE IN ASXB                  00068800
         B     RACIGOOD            OK ..........                        00068900
*                                                                       00069000
         DROP  R4                                                       00069100
         TITLE 'RACINIT PROCESS. (GET INTO/OUT OF SYSTEM) - DEL. ACEE'  00069200
*---------------------------------------------------------------------* 00069300
*        RACINIT or RACROUTE REQUEST=VERIFY,ENVIR=DELETE              * 00069400
*---------------------------------------------------------------------* 00069500
RACINDEL ICM   R2,B'1111',X'34'(R8) ACEE PTR                            00069600
         BZ    RACIDNAC            DELETE, NO ACEE                      00069700
         L     ACEEREG,0(R2)       GET ACEE ADDRESS                     00069800
         B     RACINFRE            GO DO FREEMAIN                       00069900
RACIDNAC EQU   *                                                        00070000
         L     R2,PSAAOLD          OUR ASCB                             00070100
         L     R2,ASCBASXB-ASCB(R2) OUR ASXB                            00070200
         C     ACEEREG,ASXBSENV-ASXB(R2) ACEE SAME?                     00070300
         BNE   RACINTDM            NO, GO DO FREE                       00070400
         XC    ASXBSENV-ASXB(,R2),ASXBSENV-ASXB(R2) YES, CLEAR          00070500
         B     RACINFRE            GO FREE ACEE                         00070600
*                                                                       00070700
RACINTDM L     R2,PSAAOLD          OUR ASCB                             00070800
         L     R2,ASCBASXB-ASCB(R2) OUR ASXB                            00070900
         ICM   ACEEREG,B'1111',ASXBSENV-ASXB(R2) ACEE                   00071000
         BZ    RACIGOOD            ASXB & TCB  BOTH DUMMY               00071100
         XC    ASXBSENV-ASXB(,R2),ASXBSENV-ASXB(R2) CLEAR ASXB          00071200
RACINFRE ICM   R2,B'1111',ACEEIEP  ANY OTHER F.M?                       00071300
         BZ    RACINIEP            NO, SO BYE...                        00071400
         XR    R3,R3               CLEAR R3                             00071500
         IC    R3,0(R2)            SUBPOOL                              00071600
         XR    R4,R4               CLEAR R4                             00071700
         ICM   R4,B'0111',1(R2)    LENGTH                               00071800
         FREEMAIN RC,A=(R2),SP=(R3),LV=(R4) FREE ????                   00071900
*                                                                       00072000
RACINIEP XR    R2,R2               CLEAR R2                             00072100
         IC    R2,ACEESP           SUBPOOL                              00072200
         LA    R3,CONNL            CLEAR R3                             00072300
         L     R5,ACEECGRP         CONN. GROUPS                         00072400
         B     RACIFCN2            START FREEMAINS                      00072500
RACIFCNL L     R5,CONNNEXT-CONNGRUP(R4) LOOP THRU OLD TABLE             00072600
         FREEMAIN RC,A=(R4),SP=(R2),LV=(R3) FREE ACEE                   00072700
RACIFCN2 LTR   R4,R5               MORE ENTRIES?                        00072800
         BNZ   RACIFCNL             Y - NEXT ENTRY                      00072900
*                                                                       00073000
RACINCGP XR    R2,R2               CLEAR R2                             00073100
         IC    R2,ACEESP           SUBPOOL                              00073200
         XR    R3,R3               CLEAR R3                             00073300
         ICM   R3,B'0111',ACEELEN  LENGTH                               00073400
         FREEMAIN RC,A=(ACEEREG),SP=(R2),LV=(R3) FREE ACEE              00073500
         B     RACIGOOD            GO TO GOOD RETURN CODE               00073600
         TITLE 'RACINIT PROCESS. (GET INTO/OUT OF SYSTEM) - Bye'        00073700
RACIGOOD XC    SAFPRRET,SAFPRRET   NOTHING ...                          00073800
         XC    SAFPRREA,SAFPRREA   NOTHING ...                          00073900
         XC    WORKPASS,WORKPASS   CLEAR JUST IN CASE                   00074000
         MODESET KEYADDR=WORKKEY,WORKREG=2                              00074100
         TM    WORKFLAG,WORKSUPO   SUP. ON                              00074200
         BNO   RTRNGOOD            NO, GO TO RC 200 CODE                00074300
         MODESET MODE=PROB         SET STATE                            00074400
         B     RTRNGOOD            GO TO RC 200 CODE                    00074500
*                                                                       00074600
RACIUNKN MVC   SAFPRRET,=F'04'     NOT PROTECTED ...                    00074700
         MODESET KEYADDR=WORKKEY,WORKREG=2                              00074800
         TM    WORKFLAG,WORKSUPO   SUP. ON                              00074900
         BNO   RTRNWARN            NO, GO TO RC 204 CODE                00075000
         MODESET MODE=PROB         SET STATE                            00075100
         B     RTRNWARN            GO TO RC 204 CODE                    00075200
*                                                                       00075300
RACIINPW MVC   SAFPRRET,=F'08'     Invalid or no password entered       00075400
         XC    WORKPASS,WORKPASS   Clear just in case                   00075500
         B     RACIFAIL            BRANCH TO FAIL COMMON                00075600
*                                                                       00075700
RACIREVK MVC   SAFPRRET,=F'28'     REVOKED....                          00075800
         B     RACIFAIL            BRANCH TO FAIL COMMON                00075900
*                                                                       00076000
RACIFAPL MVC   SAFPRRET,=F'52'     NOT AUTH TO APPL...                  00076100
         B     RACIFAFM            FAIL & FREEMAIN                      00076200
RACIFTRM MVC   SAFPRRET,=F'48'     NOT AUTH TO TERM...                  00076300
*                                                                       00076400
RACIFAFM ICM   R4,B'1111',ACEECGRP CONN. GROUPS                         00076500
         BZ    RACIFACF            NO: GO FREEMAIN ACEE                 00076600
         XR    R2,R2               CLEAR R2                             00076700
         IC    R2,ACEESP           SUBPOOL                              00076800
         LA    R3,CONNL            CLEAR R3                             00076900
         B     RACIFAG2            BYPASS MOVE                          00077000
RACIFAGL L     R5,CONNNEXT-CONNGRUP(R4) LOOP THRU OLD TABLE             00077100
         FREEMAIN RC,A=(R4),SP=(R2),LV=(R3) FREE ACEE                   00077200
RACIFAG2 LTR   R4,R5               MORE ENTRIES?                        00077300
         BNZ   RACIFAGL             Y - NEXT ENTRY                      00077400
*                                                                       00077500
RACIFACF XR    R2,R2               CLEAR R2                             00077600
         IC    R2,ACEESP           SUBPOOL                              00077700
         XR    R3,R3               CLEAR R3                             00077800
         ICM   R3,B'0111',ACEELEN  LENGTH                               00077900
         FREEMAIN RC,A=(ACEEREG),SP=(R2),LV=(R3) FREE ACEE              00078000
         B     RACIFAIL            BRANCH TO FAIL COMMON                00078100
*                                                                       00078200
RACIFAIL MODESET KEYADDR=WORKKEY,WORKREG=2                              00078300
         TM    WORKFLAG,WORKSUPO   SUP. ON                              00078400
         BNO   RACINPWF            No  --> check for WTO suppression    00078500
         MODESET MODE=PROB         SET STATE                            00078600
RACINPWF CLC   SAFPRRET,=F'08'     Invalid or no password entered?      00078700
         BNE   RACIFWTO            No  --> write message                00078800
         LTR   R3,R3               yes --> no password entered?         00078900
         BZ    RTRNFAIL            yes --> don't write message          00079000
RACIFWTO MVC   WORKWTO+4(60),WTOMSG4  ATTEMPTED ACCESS                  00079100
         ICM   R5,B'1111',4(R8)    GO TO USERID                         00079200
         IC    R1,0(R5)            GET LENGTH                           00079300
         EX    R1,RACIWTO2         MOVE NAME FOR WTO                    00079400
         WTO   MF=(E,WORKWTO)      WRITE IT                             00079500
         XC    SAFPRREA,SAFPRREA   NOTHING ...                          00079600
         XC    WORKPASS,WORKPASS   CLEAR JUST IN CASE                   00079700
         B     RTRNFAIL            BYE ............                     00079800
RACIWTO2 MVC   WORKWTO+4+WTOMSG4U(0),1(R5) MOVE USERID                  00079900
         TITLE 'ALL ROADS LEAD HERE'                                    00080000
RTRN0000 LA    R15,0               RC = 0                               00080100
         B     RTRNRTRN            GO BACK                              00080200
*                                                                       00080300
RTRNGOOD LA    R15,0               RACF RC=0                            00080400
         B     RTRNRTRN            GO BACK                              00080500
*                                                                       00080600
RTRNWARN LA    R15,4               RACF RC=4                       @rp2 00080700
         B     RTRNRTRN            GO BACK                              00080800
*                                                                       00080900
RTRNFAIL LA    R15,8               RACF RC=8                       @rp2 00081000
         B     RTRNRTRN            GO BACK                              00081100
*                                                                       00081200
RTRNRTRN L     R13,WORKSAVE+4      RETURN R13                           00081300
         RETURN (14,12),RC=(15)    BYE                                  00081400
*                                                                       00081500
         TITLE 'CHECK FOR ACCESS'                                       00081600
ENTYCHCK MVI   WORKENTL,0          Nullify Entity length           @rp2 00081700
         L     R2,FLCCVT           LOAD CVT                             00081800
         ICM   R2,B'1111',CVTRAC-CVTMAP(R2) CHECK RCVT                  00081900
         BZ    ENTYERR1            WHO KNOWS?                           00082000
         ICM   R2,B'1111',RCVTISTL-RCVT(R2) OUR STUFF?                  00082100
         BZ    ENTYERR1            WHO KNOWS?                           00082200
         ICM   R2,B'1111',CJYPROFS-CJYRCVTD(R2) OUR STUFF?              00082300
         BZ    ENTYERR1            WHO KNOWS?                           00082400
         USING RPECBLK,R2          ADDRESS CBLK                         00082500
         CLC   WORKCLAS(8),=CL8' '    CLASS blank?                      00082600
         BNE   ENTYNBLK                  --> no, continue               00082700
         MVC   WORKCLAS(8),=CL8'DATASET' --> yes, assume DATASET        00082800
ENTYNBLK CLC   =C'DATASET',WORKCLAS  CHECK FOR OUR OWN DSNS.            00082900
         BNE   ENTYCLLP            NO, GO ON                            00083000
         XR    R1,R1               Clear is needed for LA          @mg1 00083100
         IC    R1,ACEEUSRL         GET LENGTH                           00083200
         BCTR  R1,0                DOWN 1 FOR CLC                       00083300
         EX    R1,ENTYEXUS         CLC 0(0,ENTYREG),ACEEUSRN            00083400
         BNE   ENTYTEMP            No: not our dataset             @mg1 00083500
         LA    R14,1(R1,ENTYREG)   Point after UserID              @mg1 00083600
         CLI   0(R14),C'.'         First qualifier is UserID?      @mg1 00083700
         BE    AUTHGOOD            Yes: definitely our dataset     @mg1 00083800
ENTYTEMP DS    0H                                                  @mg1 00083900
         CLC   0(3,ENTYREG),=C'SYS' Is it a ..                          00084000
         BNE   ENTYCLLP              --> no                             00084100
         CLC   8(2,ENTYREG),=C'.T'            .. temporary ..           00084200
         BNE   ENTYCLLP              --> no                             00084300
         CLC   16(3,ENTYREG),=C'.RA'                         .. dataset 00084400
         BNE   ENTYCLLP              --> no, go on                      00084500
         B     AUTHGOOD              --> Yes, go for it                 00084600
ENTYCLLP XC    WORKSTAT,WORKSTAT   Parameter for RACSTAT           @rp2 00084700
         LA    R1,WORKCLAS         Class name                      @rp2 00084800
         ST    R1,WORKSTAT         Class name to check             @rp2 00084900
         LA    R1,WORKSTAT         Parameter for RACSTAT           @rp2 00085000
         L     R3,X'4C'            Pointer CVT                     @rp2 00085100
         ICM   R3,B'1111',CVTRAC-CVTMAP(R3) Load RCVT              @rp2 00085200
         ICM   R15,15,RCVTREXP-RCVT(R3)  Entry point RACSTAT       @rp2 00085300
         BZ    ENTYCLL2            Give it the benefit of the doubt@rp2 00085400
         BALR  R14,R15             Invoke RACSTAT (in CJYRCVT)     @rp2 00085500
         LTR   R15,R15             Is CLASS present in CDT?        @rp2 00085600
         BZ    ENTYCLL2            Yes: continue                   @rp2 00085700
         LR    R5,R10              Save entry register             @rp2 00085800
         BAL   R10,WTOUNKN         Msg: Undefined Class xxxxxxxx   @rp2 00085900
         LR    R10,R5              Restore entry register          @rp2 00086000
         B     AUTHFAIL            RC=8 --> exit                   @rp2 00086100
ENTYCLL2 IC    R1,RPECLASL         Get length from Profile entry   @rp2 00086200
         BCTR  R1,0                SUBTRACT 1 FOR CLC                   00086300
         EX    R1,ENTYEXEC         CLC RPECLASN(0),WORKCLAS             00086400
         BL    ENTYNFND            NOT FOUND                            00086500
         BNE   ENTYNCLS            NO, GET NEXT                         00086600
         MVC   WORKENTL,RPEENTYL   Copy Entity length field        @rp2 00086700
         ICM   R1,B'0001',RPEENTYL GET LENGTH                           00086800
         BZ    ENTYENFN            '*' ONLY ENTITY?                     00086900
         BCTR  R1,0                NO, SUBTRACT 1 FOR CLC               00087000
         EX    R1,ENTYEXEN         CLC RPEENTYN(0),0(ENTYREG)           00087100
         BE    ENTYENFN            FOUND ENTITY                         00087200
ENTYNCLS ICM   R2,B'1111',RPENEXT  GET NEXT                             00087300
         BNZ   ENTYCLLP            GO FOR NEXT                          00087400
ENTYNFND B     ENTYWARN            RETURN WARN                          00087500
ENTYEXEC CLC   RPECLASN(0),WORKCLAS SAME CLASS? << executed >>          00087600
ENTYEXEN CLC   RPEENTYN(0),0(ENTYREG) CHECK ENTITY                      00087700
ENTYEXUS CLC   0(0,ENTYREG),ACEEUSRI US?                                00087800
*                                                                       00087900
ENTYENFN ICM   R3,B'1111',RPEACCPT POINTER TO ACCESSES                  00088000
         BZ    ENTYUACC            GO CHECK UACC                        00088100
*                                                                       00088200
         USING RPEACCLE,R3         VARIABLE SECTION                     00088300
ENTYULOP CLC   RPEAUSR,ACEEUSRI    USER EXCEPTION?                      00088400
         BE    ENTYEXCP            MATCH, GO CHECK                      00088500
         ICM   R3,B'1111',RPEANEXT NEXT POINTER                         00088600
         BNZ   ENTYULOP            GO CHECK NEXT                        00088700
*                                                                       00088800
ENTYCONN ICM   R4,B'1111',ACEECGRP CONNECT GROUPS                       00088900
         BZ    ENTYUACC            NONE, GO ON                          00089000
         USING CONNGRUP,R4         ADDRESS IT                           00089100
ENTYCONL L     R3,RPEACCPT         GET POINTER AGAIN                    00089200
ENTYCON2 CLC   RPEAUSR,CONNGRPN    GROUP EXCEPTION?                     00089300
         BNE   ENTYNCRP            NO, NEXT RPE                         00089400
         OI    WORKFLAG,WORKOPRB   SET OPER BYPASS                      00089500
         CLC   WORKAUTH,RPEACS     SUFFICENT ACCESS IN PERMIT?          00089600
         BH    ENTYNCRP            NO, CHECK NEXT AUTH.                 00089700
         B     AUTHGOOD            YES, GO ON ...                       00089800
ENTYNCRP ICM   R3,B'1111',RPEANEXT NEXT POINTER                         00089900
         BNZ   ENTYCON2            GO CHECK NEXT EXCEPTION              00090000
ENTYNCON ICM   R4,B'1111',CONNNEXT NEXT POINTER                         00090100
         BNZ   ENTYCONL            GO CHECK NEXT CONNECT                00090200
         TM    WORKFLAG,WORKOPRB   BYPASS OPER CHECK?                   00090300
         BNO   ENTYUACC            NO, GO UACC                          00090400
         B     ENTYFAIL            ALL CONN.S FAILED                    00090500
*                                                                       00090600
ENTYUACC CLC   WORKAUTH,RPEUACC    SUFFICENT ACCESS IN UACC?            00090700
         BH    ENTYOPER            NO, RETURN CHECK FOR OP. AUTH        00090800
         B     AUTHGOOD            YES, GO ON ...                       00090900
*                                                                       00091000
ENTYEXCP CLC   WORKAUTH,RPEACS     SUFFICENT ACCESS IN PERMIT?          00091100
         BH    ENTYFAIL            NO, RETURN CHECK FOR OP. AUTH        00091200
         B     AUTHGOOD            YES, GO ON ...                       00091300
*---------------------------------------------------------------------* 00091400
*        Users with the OPERATIONS authority are permitted to         * 00091500
*        use all resources in the DATASET, DASDVOL and TAPEVOL class. * 00091600
*---------------------------------------------------------------------* 00091700
ENTYOPER CLC   =C'DATASET',RPECLASN  DATASET CLASS                      00091800
         BE    ENTYOPR2            YES, CHECK OPER AUTH                 00091900
         CLC   =C'DASDVOL',RPECLASN DASDVOL CLASS                       00092000
         BE    ENTYOPR2            YES, CHECK OPER AUTH                 00092100
         CLC   =C'TAPEVOL',RPECLASN TAPEVOL class?                 @rp2 00092200
         BE    ENTYOPR2            Yes: check operations privilege @rp2 00092300
         B     ENTYFAIL            TOUGH                                00092400
ENTYOPR2 TM    ACEEFLG1,ACEEOPER   MAKE OPER AUTH.                      00092500
         BNO   ENTYFAIL            TOUGH                                00092600
*                                                                       00092700
         DROP  R4,R3,R2            RPEACCLE CONNGRUP RPECBLK       @rp2 00092800
         CLC   =C'PROD',ACEEUSRI   PROD USERID?                         00092900
         BNE   AUTHGOOD            NO MSG NEC. -> OPER ALLOWED          00093000
         TM    WORKFLAG,WORKNLOG   NO LOG REQUESTED?                    00093100
         BO    AUTHGOOD            YES, NO MESS..                       00093200
         MVC   WORKWTO+4(60),WTOMSG7 INVALID ACCESS TO RESOURCE         00093300
         MVC   WORKWTO+4+WTOMSG7U(L'WTOMSG7U),ACEEUSRI MOVE USERID      00093400
         WTO   MF=(E,WORKWTO)      WRITE IT                             00093500
         MVC   WORKWTO+4(60),WTOMSGE ENTITY SKELETON                    00093600
         MVC   WORKWTO+4(9),=C'RAKF0006 ' USERID/CLASS                  00093700
         BAL   R4,ENTYENTY         ENTY COMMON                          00093800
         B     AUTHGOOD            ALLOW ACCESS                         00093900
*                                                                       00094000
ENTYERR1 MVC   WORKWTO+4(60),WTOMSG3 PROFS IN ERROR                     00094100
         MVC   WORKWTO+4+WTOMSG3U(L'WTOMSG3U),ACEEUSRI MOVE USERID      00094200
         WTO   MF=(E,WORKWTO)      WRITE IT                             00094300
         MVC   WORKWTO+4(60),WTOMSGE ENTITY SKELETON                    00094400
         MVC   WORKWTO+4(9),=C'RAKF0009 ' USERID/CLASS                  00094500
         BAL   R4,ENTYENTY         ENTY COMMON                          00094600
         B     AUTHGOOD            ALLOW ACCESS                         00094700
*                                                                       00094800
ENTYWARN OI    WORKENTY,4          RC = 4                               00094900
         TM    WORKFLAG,WORKNLOG   NO LOG REQUESTED?                    00095000
         BO    AUTHWARN            SORRY ....                           00095100
         MVC   WORKWTO+4(60),WTOMSG8 INVALID ACCESS TO RESOURCE         00095200
         WTO   MF=(E,WORKWTO)      WRITE IT                             00095300
         MVC   WORKWTO+4(60),WTOMSGE ENTITY SKELETON                    00095400
         MVC   WORKWTO+4(9),=C'RAKF000B ' USERID/CLASS                  00095500
         BAL   R4,ENTYENTY         ENTY COMMON                          00095600
         B     AUTHGOOD            ALLOW ACCESS                         00095700
*                                                                       00095800
ENTYFAIL OI    WORKENTY,8          RC = 8                               00095900
         TM    WORKFLAG,WORKNLOG   NO LOG REQUESTED?                    00096000
         BO    AUTHFAIL            SORRY ....                           00096100
         MVC   WORKWTO+4(60),WTOMSG5 INVALID ACCESS TO RESOURCE         00096200
         WTO   MF=(E,WORKWTO)      WRITE IT                             00096300
         MVC   WORKWTO+4(60),WTOMSGE ENTITY SKELETON                    00096400
         MVC   WORKWTO+4(9),=C'RAKF000A ' USERID/CLASS                  00096500
         BAL   R4,ENTYENTY         ENTY COMMON                          00096600
         B     AUTHFAIL            FAIL ACCESS                          00096700
*                                                                       00096800
ENTYENTY MVC   WORKWTO+4+WTOMSGEU(L'WTOMSGEU),ACEEUSRI MOVE USERID      00096900
         MVC   WORKWTO+4+WTOMSGEC(L'WTOMSGEC),WORKCLAS MOVE CLASS       00097000
         L     R2,PSAAOLD          ASCB ADDRESS                         00097100
         ICM   R3,B'1111',ASCBJBNI-ASCB(R2) JOBNAME SPEC.?              00097200
         BNZ   ENTYJOBN            YES, GO USE NAME                     00097300
         L     R3,ASCBJBNS-ASCB(R2) STC ... NAME                        00097400
ENTYJOBN MVC   WORKWTO+4+WTOMSGEJ(L'WTOMSGEJ),0(R3) MOVE JOBNAME        00097500
         XR    R1,R1               Entity length                   @rp2 00097600
         IC    R1,WORKENTL         Saved entity length             @rp2 00097700
         LTR   R1,R1               Length is zero?                 @rp2 00097800
         BZ    ENTYWTO1            Yes: assume some lengths        @rp2 00097900
         BCTR  R1,0                Minus 1 for EX                  @rp2 00098000
         B     ENTYWTO2            Set ENTITY in WTO               @rp2 00098100
ENTYWTO1 L     R1,WORKSTAT+4       Default entity len from RACSTAT @rp2 00098200
         BCTR  R1,0                Minus 1 for EX instruction      @rp2 00098300
         LA    R2,L'WTOMSGEE-1     Maximum room in WTO             @rp2 00098400
         CR    R2,R1               Too long?                       @rp2 00098500
         BH    ENTYWTO2            No: good                        @rp2 00098600
         LR    R1,R2               Yes: truncate                   @rp2 00098700
ENTYWTO2 EX    R1,ENTYERRX         MVC WORKWTO+4+WTOMSGEE(0),0(ENTYREG) 00098800
         WTO   MF=(E,WORKWTO)      WRITE IT                             00098900
         BR    R4                  RETURN                               00099000
*                                                                       00099100
ENTYERRX MVC   WORKWTO+4+WTOMSGEE(0),0(ENTYREG) MOVE ENTITY             00099200
*                                                                  @rp2 00099300
*        Report unknown CLASS (not present in the CDT)             @rp2 00099400
*                                                                  @rp2 00099500
WTOUNKN  MVC   WORKWTO(REALWTOL),REALWTO Initialize WTO            @rp2 00099600
         MVC   WORKWTO+4(60),WTOMSG12 Move message                 @rp2 00099700
         MVC   WORKWTO+4+WTMSG12C(8),WORKCLAS   Move class name    @rp2 00099800
         WTO   MF=(E,WORKWTO)      Inform operator                 @rp2 00099900
         BR    R10                 Return                          @rp2 00100000
*                                                                       00100100
*                                                                       00100200
* Report when hardcoded STC account is used                             00100300
*                                                                       00100400
WTOSTC   MVC   WORKWTO(REALWTOL),REALWTO INIT WTO                       00100500
         MVC   WORKWTO+4(60),WTOMSG10 MOVE MESSAGE                      00100600
         ICM   R2,B'1111',X'C'(R8) GET STC PROC NAME PTR                00100700
         BZR   R10                 No proc name, no message        @rp2 00100800
         MVC   WORKWTO+4+WTMSG10P(8),0(R2) MOVE PROC NAME               00100900
WTOSTC1  WTO   MF=(E,WORKWTO)      ISSUE MESSAGE                        00101000
         BR    R10                 RETURN                               00101100
*                                                                       00101200
* Report when hardcoded PROD account is used                            00101300
*                                                                       00101400
WTOPROD  MVC   WORKWTO(REALWTOL),REALWTO INIT WTO                       00101500
         MVC   WORKWTO+4(60),WTOMSG11 MOVE MESSAGE                      00101600
         ICM   R2,B'1111',PSAAOLD  GET ASCB                             00101700
         BZ    WTOPROD1            NO ASCB                              00101800
         ICM   R2,B'1111',ASCBJBNI-ASCB(R2)  Point to jobname           00101900
         BZ    WTOPROD1            No Jobname                           00102000
         MVC   WORKWTO+4+WTMSG11J(8),0(R2) Move Jobname                 00102100
WTOPROD1 WTO   MF=(E,WORKWTO)      ISSUE MESSAGE                        00102200
         BR    R10                 RETURN                               00102300
*                                                                       00102400
         TITLE 'CONSTANTS AND SUCH'                                     00102500
         LTORG                                                          00102600
*                                                                       00102700
STCUID   DC    AL4(0),X'03',CL8'STC',X'08',C'STCGROUP'                  00102800
STCPASS  DC    X'08251C06253A1F362D',C'Y'                               00102900
STCGROUP DC    AL4(0),AL1(8),CL8'STCGROUP'                              00103000
*                                                                       00103100
PRODUID  DC    AL4(0),X'04',CL8'PROD',X'08',C'PRDGROUP'                 00103200
PRODPASS DC    X'08251C06253A1F362D',C'N'                               00103300
PRDGROUP DC    AL4(0),AL1(8),CL8'PRDGROUP'                              00103400
*                                                                       00103500
REALWTO  WTO   '1234567 101234567 201234567 301234567 401234567 5012345X00103600
               67 60',MF=L                                              00103700
REALWTOL EQU   *-REALWTO           LENGTH                               00103800
*                                                                       00103900
WTOMSG1  DC    CL60'RAKF0001 USERID TABLE INVALID OR MISSING'           00104000
WTOMSG2  DC    C'RAKF0002 STC ACCESS ALLOWED: USER:'                    00104100
WTOMSG2U EQU   *-WTOMSG2,8                                              00104200
         DC    CL8' ',CL(60-(*-WTOMSG2))' '                             00104300
WTOMSG3  DC    C'RAKF0003 RESOURCE TABLE INVALID/MISSING: ALLOWED:'     00104400
*        DC    C': USER ALLOWED:'                                       00104500
WTOMSG3U EQU   *-WTOMSG3,8                                              00104600
         DC    CL8' ',CL(60-(*-WTOMSG3))' '                             00104700
WTOMSG4  DC    C'RAKF0004 INVALID ATTEMPT TO ACCESS SYSTEM:  USER:'     00104800
WTOMSG4U EQU   *-WTOMSG4,8                                              00104900
         DC    CL8' ',CL(60-(*-WTOMSG4))' '                             00105000
WTOMSG5  DC    CL60'RAKF0005 INVALID ATTEMPT TO ACCESS RESOURCE'        00105100
WTOMSG7  DC    C'RAKF0007 ACCESS ALLOWED VIA OPERATIONS:  USER:'        00105200
WTOMSG7U EQU   *-WTOMSG7,8                                              00105300
         DC    CL8' ',CL(60-(*-WTOMSG7))' '                             00105400
WTOMSG8  DC    CL60'RAKF0008 UNDEFINED RESOURCE - ACCESS ALLOWED'       00105500
WTOMSG10 DC    C'RAKF0010I STC '                                        00105600
WTMSG10P EQU   *-WTOMSG10,8                                             00105700
         DC    CL8' ',C' STARTED USING DEFAULT STC ACCOUNT'             00105800
         DC    CL(60-(*-WTOMSG10))' '                                   00105900
WTOMSG11 DC    C'RAKF0011I JOB '                                        00106000
WTMSG11J EQU   *-WTOMSG11,8                                             00106100
         DC    CL8' ',C' STARTED USING DEFAULT PROD ACCOUNT'            00106200
         DC    CL(60-(*-WTOMSG11))' '                                   00106300
WTOMSG12 DC    C'RAKF0012 UNDEFINED CLASS '                        @rp2 00106400
WTMSG12C EQU   *-WTOMSG12,8                                        @rp2 00106500
         DC    CL8' '                  To contain unknown class    @rp2 00106600
         DC    CL(60-(*-WTOMSG12))' '                              @rp2 00106700
WTOMSGE  DC    C'XXXXXXXXX '                                            00106800
WTOMSGEU EQU   *-WTOMSGE,8                                              00106900
         DC    CL8' ',C','                                              00107000
WTOMSGEJ EQU   *-WTOMSGE,8                                              00107100
         DC    CL8' ',C','                                              00107200
WTOMSGEC EQU   *-WTOMSGE,8                                              00107300
         DC    CL8' ',C','                                              00107400
WTOMSGEE EQU   *-WTOMSGE,20                                             00107500
         DC    CL20' ',CL(60-(*-WTOMSGE))' '                            00107600
         DC    CL133' '                                                 00107700
*                                  spaceholder blanks removed       @02 00107800
         DC    CL23' '             rest of spaceholder blanks       @02 00107900
         TITLE 'REGISTERS AND SUCH'                                     00108000
R0       EQU   0                                                        00108100
R1       EQU   1                                                        00108200
R2       EQU   2                                                        00108300
R3       EQU   3                                                        00108400
R4       EQU   4                                                        00108500
R5       EQU   5                                                        00108600
ENTYREG  EQU   6                                                        00108700
ACEEREG  EQU   7                                                        00108800
R8       EQU   8                                                        00108900
R9       EQU   9                                                        00109000
R10      EQU   10                                                       00109100
R11      EQU   11                                                       00109200
R12      EQU   12                                                       00109300
R13      EQU   13                                                       00109400
R14      EQU   14                                                       00109500
R15      EQU   15                                                       00109600
         PRINT NOGEN                                                    00109700
         TITLE 'DSECTS AND SUCH'                                        00109800
*                                                                       00109900
*        WORKAREA is the area provided by the caller of                 00110000
*        RACROUTE (the WORKA paramer). The maximum length = 512 bytes   00110100
*                                                                       00110200
WORKAREA DSECT                     168 BYTE AREA                   @rp2 00110300
WORKSAVE DS    18F                 Our save area                        00110400
WORKSTAT DS    D                   Parameter for RACSTAT           @rp2 00110500
*                                  Word 1 = address of class name  @rp2 00110600
*                                  Word 2 = Max. length of class   @rp2 00110700
WORKWTO  DS    XL(REALWTOL)        FOR WTO                              00110800
WORKKEY  DS    X                   RACINIT KEY SAVE                     00110900
WORKENTY DS    X                   ENTITY RETURN                        00111000
WORKENTL DS    X                   Entity length                   @rp2 00111100
WORKFLAG DS    X                   FLAG BYTES                           00111200
WORKSUPO EQU   X'80'                  WE SET SUPERVISOR STATE           00111300
WORKNLOG EQU   X'40'                  NO LOG IF FAILURE                 00111400
WORKOPRB EQU   X'20'                  RPE MATCH ON USERID/CLASS         00111500
WORKPASS DS    XL9                 RACINIT LEN/PSWD                     00111600
         ORG   WORKPASS                                                 00111700
WORKSTC  DS    XL9                 To receive L + START=value      @rp2 00111800
WORKCLAS DS    XL8                 RACHECK/DEF/FRAC CLASS               00111900
WORKAUTH DS    X                   RACHECK/DEF/FRAC AUTHORITY REQ.      00112000
         ORG                                                            00112100
         DS    XL(168-(*-WORKAREA)) MAKE SURE                      @rp2 00112200
WORKAREL EQU   *-WORKAREA           S.B 168                        @rp2 00112300
*                                                                       00112400
*        GETMAIN'd scratch for the RAKFPWH password-hash call           00112500
HASHWKD  DSECT                                                          00112600
HWPL     DS    5F                  Parmlist (salt,pw,pwlen,out,work)    00112700
HWPWLEN  DS    F                   Candidate password length            00112800
HWR13    DS    F                   Saved caller save-area pointer       00112900
HWOUT    DS    CL32                Computed SHA-256 hash                00113000
HWSAVE   DS    18F                 Save area for the RAKFPWH call       00113100
HWWORK   DS    CL640               RAKFPWH work area (>= RPWWORKL)      00113200
HASHWKL  EQU   *-HASHWKD           Total length to GETMAIN              00113300
*                                                                       00113400
AUTHDS   DSECT                     USED FOR RETURN FROM SUBS(R10)       00113500
AUTHGOOD DS    F'0'                                                     00113600
AUTHWARN DS    F'0'                                                     00113700
AUTHFAIL DS    F'0'                                                     00113800
*                                                                       00113900
         COPY  CJYUCBLK            USERID CBLK                          00114000
*                                                                       00114100
         COPY  CJYPCBLK            PROFILE CBLK                         00114200
*                                                                       00114300
         COPY  CJYRCVTD            RCVT CBLK                            00114400
*                                                                       00114500
         CVT     DSECT=YES,LIST=NO                                      00114600
         ICHACHKL                                                       00114700
         ICHPRCVT                                                       00114800
         ICHRDDFL                                                       00114900
         ICHSAFP                                                        00115000
         IEFAJCTB                                                       00115100
         IEZJSCB                                                        00115200
         IHAASCB DSECT=YES                                              00115300
         IHAASXB DSECT=YES                                              00115400
         IHACDE                                                         00115500
         IHAPSA  DSECT=YES                                              00115600
         IKJRB   DSECT=YES                                              00115700
         IKJTCB  DSECT=YES,LIST=NO                                      00115800
         IHAACEE                                                        00115900
ACEEL    EQU   *-ACEE                                                   00116000
         END                                                            00116100
