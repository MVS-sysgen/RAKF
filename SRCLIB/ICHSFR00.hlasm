         IC    R2,1(R8)            GET SP NUMBER                        00056000
RACINDGM GETMAIN RC,LV=ACEEL,SP=(R2) DO GETMAIN                         00056100
         LR    ACEEREG,R1          ADDRESS AREA                         00056200
         XC    ACEE(ACEEL),ACEE    CLEAR IT                             00056300
         MVC   ACEEACEE,=C'ACEE'   ACEE NAME                            00056400
