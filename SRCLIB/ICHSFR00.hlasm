RACINOID CLC   =F'0',X'C'(R8)      STC ?                                00054000
         BNE   RACISSTC            YES, DO IT ...                       00054100
         CLC   =F'0',X'28'(R8)     TERMID SPEC?                         00054200
         BNE   RACIREVK            TSO ---- > REVOKED                   00054300
         CLC   =F'0',X'2C'(R8)     JOBNAME SPEC.?                       00054400
