         ICM   R2,B'1111',PSAAOLD   POINT TO ASCB OLD                   00054600
         BZ    RACISSTC            ASSUME STC                           00054700
         CLC   =F'0',ASCBJBNI-ASCB(R2) JOBNAME SPEC.?                   00054800
         BNE   RACISBAT            BATCH, OK ....                       00054900
RACISSTC LA    R4,STCUID-L'CBLKNEXT POINT TO UID                        00055000
