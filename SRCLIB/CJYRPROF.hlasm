*   !!!!! DO NOT RENUMBER !!!!! enter NUMBER OFF before editing      *  00002600
*                               But better is letting SMP doing      *  00002700
*                               the EDIT.                            *  00002800
*                                                                    *  00002900
**********************************************************************  00003000
*                                                                   @01 00003100
*    Change History                                                 @01 00003200
*                                                                   @01 00003300
*    2011/04/03 TRKF120 base version                                @01 00003400
*    2011/04/18 RRKF001 introduce change history                    @01 00003500
*                       enable comment lines in UDATA and PDATA     @01 00003600
*    2011/04/29 RRKF003 if in-core PDATA table already exists check @03 00003700
*                       for READ access to profile RAKFADM in the   @03 00003800
*                       FACILITY class to ensure that only properly @03 00003900
*                       authorized users can replace the in-core    @03 00004000
*                       PDATA table                                 @03 00004100
*                                                                   @03 00004200
*    2022/10/21 RRKF007 Remove the need to sort the input in        @07 00004300
*                       alphabetical order. Allocate a core table   @07 00004400
*                       of 2,000 entries, read the PROFILES         @07 00004500
*                       member into the table and sort the entries  @07 00004600
*                       before processing.                          @07 00004700
*                                                                   @07 00004800
*    2026/10/14 @rp2    Remove the hardcoded CLASS names and       @rp2 00004904
*                       check against the max class length from    @rp2 00005004
*                       the CDT. Invoke RACSTAT for this test.     @rp2 00005110
*                       If the entity length > max entity length   @rp2 00005200
*                       of that class, revert the length to max.   @rp2 00005300
*                                                                  @rp2 00005404
********************************************************************@07 00005500
*                                                                       00005600
         SAVE  (14,12),,CJYRPROF_&SYSDATE._&SYSTIME._                   00005700
         LR    R12,R15                 SETUP BASE REG.                  00005800
         USING CJYRPROF,R12            ESTABLISH ADDRESSABILITY         00005900
         LA    R11,SAVEAREA            OUR SAVEAREA                     00006000
         ST    R13,SAVEAREA+4          SAVE HIGH SAVEAREA               00006100
         ST    R11,8(R13)              SAVE LOW SAVEAREA                00006200
         LR    R13,R11                 POINT TO OUR SAVEAREA            00006300
         L     R8,FLCCVT-PSA(R0)       GET CVT POINTER                  00006400
         ICM   R8,B'1111',CVTRAC-CVTMAP(R8) IS RCVT POINTER ZERO?       00006500
         BZ    NOGOOD                       YES, ABEND                  00006600
         ICM   R8,B'1111',RCVTISTL-RCVT(R8) IS POINTER TO OUR AREA 0?   00006700
         BZ    NOGOOD                       YES, ABEND                  00006800
*                                                                   @03 00006900
         ICM    R5,B'0111',CJYPROFS-CJYRCVTD(R8) does PDATA exist?  @03 00007000
         BZ     OK2GO                   NO, go ahead                @03 00007100
         RACHECK ENTITY=RAKFADM,CLASS='FACILITY',ATTR=READ authorize@03 00007200
         LTR    R15,R15                RAKFADM granted?             @03 00007300
         BNZ    ABEND600                NO, abend                   @03 00007400
*                                                                       00007500
         USING CJYRCVTD,R8                                              00007600
OK2GO    DS    0H                      NO, CONTINUE                     00007700
         ENQ   (SECURITY,PROFS,E,,SYSTEM),RET=HAVE                      00007800
         OPEN  (CJYPDATA,(INPUT))      OPEN INPUT FILE                  00007900
         MODESET MODE=SUP,KEY=ZERO     authorize ourselves              00008000
*                                                                   @07 00008100
         GETMAIN RU,LV=160000          GETMAIN ROOM FOR 2000 ENT.   @07 00008200
         LR    R2,R1                   SAVE ITS ADDRESS             @07 00008300
         ST    R1,ADRTBL               SAVE FOR LATER USE           @07 00008400
         XR    R7,R7                   RECORD COUNTER               @07 00008500
GETMLOOP DS    0H                                                   @07 00008600
         XC    0(80,R2),0(R2)          CLEAR CORE TABLE ENTRY       @07 00008700
         GET   CJYPDATA,RECORD         READ A RECORD                @07 00008800
         CLI   RECORD,C'*'             COMMENT FIELD?               @07 00008900
         BE    GETMLOOP                YES: SKIP                    @07 00009000
         MVC   0(80,R2),RECORD         MOVE IN TEMPORARY TABLE      @07 00009100
         LA    R7,1(,R7)               INCREASE COUNTER             @07 00009200
         LA    R2,80(,R2)              NEXT ENTRY IN TABLE          @07 00009300
         B     GETMLOOP                READ NEXT RECORD             @07 00009400
ENDLOOP  DS    0H                                                   @07 00009500
         L     R2,ADRTBL               POINT TO FIRST RECORD        @07 00009600
         STM   R4,R8,SAVESORT                                       @07 00009700
         CH    R7,=H'2'                LESS THAN 2 RECORDS?         @07 00009800
         BL    READLOOP                DO NOT SORT                  @07 00009900
         BCTR  R7,0                    MINUS 1                      @07 00010000
         MH    R7,=H'80'               ** RECORD LENGTH             @07 00010100
         LA    R7,0(R2,R7)             POINT TO LAST RECORD         @07 00010200
*                                                                   @07 00010300
SORT01   DS    0H                      START SORT                   @07 00010400
         ST    R7,SWAPLAST             LAST RECORD SWAPPED          @07 00010500
         L     R4,ADRTBL               POINT TO FIRST RECORD        @07 00010600
         LR    R5,R4                   NEXT                         @07 00010700
         LA    R5,80(,R4)                   RECORD                  @07 00010800
SORT03   DS    0H                      SORT TEMPORARY TABLE         @07 00010900
         CL    R4,SWAPLAST             LAST RECORD REACHED?         @07 00011000
         BNL   SORT07                  YES: LOOP COMPLETE           @07 00011100
         CLC   0(80,R4),0(R5)          COMPARE                      @07 00011200
         BNH   SORT05                  HIGH: SWAP THESE RECORDS     @07 00011300
         XC    0(80,R4),0(R5)          SWAP                         @07 00011400
         XC    0(80,R5),0(R4)              THE                      @07 00011500
         XC    0(80,R4),0(R5)                   RECORDS             @07 00011600
         LR    R7,R4                   LAST RECORD SWAPPED IN R7    @07 00011700
SORT05   DS    0H                      LOAD NEXT ENTRY              @07 00011800
         LA    R4,80(,R4)              NEXT RECORD                  @07 00011900
         LA    R5,80(,R5)              NEXT RECORD                  @07 00012000
         B     SORT03                  COMPARE NEXT RECORD          @07 00012100
SORT07   DS    0H                      ALL RECORDS DONE             @07 00012200
         CL    R7,SWAPLAST             ARE THESE SWAPS EXECUTED?    @07 00012300
         BL    SORT01                  IF YES, THEM SORT AGAIN      @07 00012400
*                                      ELSE END OF SORT             @07 00012500
         LM    R4,R8,SAVESORT          RESTORE REGISTERS            @07 00012600
         L     R7,ADRTBL               START OF CORE TABLE          @07 00012700
         SL    R7,=F'80'               POINT 1 RECORD BEFORE        @07 00012800
*                                                                       00012900
READLOOP DS    0H                                                       00013000
         MVC   INRECOLD,INRECNEW       SAVE OLD I/P FOR COMPARE         00013100
         LA    R7,80(,R7)              NEXT RECORD IN TABLE         @07 00013200
         ICM   R1,15,0(R7)             END OF DATA?                 @07 00013300
         BZ    EOFILE                  Y: ENTIRE TABLE PROCESSED    @07 00013400
         MVC   INRECNEW,0(R7)          MOVE ENTRY                   @07 00013500
         CLC   INRECNEW(ACCAUTH-INREC),INRECOLD  NEXT REC. > PREV?      00013600
         BNH   OUTOFORD                          NO, NOT SORTED         00013700
         CLC   INRECNEW(GROUPID-INREC),INRECOLD  SAME CLASS/ENTITY?     00013800
         BE    PERMBLD                 YES, BUILD PERMIT RECORD         00013900
         CLC   =CL8' ',GROUPID         IS THIS A UNIVERSAL RECORD?      00014000
         BNE   NOUAR                   NO, A PERMIT WITHOUT UAR - ABEND 00014100
         GETMAIN RU,LV=RPEL,SP=241                                      00014200
         LR    R10,R1                  ESTABLISH ADDRESSABILITY         00014300
         USING RPECBLK,R10               TO RPE                         00014400
         XC    RPECBLK(RPEL),RPECBLK   INITIALIZE TO BINARY ZEROES      00014500
         MVC   RPENEXT,LASTRPE         POINT TO PREVIOUS RPE            00014600
         ST    R10,LASTRPE             SAVE -> THIS RPE                 00014700
         LA    R11,RPEACCPT            SET PERMIT ANCHOR                00014800
         LA    R1,L'RPECLASN           DEFAULT LENGTH IF NOTFOUND       00014901
         TRT   CLASS,TRTTEST           SEARCH CLASS - BLANKS FOUND?     00015000
         BZ    NOBLANKS                NO, LENGTH ALREADY IN R1         00015100
         S     R1,=A(CLASS)            CALCULATE LENGTH OF DATA         00015201
NOBLANKS DS    0H                                                       00015300
         LR    R2,R1                   Save register 1             @rp2 00015406
         L     R14,CVTPTR              Point to CVT                @rp2 00015509
         ICM   R14,15,CVTRAC-CVTMAP(R14) Load RCVT                 @rp2 00015615
         ICM   R15,15,RCVTREXP-RCVT(R14) Entry point RACSTAT       @rp2 00015715
         BZ    CLSNFND                 No EP, Class not found      @rp2 00015806
         XC    PARMSTAT+4(4),PARMSTAT+4 Second word parmstat = 0   @rp2 00015906
         LA    R1,CLASS                Class name                  @rp2 00016006
         ST    R1,PARMSTAT             And save in first word      @rp2 00016106
         LA    R1,PARMSTAT             Parameter for RACSTAT       @rp2 00016206
         BALR  R14,R15                 Try to find class           @rp2 00016305
         LTR   R15,R15                 Class found?                @rp2 00016406
         BZ    CLSFND                  Yes: process                @rp2 00016506
CLSNFND  DS    0H                                                  @rp2 00016606
         MVC   PARMSTAT+4(4),=F'8'     Set default ent length      @rp2 00016709
CLSFND   DS    0H                                                  @rp2 00016806
         LR    R1,R2                   Restore register 1          @rp2 00016906
*----------------------------------------------------------------- @rp2 00017006
*        RACSTAT returns an adress of 2 words (PARMSTAT) in R1     @rp2 00017106
*        Word 1 = address of found class, word 2 is the max        @rp2 00017207
*        ENTITY length of that particular class.                   @rp2 00017307
*----------------------------------------------------------------- @rp2 00017406
         STC   R1,RPECLASL             SAVE LENGTH                      00017509
         L     R4,PARMSTAT+4           Take found length           @rp2 00017612
         MVC   RPECLASN,CLASS            AND CLASS NAME                 00017700
         XR    R2,R2                   Clear R2 for not in TRTable @rp2 00017803
         EX    R4,TRT                  EXECUTE THE TRT                  00017900
         B     CONT                                                     00018000
TRT      TRT   ENTITY(*-*),TRTTEST     SEARCH ENTITY FOR BLANK/*        00018100
CONT     DS    0H                                                       00018200
         B     BRANCTBL(R2)            AND WE FOUND...                  00018300
BRANCTBL DS    0H                                                       00018400
         B     NOTFND                  ... NO BLANKS/NO ASTERISKS       00018500
         B     ASTRKFND                ... AN ASTERISK                  00018600
         B     BLANKFND                ... A BLANK                      00018700
ASTRKFND DS    0H                                                       00018800
*        LA    R1,1(R1)                ADD 1 TO INCLUDE BLANK IN LENGTH 00018900
BLANKFND S     R1,=A(ENTITY)           CALCULATE LENGTH                 00019000
NOTFND   DS    0H                      IF NOTFOUND LENGTH ALREADY IN R1 00019100
         C     R1,PARMSTAT+4           Entity length > max CDT len?@rp2 00019208
         BNH   *+8                     No: good                    @rp2 00019308
         L     R1,PARMSTAT+4      Take max entity length from CDT  @rp2 00019410
*----------------------------------------------------------------- @rp2 00019506
*        The entity length cannot exceed the maximum entity        @rp2 00019610
*        length specified in the Class Descriptor Table            @rp2 00019710
*----------------------------------------------------------------- @rp2 00019810
         STC   R1,RPEENTYL             SAVE LENGTH                      00019900
         MVC   RPEENTYN,ENTITY           AND ENTITY NAME                00020000
*                                                                       00020100
         CLC   =CL8' ',ACCAUTH         IS THERE AN ACCESS AUTHORITY?    00020200
         BE    NOACCAUT                NO, BLANK ACCESS AUTH. - ABEND   00020300
*                                                                       00020400
         LA    R1,PATTERN              BEGINNING OF TABLE               00020500
         LA    R2,ROWLEN               LENGTH OF A ROW IN THE TABLE     00020600
         LA    R3,PATTERN+PATTERNL-1   LAST BYTE OF TABLE               00020700
AUTHLP1  DS    0H                                                       00020800
         CLC   ACCAUTH,0(R1)           MATCH ON ACCESS AUTHORITY?       00020900
         BE    MATCH1                  YES, MOVE IT IN                  00021000
         BXLE  R1,R2,AUTHLP1           CHECK NEXT                       00021100
MATCH1   MVC   RPEUACC,8(R1)           MOVE IN BIT PATTERN              00021200
         B     READLOOP                SEE IF ANY MORE I/P RECORDS      00021300
PERMBLD  DS    0H                                                       00021400
         CLC   =CL8' ',GROUPID         IS THERE A GROUP/USERID?         00021500
         BE    PERMINVL                NO, INVALID PERMIT RECORD- ABEND 00021600
*                                                                       00021700
         CLC   =CL8' ',ACCAUTH         IS THERE AN ACCESS AUTHORITY?    00021800
         BE    NOACCAUT                NO, BLANK ACCESS AUTH. - ABEND   00021900
*                                                                       00022000
         GETMAIN RU,LV=RPEACCLN,SP=241                                  00022100
         LR    R9,R1                   ESTABLISH ADDRESSABILITY         00022200
         USING RPEACCLE,R9               TO ACCESS RECORD               00022300
         XC    RPEACCLE(RPEACCLN),RPEACCLE INITIALIZE TO B'0'           00022400
         ST    R9,0(R11)               ESTABLISH POINTER TO HERE        00022500
         MVC   RPEAUSR,GROUPID         SAVE GROUP/USERID OF PERMIT      00022600
*                                                                       00022700
         LA    R1,PATTERN              BEGINNING OF TABLE               00022800
         LA    R2,ROWLEN               LENGTH OF A ROW IN THE TABLE     00022900
         LA    R3,PATTERN+PATTERNL-1   LAST BYTE OF TABLE               00023000
AUTHLP2  DS    0H                                                       00023100
         CLC   ACCAUTH,0(R1)           MATCH ON ACCESS AUTHORITY?       00023200
         BE    MATCH2                  YES, MOVE IT IN                  00023300
         BXLE  R1,R2,AUTHLP2           CHECK NEXT                       00023400
MATCH2   MVC   RPEACS,8(R1)            MOVE IN BIT PATTERN              00023500
         LA    R11,RPEANEXT            PROVIDE ANCHOR FOR NEXT PERMIT   00023600
         B     READLOOP                SEE IF ANY MORE I/P RECORDS      00023700
*                                                                       00023800
EOFILE   DS    0H                                                       00023900
         OC    LASTRPE,LASTRPE         WERE THERE ANY RECORDS I/P?      00024000
         BZ    NOREC                   NO, ABEND                        00024100
         L     R11,CJYPROFS            SAVE ADDRESS OF OLD CHAIN        00024200
         MVC   CJYPROFS,LASTRPE        ACTIVATE NEW CHAIN               00024300
         DROP  R8                                                       00024400
         BASMAC R14,MORERPE            START TO FREE RPE'S              00024500
*                                                                       00024600
         DEQ   (SECURITY,PROFS,,SYSTEM)    RELEASE ENQ                  00024700
         L     R2,ADRTBL               ADDRESS OF TEMP. CORE TABLE  @07 00024800
         FREEMAIN RU,LV=160000,A=(2)   RELEASE WHILE STILL KEY=0    @07 00024900
         MODESET MODE=PROB,KEY=NZERO   return to problem state          00025000
         CLOSE (CJYPDATA)              CLOSE I/P DATASET                00025100
         WTO   'RAKFPROF7  RAKF PROFILES UPDATED'                       00025200
         L     R13,4(R13)              RESTORE HSA                      00025300
         RETURN (14,12),,RC=0          END O.K.                         00025400
FREERPE  DS    0H                                                       00025500
         L     R8,RPEACCPT             GET ACCESS LIST POINTER          00025600
         B     MOREACC                 SEE IF ANY PERMITS               00025700
FREEACC  DS    0H                                                       00025800
         L     R8,RPEANEXT             GET -> NEXT ACC                  00025900
         FREEMAIN RU,LV=RPEACCLN,A=(R9),SP=241    FREE CURRENT RPE      00026000
MOREACC  DS    0H                                                       00026100
         LTR   R9,R8                   ANY MORE PERMITS?                00026200
         BNZ   FREEACC                 YES, DELETE THEM                 00026300
*                                                                       00026400
         L     R11,RPENEXT             GET -> NEXT RPE                  00026500
         FREEMAIN RU,LV=RPEL,A=(R10),SP=241   FREE CURRENT RPE          00026600
MORERPE  DS    0H                                                       00026700
         LTR   R10,R11                 ANYMORE RPE'S?                   00026800
         BNZ   FREERPE                 YES, FREE THEM                   00026900
         BR    R14                     RETURN TO END RUN                00027000
*                                                                       00027100
NOGOOD   DS    0H                                                       00027200
         WTO   'RAKFPROF1  RCVT NOT PROPERLY INITIALIZED'               00027300
         WTO   'RAKFPROF1  **  PROGRAM TERMINATED  **'                  00027400
         ABEND 100,,STEP                                                00027500
*                                                                       00027600
NOREC    DS    0H                                                       00027700
         WTO   'RAKFPROF2  NO RECORDS INPUT FROM CJYPDATA'              00027800
         WTO   'RAKFPROF2  **  PROGRAM TERMINATED  **'                  00027900
         ABEND 200,,STEP                                                00028000
*                                                                       00028100
OUTOFORD DS    0H                                                       00028200
         L     R11,LASTRPE             SETUP FOR RPE CLEANUP            00028300
         BASMAC R14,MORERPE            GO CLEANUP AND RETURN HERE       00028400
         BASMAC R14,BADMSG             WRITE BADMSG                     00028500
         WTO   'RAKFPROF3  I/P RECORDS OUT OF ORDER'                    00028600
         WTO   'RAKFPROF3  **  PROGRAM TERMINATED  **'                  00028700
         ABEND 300,,STEP                                                00028800
*                                                                       00028900
NOUAR    DS    0H                                                       00029000
         L     R11,LASTRPE             SETUP FOR RPE CLEANUP            00029100
         BASMAC R14,MORERPE            GO CLEANUP AND RETURN HERE       00029200
         BASMAC R14,BADMSG             WRITE BADMSG                     00029300
         WTO   'RAKFPROF4  PERMIT RECORD WITHOUT UNIVERSAL ACCESS RECOR*00029400
               D'                                                       00029500
         WTO   'RAKFPROF4  **  PROGRAM TERMINATED  **'                  00029600
         ABEND 400,,STEP                                                00029700
*                                                                       00029800
PERMINVL DS    0H                                                       00029900
         L     R11,LASTRPE             SETUP FOR RPE CLEANUP            00030000
         BASMAC R14,MORERPE            GO CLEANUP AND RETURN HERE       00030100
         BASMAC R14,BADMSG             WRITE BADMSG                     00030200
         WTO   'RAKFPROF5  PERMIT RECORD WITHOUT GROUPID/USERID'        00030300
         WTO   'RAKFPROF5  **  PROGRAM TERMINATED  **'                  00030400
         ABEND 500,,STEP                                                00030500
*                                                                       00030600
NOACCAUT DS    0H                                                       00030700
         L     R11,LASTRPE             SETUP FOR RPE CLEANUP            00030800
         BASMAC R14,MORERPE            GO CLEANUP AND RETURN HERE       00030900
         BASMAC R14,BADMSG             WRITE BADMSG                     00031000
         WTO   'RAKFPROF6  ENTITY RECORD WITH NO ACCESS AUTHORITY'      00031100
         WTO   'RAKFPROF6  **  PROGRAM TERMINATED  **'                  00031200
         ABEND 500,,STEP                                                00031300
*                                                                   @03 00031400
ABEND600 WTO    'RAKF008W illegal operation -- access denied'       @03 00031500
         WTO    'RAKF008W   ** program terminated **'               @03 00031600
         ABEND  600,,STEP                                           @03 00031700
*                                                                       00031800
BADMSG   DS    0H                                                       00031900
         MVC   BADMSGN+18(80),INRECNEW                                  00032000
BADMSGN  WTO   'RAKFPROF8                                              X00032100
                                                  '                     00032200
         BR    R14                                                      00032300
**********************                                                  00032400
         PRINT NOGEN                                                    00032500
SAVEAREA DS    18F                                                      00032600
PARMSTAT DS    D                       Parameter RACSTAT                00032705
LASTRPE  DC    F'0'                                                     00032800
LASTACC  DC    F'0'                                                     00032900
SECURITY DC    CL8'CJYRCVT'                                             00033000
PROFS    DC    CL8'CJYPROFS'                                            00033100
INREC    DS    0CL80                                                    00033200
INRECNEW DS    0CL80                                                    00033300
CLASS    DC    XL8'00'                                                  00033400
ENTITY   DC    XL44'00'                                                 00033500
GROUPID  DC    XL8'00'                                                  00033600
ACCAUTH  DC    XL8'00'                                                  00033700
         DC    XL(80-(*-INREC))'00'                                     00033800
INRECOLD DC    XL80'00'                                                 00033900
PATTERN  EQU   *                                                        00034000
         DC    CL8'ALTER   ',AL1(RACFALTR)                              00034100
ROWLEN   EQU   *-PATTERN                                                00034200
         DC    CL8'CONTROL ',AL1(RACFCNTL)                              00034300
         DC    CL8'UPDATE  ',AL1(RACFUPDT)                              00034400
         DC    CL8'READ    ',AL1(RACFREAD)                              00034500
         DC    CL8'EXEC    ',AL1(RACFEXEC)                              00034600
         DC    CL8'NONE    ',AL1(RACFNONE)                              00034700
PATTERNL EQU   *-PATTERN                                                00034800
TRTTEST  DC    XL256'00'               TABLE TO FIND BLANK/ASTERISK     00034900
         ORG   TRTTEST+C' '            SETUP FLAG FOR BLANK             00035000
         DC    X'08'                                                    00035100
         ORG   TRTTEST+C'*'            SETUP FLAG FOR ASTERISK          00035200
         DC    X'04'                                                    00035300
         ORG                                                            00035400
CJYPDATA DCB   MACRF=GM,EODAD=ENDLOOP,DDNAME=RAKFPROF,DSORG=PS      @07 00035500
*                                                                   @03 00035600
RAKFADM  DC     CL39'RAKFADM'      facility name to authorize       @03 00035700
*                                                                   @03 00035800
SAVESORT DS    5F                      SAVE REGISTERS SORT          @07 00035900
SWAPLAST DS    F                       LAST RECORD SWAPPED          @07 00036000
ADRTBL   DS    F                       ADDRESS OF TEMP TABLE        @07 00036100
RECORD   DS    CL80                                                 @07 00036200
*                                                                   @07 00036300
         COPY  CJYRCVTD                                                 00036400
         COPY  CJYPCBLK                                                 00036500
         IHAPSA DSECT=YES                                               00036600
         CVT    DSECT=YES                                               00036700
         ICHPRCVT                                                       00036800
R0       EQU   00                                                       00036900
R1       EQU   01                                                       00037000
R2       EQU   02                                                       00037100
R3       EQU   03                                                       00037200
R4       EQU   04                                                       00037300
R5       EQU   05                                                       00037400
R6       EQU   06                                                       00037500
R7       EQU   07                                                       00037600
R8       EQU   08                                                       00037700
R9       EQU   09                                                       00037800
R10      EQU   10                                                       00037900
R11      EQU   11                                                       00038000
R12      EQU   12                                                       00038100
R13      EQU   13                                                       00038200
R14      EQU   14                                                       00038300
R15      EQU   15                                                       00038400
         END   CJYRPROF                                                 00038500
