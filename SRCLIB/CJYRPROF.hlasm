         TITLE 'ESG-SECURITY DATA PROFILE PROCESSOR'                    00000100
* CPARM='XREF(SHORT),OBJ,NODECK',LPARM='AC=1'                 CJYRPROF  00000200
*      DD DSN=SYS1.MACLIB,DISP=SHR                                      00000300
*      DD DSN=SYS1.MODGEN,DISP=SHR                                      00000400
*      DD DSN=RAKF.MACLIB,DISP=SHR                                      00000500
         EJECT                                                          00000600
         MACRO                                                          00000700
&LABEL   BASMAC &R1,&S2                                                 00000800
&LABEL.  DC    0XL4'00',X'4D',AL.4(&R1.,0),S(&S2.)                      00000900
         MEND                                                           00001000
CJYRPROF CSECT                                                          00001100
*                                                                       00001200
**********************************************************************  00001300
