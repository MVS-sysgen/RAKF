         CVT   DSECT=YES,LIST=NO                                        00064300
         IKJCPPL                                                        00064400
         IKJUPT                                                         00064500
         IKJPPL                        Parse parameter list             00064600
PPL#L    EQU   *-PPL                                                    00064700
         IKJDAPL                                                        00064800
         IKJDAP08                      IKJDAIR allocation parm block    00064900
         IKJDAP18                      IKJDAIR unallocation parm block  00065000
         IHAPSA                                                         00065100
         IHAASCB                                                        00065200
         IHAASXB                                                        00065300
         IHAACEE                                                        00065400
